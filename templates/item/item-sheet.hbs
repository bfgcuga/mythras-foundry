<div class="item-sheet-content">
  <header class="sheet-header">
    <img src="{{item.img}}" alt="{{item.name}}" data-edit="img">
    <input type="text" name="name" value="{{item.name}}" {{#if isPassion}}readonly{{/if}}>
  </header>

  {{#if isSkillLike}}
    {{#if isSkill}}
    <label>{{localize "MYTHRASF.Item.Category"}}</label>
    <select name="system.category">
      <option value="basic" {{#if item.system.isBasic}}selected{{/if}}>
        {{localize "MYTHRASF.Skill.Basic"}}
      </option>
      <option value="professional" {{#if item.system.isProfessional}}selected{{/if}}>
        {{localize "MYTHRASF.Skill.Professional"}}
      </option>
    </select>
    {{/if}}

    <label>{{localize "MYTHRASF.Skill.Group"}}</label>
    <select name="system.group">
      {{selectOptions groupChoices selected=item.system.group
        labelAttr="label" valueAttr="value"}}
    </select>

    <label>{{localize "MYTHRASF.Item.Characteristic1"}}</label>
    <select name="system.characteristic1">
      {{selectOptions characteristicChoices selected=item.system.characteristic1
        labelAttr="label" valueAttr="value"}}
    </select>
    <label>{{localize "MYTHRASF.Item.Characteristic2"}}</label>
    <select name="system.characteristic2">
      {{selectOptions characteristicChoices selected=item.system.characteristic2
        labelAttr="label" valueAttr="value"}}
    </select>
    {{#if isCombatStyle}}
      <label>{{localize "MYTHRASF.CombatStyle.Weapons"}}</label>
      <input type="text" name="system.weapons" value="{{item.system.weapons}}">
      <label>{{localize "MYTHRASF.CombatStyle.Traits"}}</label>
      <input type="text" name="system.traits" value="{{item.system.traits}}">
    {{/if}}
  {{else}}
  {{#if isBackground}}
    <label>{{localize "MYTHRASF.Background.Key"}}</label>
    <input type="text" name="system.key" value="{{item.system.key}}">
    <label>{{localize "MYTHRASF.Background.Rules"}}</label>
    <textarea name="system.rules">{{item.system.rules}}</textarea>
  {{else}}
  {{#if isPassion}}
    {{#if item.system.isLegacy}}
      <p class="passion-legacy-note">{{localize "MYTHRASF.Passion.LegacyHelp"}}</p>
      <label>{{localize "MYTHRASF.Passion.Value"}}</label>
      <input type="number" min="0" name="system.value" value="{{item.system.value}}">
    {{/if}}
    <label class="checkbox">
      <input type="checkbox" name="system.structured" {{checked item.system.structured}}>
      {{localize "MYTHRASF.Passion.Structured"}}
    </label>
      <label>{{localize "MYTHRASF.Passion.VerbLabel"}}</label>
      <select name="system.verb">
        {{selectOptions passionVerbChoices selected=item.system.verb labelAttr="label" valueAttr="value"}}
      </select>
      {{#if isCustomPassionVerb}}
        <label>{{localize "MYTHRASF.Passion.CustomVerb"}}</label>
        <input type="text" name="system.customVerb" value="{{item.system.customVerb}}">
      {{/if}}
      <label>{{localize "MYTHRASF.Passion.ObjectType"}}</label>
      <select name="system.objectType">
        {{selectOptions passionObjectChoices selected=item.system.objectType labelAttr="label" valueAttr="value"}}
      </select>
      <label>{{localize "MYTHRASF.Passion.ObjectDescription"}}</label>
      <input type="text" name="system.objectDescription" value="{{item.system.objectDescription}}">
      <div class="passion-value-summary">
        <span>{{localize "MYTHRASF.Skill.Base"}}: <b>{{item.system.base}}</b></span>
        <span>{{localize "MYTHRASF.Skill.BonusSum"}}: <b>{{item.system.allocatedBonus}}</b></span>
        <span>{{localize "MYTHRASF.Skill.Total"}}: <b>{{item.system.total}}%</b></span>
      </div>
      <label>{{localize "MYTHRASF.Passion.CreationBonus"}}</label>
      <input type="number" name="system.creationBonus" value="{{item.system.creationBonus}}">
      <label>{{localize "MYTHRASF.Passion.ExperiencePoints"}}</label>
      <input type="number" name="system.experiencePoints" value="{{item.system.experiencePoints}}">
      <label>{{localize "MYTHRASF.Passion.ManualAdjustment"}}</label>
      <input type="number" name="system.manualAdjustment" value="{{item.system.manualAdjustment}}">
  {{else}}
    <label>{{localize "MYTHRASF.Item.Quantity"}}</label>
    <input type="number" min="0" name="system.quantity" value="{{item.system.quantity}}">
    <label>{{localize "MYTHRASF.Item.Weight"}}</label>
    <input type="number" min="0" step="any" name="system.weight" value="{{item.system.weight}}">
    <label>{{localize "MYTHRASF.Item.Value"}}</label>
    <input type="number" min="0" step="any" name="system.value" value="{{item.system.value}}">
    <label>{{localize "MYTHRASF.Item.Location"}}</label>
    <input type="text" name="system.location" value="{{item.system.location}}">
    <label class="checkbox">
      <input type="checkbox" name="system.equipped" {{checked item.system.equipped}}>
      {{localize "MYTHRASF.Item.Equipped"}}
    </label>
  {{/if}}
  {{/if}}
  {{/if}}

  {{#if isWeapon}}
    <label>{{localize "MYTHRASF.Weapon.Damage"}}</label>
    <input type="text" name="system.damage" value="{{item.system.damage}}">
    <label>{{localize "MYTHRASF.Weapon.Size"}}</label>
    <input type="text" name="system.size" value="{{item.system.size}}">
    <label>{{localize "MYTHRASF.Weapon.Reach"}}</label>
    <input type="text" name="system.reach" value="{{item.system.reach}}">
    <label>{{localize "MYTHRASF.Weapon.HitPoints"}}</label>
    <input type="number" min="0" name="system.hitPoints" value="{{item.system.hitPoints}}">
    <label>{{localize "MYTHRASF.Weapon.Grip"}}</label>
    <input type="text" name="system.grip" value="{{item.system.grip}}">
  {{/if}}

  <label>{{localize "MYTHRASF.Item.Description"}}</label>
  <textarea name="system.description">{{item.system.description}}</textarea>
</div>
