<div class="item-sheet-content">
  <header class="sheet-header">
    <img src="{{item.img}}" alt="{{item.name}}" data-edit="img">
    <input type="text" name="name" value="{{item.name}}" {{#if isPassion}}readonly{{/if}}>
  </header>

  {{#if isSkillLike}}
    {{#if isSkill}}
      <label>{{localize "MYTHRASF.Item.Category"}}</label>
      <select name="system.category">
        <option value="basic" {{#if item.system.isBasic}}selected{{/if}}>{{localize "MYTHRASF.Skill.Basic"}}</option>
        <option value="professional" {{#if item.system.isProfessional}}selected{{/if}}>{{localize "MYTHRASF.Skill.Professional"}}</option>
      </select>
    {{/if}}
    <label>{{localize "MYTHRASF.Skill.Group"}}</label>
    <select name="system.group">{{selectOptions groupChoices selected=item.system.group labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.Item.Characteristic1"}}</label>
    <select name="system.characteristic1">{{selectOptions characteristicChoices selected=item.system.characteristic1 labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.Item.Characteristic2"}}</label>
    <select name="system.characteristic2">{{selectOptions characteristicChoices selected=item.system.characteristic2 labelAttr="label" valueAttr="value"}}</select>
    {{#if isCombatStyle}}
      <label>{{localize "MYTHRASF.CombatStyle.Weapons"}}</label>
      <input type="text" name="system.weapons" value="{{combatStyleWeaponNames}}">
      <label>{{localize "MYTHRASF.CombatStyle.Traits"}}</label>
      <input type="text" name="system.traits" value="{{item.system.traits}}">
    {{/if}}
  {{/if}}

  {{#if isBackground}}
    <label>{{localize "MYTHRASF.Background.Key"}}</label><input type="text" name="system.key" value="{{item.system.key}}">
    <label>{{localize "MYTHRASF.Background.Rules"}}</label><textarea name="system.rules">{{item.system.rules}}</textarea>
  {{/if}}

  {{#if isPassion}}
    {{#if item.system.isLegacy}}
      <p class="passion-legacy-note">{{localize "MYTHRASF.Passion.LegacyHelp"}}</p>
      <label>{{localize "MYTHRASF.Passion.Value"}}</label><input type="number" min="0" name="system.value" value="{{item.system.value}}">
    {{/if}}
    <label class="checkbox"><input type="checkbox" name="system.structured" {{checked item.system.structured}}>{{localize "MYTHRASF.Passion.Structured"}}</label>
    <label>{{localize "MYTHRASF.Passion.VerbLabel"}}</label><select name="system.verb">{{selectOptions passionVerbChoices selected=item.system.verb labelAttr="label" valueAttr="value"}}</select>
    {{#if isCustomPassionVerb}}<label>{{localize "MYTHRASF.Passion.CustomVerb"}}</label><input type="text" name="system.customVerb" value="{{item.system.customVerb}}">{{/if}}
    <label>{{localize "MYTHRASF.Passion.ObjectType"}}</label><select name="system.objectType">{{selectOptions passionObjectChoices selected=item.system.objectType labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.Passion.ObjectDescription"}}</label><input type="text" name="system.objectDescription" value="{{item.system.objectDescription}}">
    <label>{{localize "MYTHRASF.Passion.CreationBonus"}}</label><input type="number" name="system.creationBonus" value="{{item.system.creationBonus}}">
    <label>{{localize "MYTHRASF.Passion.ExperiencePoints"}}</label><input type="number" name="system.experiencePoints" value="{{item.system.experiencePoints}}">
    <label>{{localize "MYTHRASF.Passion.ManualAdjustment"}}</label><input type="number" name="system.manualAdjustment" value="{{item.system.manualAdjustment}}">
  {{/if}}

  {{#if isEquipment}}
    <label>{{localize "MYTHRASF.Item.Quantity"}}</label><input type="number" min="0" name="system.quantity" value="{{item.system.quantity}}">
    <label>{{localize "MYTHRASF.Item.Weight"}}</label><input type="number" min="0" step="any" name="system.weight" value="{{item.system.weight}}">
    <label>{{localize "MYTHRASF.Item.Value"}}</label><input type="number" min="0" step="any" name="system.value" value="{{item.system.value}}">
    <label>{{localize "MYTHRASF.Item.Location"}}</label><input type="text" name="system.location" value="{{item.system.location}}">
    <label class="checkbox"><input type="checkbox" name="system.equipped" {{checked item.system.equipped}}>{{localize "MYTHRASF.Item.Equipped"}}</label>
  {{/if}}

  {{#if isWeapon}}
    <label>{{localize "MYTHRASF.Weapon.ProfileKey"}}</label><input type="text" name="system.profileKey" value="{{item.system.profileKey}}">
    <label>{{localize "MYTHRASF.Weapon.TypeLabel"}}</label><select name="system.weaponType">{{selectOptions weaponTypeChoices selected=item.system.weaponType labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.Weapon.Damage"}}</label><input type="text" name="system.damage" value="{{item.system.damage}}">
    <label>{{localize "MYTHRASF.Weapon.DamageModifier.Label"}}</label><select name="system.damageModifierMode">{{selectOptions damageModifierChoices selected=item.system.damageModifierMode labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.Weapon.Size"}}</label><input type="text" name="system.size" value="{{item.system.size}}">
    <label>{{localize "MYTHRASF.Weapon.Reach"}}</label><input type="text" name="system.reach" value="{{item.system.reach}}">
    <label>{{localize "MYTHRASF.Weapon.Effects"}}</label><input type="text" name="system.effects" value="{{item.system.effects}}">
    <label>{{localize "MYTHRASF.Weapon.ArmorPoints"}}</label><input type="number" min="0" name="system.armorPoints" value="{{item.system.armorPoints}}">
    <label>{{localize "MYTHRASF.Weapon.HitPoints"}}</label><div><input type="number" min="0" name="system.currentHitPoints" value="{{item.system.currentHitPoints}}"> / <input type="number" min="0" name="system.maxHitPoints" value="{{item.system.maxHitPoints}}"></div>
    <label>{{localize "MYTHRASF.Weapon.Encumbrance"}}</label><input type="number" min="0" step="any" name="system.encumbrance" value="{{item.system.encumbrance}}">
    <label>{{localize "MYTHRASF.Weapon.Grip"}}</label><input type="text" name="system.grip" value="{{item.system.grip}}">
    <label>{{localize "MYTHRASF.Weapon.HandsRequired"}}</label><input type="number" min="0" max="2" name="system.handsRequired" value="{{item.system.handsRequired}}">
    <label>{{localize "MYTHRASF.Weapon.Range"}}</label><input type="text" name="system.range" value="{{item.system.range}}">
    <label>{{localize "MYTHRASF.Weapon.Reload"}}</label><input type="text" name="system.reload" value="{{item.system.reload}}">
  {{/if}}

  {{#if isArmor}}
    <label>{{localize "MYTHRASF.Armor.Points"}}</label><input type="number" min="0" name="system.armorPoints" value="{{item.system.armorPoints}}">
    <label>{{localize "MYTHRASF.Armor.Penalty"}}</label><input type="number" min="0" name="system.penalty" value="{{item.system.penalty}}">
    <label>{{localize "MYTHRASF.Armor.Era.Label"}}</label><select name="system.era">{{selectOptions armorEraChoices selected=item.system.era labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.Armor.Coverage"}}</label><input type="text" name="system.coverage" value="{{item.system.coverage}}">
  {{/if}}

  {{#if isHitLocation}}
    <label>{{localize "MYTHRASF.HitLocation.Range"}}</label><div><input type="number" min="1" max="20" name="system.rangeStart" value="{{item.system.rangeStart}}"> – <input type="number" min="1" max="20" name="system.rangeEnd" value="{{item.system.rangeEnd}}"></div>
    <label>{{localize "MYTHRASF.HitLocation.Category.Label"}}</label><select name="system.category">{{selectOptions locationCategoryChoices selected=item.system.category labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.HitLocation.HpClass.Label"}}</label><select name="system.hpClass">{{selectOptions locationHpClassChoices selected=item.system.hpClass labelAttr="label" valueAttr="value"}}</select>
    <label class="checkbox"><input type="checkbox" name="system.autoCalculate" {{checked item.system.autoCalculate}}>{{localize "MYTHRASF.HitLocation.AutoCalculate"}}</label>
    <label>{{localize "MYTHRASF.HitLocation.MaxHitPoints"}}</label><input type="number" min="1" name="system.maxHitPoints" value="{{item.system.maxHitPoints}}">
    <label>{{localize "MYTHRASF.HitLocation.CurrentHitPoints"}}</label><input type="number" name="system.currentHitPoints" value="{{item.system.currentHitPoints}}">
    <label>{{localize "MYTHRASF.HitLocation.Armor"}}</label><input type="number" min="0" name="system.armorPoints" value="{{item.system.armorPoints}}">
  {{/if}}

  <label>{{localize "MYTHRASF.Item.Description"}}</label>
  <textarea name="system.description">{{item.system.description}}</textarea>
</div>
