<div class="item-sheet-content {{#if isWeapon}}weapon-item-sheet{{/if}}">
  <header class="sheet-header {{#if isWeapon}}weapon-sheet-header{{/if}}">
    <span class="item-image-frame"><img src="{{item.img}}" alt="{{item.name}}" data-edit="img">
      {{#if isWeapon}}<button type="button" class="sheet-icon-button item-image-view" data-action="view-item-image" aria-label="{{localize "MYTHRASF.Item.ViewImage"}}" title="{{localize "MYTHRASF.Item.ViewImage"}}"><i class="fas fa-expand" aria-hidden="true"></i></button>{{/if}}
    </span>
    <input type="text" name="name" value="{{item.name}}" {{#if isPassion}}readonly{{/if}}>
  </header>

  {{#if isSkillLike}}
    {{#if isSkill}}
      <label>{{localize "MYTHRASF.Item.Category"}}</label>
      <select name="system.category">
        <option value="basic" {{#if item.system.isBasic}}selected{{/if}}>{{localize "MYTHRASF.Skill.Basic"}}</option>
        <option value="professional" {{#if item.system.isProfessional}}selected{{/if}}>{{localize "MYTHRASF.Skill.Professional"}}</option>
      </select>
      <label>{{localize "MYTHRASF.Skill.Group"}}</label>
      <select name="system.group">{{selectOptions groupChoices selected=item.system.group labelAttr="label" valueAttr="value"}}</select>
      <label>{{localize "MYTHRASF.Skill.Source"}}</label>
      <input type="text" class="sheet-field-editable" name="system.source" value="{{item.system.source}}">
      <label>{{localize "MYTHRASF.Item.Characteristic1"}}</label>
      <select name="system.characteristic1">{{selectOptions characteristicChoices selected=item.system.characteristic1 labelAttr="label" valueAttr="value"}}</select>
      <label>{{localize "MYTHRASF.Item.Characteristic2"}}</label>
      <select name="system.characteristic2">{{selectOptions characteristicChoices selected=item.system.characteristic2 labelAttr="label" valueAttr="value"}}</select>
    {{/if}}
    {{#if isCombatStyle}}
      <nav class="combat-style-sheet-tabs" aria-label="{{localize "MYTHRASF.CombatStyle.Tabs.Label"}}">
        <button type="button" class="active" data-combat-style-tab="description" title="{{localize "MYTHRASF.CombatStyle.Tabs.Description"}}">{{localize "MYTHRASF.CombatStyle.Tabs.Description"}}</button>
        <button type="button" data-combat-style-tab="weapons" title="{{localize "MYTHRASF.CombatStyle.Tabs.Weapons"}}">{{localize "MYTHRASF.CombatStyle.Tabs.Weapons"}}</button>
        <button type="button" data-combat-style-tab="traits" title="{{localize "MYTHRASF.CombatStyle.Tabs.Traits"}}">{{localize "MYTHRASF.CombatStyle.Tabs.Traits"}}</button>
        <button type="button" data-combat-style-tab="configuration" title="{{localize "MYTHRASF.CombatStyle.Tabs.Configuration"}}">{{localize "MYTHRASF.CombatStyle.Tabs.Configuration"}}</button>
      </nav>

      <section class="combat-style-tab-panel active" data-combat-style-tab-content="description">
        <fieldset class="combat-style-description-editor"><legend>{{localize "MYTHRASF.CombatStyle.Description"}}</legend>
          <label>{{localize "MYTHRASF.Item.Description"}}</label>
          <textarea name="system.description">{{item.system.description}}</textarea>
          {{#if item.system.traits}}<label>{{localize "MYTHRASF.Trait.LegacyText"}}</label>
          <textarea name="system.traits">{{item.system.traits}}</textarea>{{/if}}
        </fieldset>
      </section>

      <section class="combat-style-tab-panel" data-combat-style-tab-content="weapons">
        <fieldset class="combat-style-weapons-editor">
        <legend>{{localize "MYTHRASF.CombatStyle.Weapons"}}</legend>
        <div class="combat-style-weapon-drop" data-combat-style-weapon-drop><i class="fas fa-hand-pointer" aria-hidden="true"></i>
          <span>{{localize "MYTHRASF.CombatStyle.DropWeaponsHere"}}</span></div>
        <ol class="combat-style-profile-list">
          {{#each combatStyleWeaponProfiles as |profile|}}<li>
            <span class="sheet-field-readonly">{{profile.name}}</span>
            <code>{{profile.key}}</code>
            {{#if ../editable}}<button type="button" class="sheet-icon-button" data-action="delete-combat-style-profile"
              data-profile-key="{{profile.key}}" aria-label="{{localize "MYTHRASF.Delete"}}" title="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{/if}}
          </li>{{else}}<li class="empty">{{localize "MYTHRASF.CombatStyle.NoWeaponProfiles"}}</li>{{/each}}
        </ol>
        {{#if editable}}<button type="button" class="combat-style-select-button" data-action="select-combat-style-weapon" title="{{localize "MYTHRASF.CombatStyle.SelectWeapon"}}"><i class="fas fa-list" aria-hidden="true"></i> {{localize "MYTHRASF.CombatStyle.SelectWeapon"}}</button>{{/if}}
        {{#if editable}}<div class="combat-style-profile-manual">
          <label for="combat-style-profile-input">{{localize "MYTHRASF.CombatStyle.ManualWeaponProfilesLabel"}}</label>
          <textarea class="sheet-field-editable" data-combat-style-profile-input rows="2"
            id="combat-style-profile-input"
            placeholder="{{localize "MYTHRASF.CombatStyle.ManualWeaponProfiles"}}"></textarea>
          <button type="button" class="sheet-add-button" data-action="add-combat-style-profile"
            aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
        </div>{{/if}}
        </fieldset>
      </section>

      <section class="combat-style-tab-panel" data-combat-style-tab-content="traits">
        <fieldset class="combat-style-traits-editor"><legend>{{localize "MYTHRASF.CombatStyle.Traits"}}</legend>
          <div class="combat-style-trait-drop" data-combat-style-trait-drop><i class="fas fa-hand-pointer" aria-hidden="true"></i>
            <span>{{localize "MYTHRASF.CombatStyle.DropTraitsHere"}}</span></div>
          <ol class="combat-style-trait-list">
            {{#each combatStyleTraitReferences as |trait|}}<li class="{{#if trait.broken}}broken{{/if}}">
              <img src="{{trait.img}}" alt="">
              <button type="button" class="combat-style-trait-name" data-action="open-combat-style-trait" data-trait-uuid="{{trait.uuid}}" title="{{trait.name}}">{{trait.name}}</button>
              <span class="combat-style-trait-description">{{{trait.description}}}{{#if trait.requiresAllGroupMembers}} <em>{{localize "MYTHRASF.Trait.RequiresAllGroupMembers.Note"}}</em>{{/if}}{{#if trait.broken}} <em>{{localize "MYTHRASF.CombatStyle.BrokenTraitReference"}}</em>{{/if}}</span>
              <span class="combat-style-trait-source">{{trait.source}}</span>
              {{#if ../editable}}<button type="button" class="sheet-icon-button" data-action="delete-combat-style-trait" data-trait-uuid="{{trait.uuid}}" data-trait-key="{{trait.key}}" aria-label="{{localize "MYTHRASF.Delete"}}" title="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{/if}}
            </li>{{else}}<li class="empty">{{localize "MYTHRASF.CombatStyle.NoTraits"}}</li>{{/each}}
          </ol>
          {{#if editable}}<div class="combat-style-trait-actions">
            <button type="button" data-action="select-combat-style-trait" title="{{localize "MYTHRASF.CombatStyle.SelectTrait"}}"><i class="fas fa-list" aria-hidden="true"></i> {{localize "MYTHRASF.CombatStyle.SelectTrait"}}</button>
            <button type="button" data-action="create-combat-style-trait" title="{{localize "MYTHRASF.CombatStyle.CreateTrait"}}"><i class="fas fa-plus" aria-hidden="true"></i> {{localize "MYTHRASF.CombatStyle.CreateTrait"}}</button>
          </div>{{/if}}
        </fieldset>
      </section>

      <section class="combat-style-tab-panel" data-combat-style-tab-content="configuration">
        <fieldset class="combat-style-configuration"><legend>{{localize "MYTHRASF.CombatStyle.Configuration"}}</legend>
          <label>{{localize "MYTHRASF.Item.Category"}}</label><output class="sheet-field-readonly">{{localize "MYTHRASF.Skill.Professional"}}</output>
          <label>{{localize "MYTHRASF.Skill.Group"}}</label><output class="sheet-field-readonly">{{localize "MYTHRASF.Skill.GroupCombat"}}</output>
          <label>{{localize "MYTHRASF.Item.Characteristic1"}}</label><output class="sheet-field-readonly">{{combatStyleCharacteristic1}}</output>
          <label>{{localize "MYTHRASF.Item.Characteristic2"}}</label><output class="sheet-field-readonly">{{combatStyleCharacteristic2}}</output>
          <label>{{localize "MYTHRASF.Skill.Base"}}</label><output class="sheet-field-readonly">{{item.system.base}}%</output>
          <label>{{localize "MYTHRASF.CombatStyle.SourceType"}}</label><output class="sheet-field-readonly">{{combatStyleSourceType}}</output>
          <label>{{localize "MYTHRASF.Skill.BaseBonus"}}</label><output class="sheet-field-readonly">{{item.system.baseBonus}}</output>
          <label>{{localize "MYTHRASF.Skill.CulturePoints"}}</label><output class="sheet-field-readonly">{{item.system.culturePoints}}</output>
          <label>{{localize "MYTHRASF.Skill.ProfessionPoints"}}</label><output class="sheet-field-readonly">{{item.system.professionPoints}}</output>
          <label>{{localize "MYTHRASF.Skill.FreePoints"}}</label><output class="sheet-field-readonly">{{item.system.freePoints}}</output>
          <label>{{localize "MYTHRASF.Skill.ExperiencePoints"}}</label><output class="sheet-field-readonly">{{item.system.experiencePoints}}</output>
          <label>{{localize "MYTHRASF.Skill.Total"}}</label><output class="sheet-field-readonly">{{item.system.total}}%</output>
        </fieldset>
      </section>
    {{/if}}
    <fieldset class="item-generation-fields">
      <legend>{{localize "MYTHRASF.Npc.ValueConfiguration"}}</legend>
      <label>{{localize "MYTHRASF.Skill.ValueMode.Label"}}</label>
      <select name="system.valueMode">{{selectOptions skillValueModeChoices selected=item.system.valueMode labelAttr="label" valueAttr="value"}}</select>
      <label>{{localize "MYTHRASF.Skill.ManualValue"}}</label>
      <input type="number" min="0" name="system.manualValue" value="{{item.system.manualValue}}">
      <label>{{localize "MYTHRASF.Npc.GenerationFormula"}}</label>
      <input type="text" name="system.generationFormula" value="{{item.system.generationFormula}}" placeholder="1d10+50">
    </fieldset>
  {{/if}}

  {{#if isBackground}}
    <label>{{localize "MYTHRASF.Background.Key"}}</label><input type="text" name="system.key" value="{{item.system.key}}">
    <label>{{localize "MYTHRASF.Background.Source"}}</label><input type="text" class="sheet-field-editable" name="system.source" value="{{item.system.source}}">
    <label>{{localize "MYTHRASF.Background.Rules"}}</label><textarea name="system.rules">{{item.system.rules}}</textarea>
  {{/if}}

  {{#if isPassion}}
    {{#if item.system.isLegacy}}
      <p class="passion-legacy-note">{{localize "MYTHRASF.Passion.LegacyHelp"}}</p>
      <label>{{localize "MYTHRASF.Passion.Value"}}</label><input type="number" min="0" name="system.value" value="{{item.system.value}}">
    {{/if}}
    <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.structured" {{checked item.system.structured}}>{{localize "MYTHRASF.Passion.Structured"}}</label>
    <label>{{localize "MYTHRASF.Passion.VerbLabel"}}</label><select name="system.verb">{{selectOptions passionVerbChoices selected=item.system.verb labelAttr="label" valueAttr="value"}}</select>
    {{#if isCustomPassionVerb}}<label>{{localize "MYTHRASF.Passion.CustomVerb"}}</label><input type="text" name="system.customVerb" value="{{item.system.customVerb}}">{{/if}}
    <label>{{localize "MYTHRASF.Passion.ObjectType"}}</label><select name="system.objectType">{{selectOptions passionObjectChoices selected=item.system.objectType labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.Passion.ObjectDescription"}}</label><input type="text" name="system.objectDescription" value="{{item.system.objectDescription}}">
    {{#if isPersonPassion}}<label>{{localize "MYTHRASF.Passion.TargetCharisma"}}</label><input type="number" min="1" name="system.targetCharisma" value="{{item.system.targetCharisma}}">{{/if}}
    <label>{{localize "MYTHRASF.Passion.CreationBonus"}}</label><input type="number" name="system.creationBonus" value="{{item.system.creationBonus}}">
    <label>{{localize "MYTHRASF.Passion.ExperiencePoints"}}</label><input type="number" name="system.experiencePoints" value="{{item.system.experiencePoints}}">
    <label>{{localize "MYTHRASF.Passion.ManualAdjustment"}}</label><input type="number" name="system.manualAdjustment" value="{{item.system.manualAdjustment}}">
    <label>{{localize "MYTHRASF.Npc.GenerationFormula"}}</label><input type="text" name="system.generationFormula" value="{{item.system.generationFormula}}">
  {{/if}}

  {{#if isEquipment}}
    {{#unless isWeapon}}
    <label>{{localize "MYTHRASF.Npc.QuantityFormula"}}</label><input type="text" name="system.quantityFormula" value="{{item.system.quantityFormula}}">
    <label>{{localize "MYTHRASF.Item.Container.Parent"}}</label><select class="sheet-field-editable" name="system.parentContainerId"><option value="">{{localize "MYTHRASF.Item.Container.None"}}</option>{{selectOptions equipmentContainerChoices selected=item.system.parentContainerId labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.Currency.Denomination"}}</label><select class="sheet-field-editable" name="system.currency">{{selectOptions currencyChoices selected=item.system.currency labelAttr="label" valueAttr="value"}}</select>
    {{/unless}}
    {{#unless isWeapon}}{{#unless isArmor}}
    <label>{{localize "MYTHRASF.Background.Source"}}</label><input class="sheet-field-editable" name="system.source" value="{{item.system.source}}">
    <label>{{localize "MYTHRASF.ItemClass.Label"}}</label><select class="sheet-field-editable" name="system.category">{{selectOptions equipmentCategoryChoices selected=item.system.category labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.Weapon.Era"}}</label><input class="sheet-field-editable" name="system.era" value="{{item.system.era}}">
    <label>{{localize "MYTHRASF.Item.Quantity"}}</label><input type="number" min="0" name="system.quantity" value="{{item.system.quantity}}">
    <label>{{localize "MYTHRASF.Item.Weight"}}</label><input type="number" min="0" step="any" name="system.weight" value="{{item.system.weight}}">
    <label>{{localize "MYTHRASF.Item.Value"}}</label><input type="number" min="0" step="any" name="system.value" value="{{item.system.value}}">
    <label>{{localize "MYTHRASF.Item.Location"}}</label><input type="text" name="system.location" value="{{item.system.location}}">
    <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.isContainer" {{checked item.system.isContainer}}>{{localize "MYTHRASF.Item.Container.IsContainer"}}</label>
    {{#if item.system.isContainer}}<label>{{localize "MYTHRASF.Item.Container.Capacity"}}</label><input type="number" min="0" name="system.capacityEncumbrance" value="{{item.system.capacityEncumbrance}}">{{/if}}
    <label>{{localize "MYTHRASF.Item.QualityPrices"}}</label><span class="equipment-quality-prices"><input type="number" min="0" step="any" name="system.cheapValue" value="{{item.system.cheapValue}}"><input type="number" min="0" step="any" name="system.reasonableValue" value="{{item.system.reasonableValue}}"><input type="number" min="0" step="any" name="system.superiorValue" value="{{item.system.superiorValue}}"></span>
    <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.equipped" {{checked item.system.equipped}}>{{localize "MYTHRASF.Item.Equipped"}}</label>
    {{/unless}}{{/unless}}
  {{/if}}

  {{#if isWeapon}}
    <nav class="weapon-sheet-tabs" aria-label="{{localize "MYTHRASF.Weapon.Tabs.Label"}}">
      <button type="button" class="active" data-weapon-tab="characteristics" title="{{localize "MYTHRASF.Weapon.Tabs.Characteristics"}}">{{localize "MYTHRASF.Weapon.Tabs.Characteristics"}}</button>
      <button type="button" data-weapon-tab="modes" title="{{localize "MYTHRASF.Weapon.Tabs.Modes"}}">{{localize "MYTHRASF.Weapon.Tabs.Modes"}}</button>
      <button type="button" data-weapon-tab="instance" title="{{localize "MYTHRASF.Weapon.Tabs.Instance"}}">{{localize "MYTHRASF.Weapon.Tabs.Instance"}}</button>
    </nav>

    <section class="weapon-tab-panel active" data-weapon-tab-content="characteristics">
      <fieldset class="weapon-characteristics-editor"><legend>{{localize "MYTHRASF.Weapon.Characteristics"}}</legend>
        <div class="weapon-general-fields">
          <label class="weapon-cost-field"><span>{{localize "MYTHRASF.Item.Value"}}</span><input type="number" min="0" step="any" name="system.value" value="{{item.system.value}}"><select name="system.currency" aria-label="{{localize "MYTHRASF.Currency.Label"}}">{{selectOptions currencyChoices selected=item.system.currency labelAttr="label" valueAttr="value"}}</select></label>
          <label><span>{{localize "MYTHRASF.Weapon.Encumbrance"}}</span><input type="number" min="0" step="any" name="system.encumbrance" value="{{item.system.encumbrance}}"></label>
          <label><span>{{localize "MYTHRASF.Weapon.ArmorPoints"}}</span><input type="number" min="0" name="system.armorPoints" value="{{item.system.armorPoints}}"></label>
          <label><span>{{localize "MYTHRASF.Weapon.MaxHitPoints"}}</span><input type="number" min="0" name="system.maxHitPoints" value="{{item.system.maxHitPoints}}"></label>
          <label><span>{{localize "MYTHRASF.Weapon.Era"}}</span><input name="system.era" value="{{item.system.era}}"></label>
          <label class="weapon-source-field"><span>{{localize "MYTHRASF.Background.Source"}}</span><input name="system.source" value="{{item.system.source}}"></label>
        </div>
        <label class="weapon-description-field"><span>{{localize "MYTHRASF.Item.Description"}}</span><textarea name="system.description">{{item.system.description}}</textarea></label>
        <details class="weapon-advanced-fields"><summary>{{localize "MYTHRASF.Weapon.AdvancedDurability"}}</summary><div>
          <label><span>{{localize "MYTHRASF.Npc.GenerationFormula"}} ({{localize "MYTHRASF.Weapon.ArmorPoints"}})</span><input name="system.armorPointsFormula" value="{{item.system.armorPointsFormula}}"></label>
          <label><span>{{localize "MYTHRASF.Npc.GenerationFormula"}} ({{localize "MYTHRASF.Weapon.MaxHitPoints"}})</span><input name="system.maxHitPointsFormula" value="{{item.system.maxHitPointsFormula}}"></label>
          <label><span>{{localize "MYTHRASF.Weapon.Durability.Label"}}</span><select name="system.durabilitySource">{{selectOptions weaponDurabilityChoices selected=item.system.durabilitySource labelAttr="label" valueAttr="value"}}</select></label>
          <label><span>{{localize "MYTHRASF.Weapon.LinkedLocation"}}</span><select name="system.linkedLocationId"><option value=""></option>{{selectOptions weaponLocationChoices selected=item.system.linkedLocationId labelAttr="label" valueAttr="value"}}</select></label>
        </div></details>
      </fieldset>
    </section>

    <section class="weapon-tab-panel" data-weapon-tab-content="modes">
      <fieldset class="weapon-modes-editor"><legend>{{localize "MYTHRASF.Weapon.Modes"}}</legend>
      <div class="weapon-modes-toolbar"><button type="button" class="sheet-add-button" data-action="add-weapon-mode" aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus" aria-hidden="true"></i></button></div>
      {{#each weaponModes as |mode|}}<article class="weapon-mode-card">
        <header class="weapon-mode-card-header"><label><span>{{localize "MYTHRASF.Weapon.TypeLabel"}}</span><select name="system.modes.{{@index}}.weaponType">{{selectOptions ../weaponTypeChoices selected=mode.weaponType labelAttr="label" valueAttr="value"}}</select></label><div class="weapon-mode-actions"><button type="button" class="sheet-icon-button" data-action="move-weapon-mode" data-mode-index="{{@index}}" data-direction="-1" aria-label="{{localize "MYTHRASF.MoveUp"}}" title="{{localize "MYTHRASF.MoveUp"}}"><i class="fas fa-arrow-up" aria-hidden="true"></i></button><button type="button" class="sheet-icon-button" data-action="move-weapon-mode" data-mode-index="{{@index}}" data-direction="1" aria-label="{{localize "MYTHRASF.MoveDown"}}" title="{{localize "MYTHRASF.MoveDown"}}"><i class="fas fa-arrow-down" aria-hidden="true"></i></button><button type="button" class="sheet-icon-button" data-action="delete-weapon-mode" data-mode-index="{{@index}}" aria-label="{{localize "MYTHRASF.Delete"}}" title="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button></div></header>

        {{#if mode.isSiege}}<div class="weapon-mode-fields weapon-mode-fields-siege">
          <label><span>{{localize "MYTHRASF.Weapon.Damage"}}</span><input name="system.modes.{{@index}}.damage" value="{{mode.damage}}"></label>
          <label class="weapon-short-field"><span>{{localize "MYTHRASF.Weapon.Size"}}</span><input name="system.modes.{{@index}}.size" value="{{mode.size}}"></label>
          <label><span>{{localize "MYTHRASF.Weapon.Range"}}</span><input name="system.modes.{{@index}}.range" value="{{mode.range}}"></label>
          <label class="weapon-short-field"><span>{{localize "MYTHRASF.Weapon.Reload"}}</span><input name="system.modes.{{@index}}.reload" value="{{mode.reload}}"></label>
          <label class="weapon-short-field"><span>{{localize "MYTHRASF.Weapon.CrewMinimum"}}</span><input type="number" min="0" name="system.modes.{{@index}}.crewMinimum" value="{{mode.crewMinimum}}"></label>
          <label class="weapon-short-field"><span>{{localize "MYTHRASF.Weapon.CrewMaximum"}}</span><input type="number" min="0" name="system.modes.{{@index}}.crewMaximum" value="{{mode.crewMaximum}}"></label>
        </div>{{else}}{{#if mode.isRanged}}<div class="weapon-mode-fields weapon-mode-fields-ranged">
          <label class="weapon-short-field"><span>{{localize "MYTHRASF.Weapon.HandsRequired"}}</span><input type="number" min="0" max="2" name="system.modes.{{@index}}.handsRequired" value="{{mode.handsRequired}}"></label>
          <label><span>{{localize "MYTHRASF.Weapon.Damage"}}</span><input name="system.modes.{{@index}}.damage" value="{{mode.damage}}"></label>
          <label class="weapon-short-field"><span>{{localize "MYTHRASF.Weapon.Size"}}</span><input name="system.modes.{{@index}}.size" value="{{mode.size}}"></label>
          <label class="weapon-short-field"><span>{{localize "MYTHRASF.Weapon.ImpalingSize"}}</span><input name="system.modes.{{@index}}.impalingSize" value="{{mode.impalingSize}}"></label>
          <label><span>{{localize "MYTHRASF.Weapon.Range"}}</span><input name="system.modes.{{@index}}.range" value="{{mode.range}}"></label>
          <label class="weapon-short-field"><span>{{localize "MYTHRASF.Weapon.Reload"}}</span><input name="system.modes.{{@index}}.reload" value="{{mode.reload}}"></label>
        </div>{{else}}<div class="weapon-mode-fields weapon-mode-fields-melee">
          <label class="weapon-short-field"><span>{{localize "MYTHRASF.Weapon.HandsRequired"}}</span><input type="number" min="0" max="2" name="system.modes.{{@index}}.handsRequired" value="{{mode.handsRequired}}"></label>
          <label><span>{{localize "MYTHRASF.Weapon.Damage"}}</span><input name="system.modes.{{@index}}.damage" value="{{mode.damage}}"></label>
          <label class="weapon-short-field"><span>{{localize "MYTHRASF.Weapon.Size"}}</span><input name="system.modes.{{@index}}.size" value="{{mode.size}}"></label>
          <label class="weapon-short-field"><span>{{localize "MYTHRASF.Weapon.Reach"}}</span><input name="system.modes.{{@index}}.reach" value="{{mode.reach}}"></label>
        </div>{{/if}}{{/if}}

        <label class="weapon-mode-wide-field"><span>{{localize "MYTHRASF.Weapon.Effects"}}</span><textarea name="system.modes.{{@index}}.effects">{{mode.effects}}</textarea></label>
        <div class="weapon-mode-wide-field"><span>{{localize "MYTHRASF.Weapon.Traits"}}</span><div class="weapon-trait-editor">{{#each mode.traitReferences as |trait|}}<span class="weapon-trait-chip"><button type="button" data-action="open-weapon-trait" data-trait-uuid="{{trait.uuid}}" aria-label="{{trait.name}}" title="{{trait.name}}">{{trait.name}}</button>{{#each trait.parameters as |parameter|}}<label class="weapon-trait-parameter"><span>{{parameter.label}}</span><input name="system.modes.{{../../modeIndex}}.traitRefs.{{../referenceIndex}}.parameters.{{parameterIndex}}.value" value="{{parameter.value}}" aria-label="{{parameter.label}}"></label>{{/each}}{{#if ../../editable}}<button type="button" class="sheet-icon-button" data-action="delete-weapon-trait" data-mode-index="{{../modeIndex}}" data-trait-uuid="{{trait.uuid}}" data-trait-key="{{trait.key}}" aria-label="{{localize "MYTHRASF.Delete"}}" title="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{/if}}</span>{{/each}}{{#if ../editable}}<button type="button" class="sheet-add-button weapon-trait-add" data-action="select-weapon-trait" data-mode-index="{{@index}}" aria-label="{{localize "MYTHRASF.Weapon.SelectTrait"}}" title="{{localize "MYTHRASF.Weapon.SelectTrait"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>{{/if}}</div></div>
      </article>{{/each}}
      </fieldset>
    </section>

    <section class="weapon-tab-panel" data-weapon-tab-content="instance">
      <fieldset class="weapon-instance-editor"><legend>{{localize "MYTHRASF.Weapon.InstanceValues"}}</legend>
        <label>{{localize "MYTHRASF.Item.Quantity"}}</label><input type="number" min="0" name="system.quantity" value="{{item.system.quantity}}">
        <label>{{localize "MYTHRASF.Weapon.CurrentHitPoints"}}</label><input type="number" min="0" name="system.currentHitPoints" value="{{item.system.currentHitPoints}}">
        <label>{{localize "MYTHRASF.Weapon.PreparedMode"}}</label><select name="system.activeModeKey">{{selectOptions weaponModes selected=item.system.activeModeKey labelAttr="displayName" valueAttr="key"}}</select>
        <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.equipped" {{checked item.system.equipped}}>{{localize "MYTHRASF.Item.Equipped"}}</label>
        {{#if item.actor}}{{#each weaponModes as |mode|}}<fieldset class="weapon-instance-mode"><legend>{{mode.displayName}}</legend><label>{{localize "MYTHRASF.Combat.SelectStyle"}}</label><select name="system.modes.{{@index}}.preferredCombatStyleId"><option value=""></option>{{selectOptions mode.combatStyleChoices selected=mode.preferredCombatStyleId labelAttr="name" valueAttr="id"}}</select><label>{{localize "MYTHRASF.Combat.Familiarity"}}</label><select name="system.modes.{{@index}}.familiarity">{{selectOptions ../familiarityChoices selected=mode.familiarity labelAttr="label" valueAttr="value"}}</select></fieldset>{{/each}}{{/if}}
      </fieldset>
    </section>
  {{/if}}

  {{#if isArmor}}
    <nav class="armor-sheet-tabs" aria-label="{{localize "MYTHRASF.Armor.Tabs.Label"}}">
      <button type="button" class="active" data-armor-tab="characteristics">{{localize "MYTHRASF.Armor.Tabs.Characteristics"}}</button>
      <button type="button" data-armor-tab="coverage">{{localize "MYTHRASF.Armor.Tabs.Coverage"}}</button>
      <button type="button" data-armor-tab="configuration">{{localize "MYTHRASF.Armor.Tabs.Configuration"}}</button>
      <button type="button" data-armor-tab="coding">{{localize "MYTHRASF.Armor.Tabs.Coding"}}</button>
    </nav>
    <section class="armor-tab-panel active" data-armor-tab-content="characteristics">
      <fieldset class="armor-sheet-fields"><legend>{{localize "MYTHRASF.Armor.Characteristics"}}</legend>
        <label>{{localize "MYTHRASF.Skill.Source"}}</label><input class="sheet-field-editable" type="text" name="system.source" value="{{item.system.source}}">
        <label>{{localize "MYTHRASF.Armor.ProfileName"}}</label><input type="text" name="system.profileName" value="{{item.system.profileName}}">
        <label>{{localize "MYTHRASF.Armor.Construction.Label"}}</label><select name="system.construction">{{selectOptions armorConstructionChoices selected=item.system.construction labelAttr="label" valueAttr="value"}}</select>
        <label>{{localize "MYTHRASF.Armor.Material.Label"}}</label><select name="system.material">{{selectOptions armorMaterialChoices selected=item.system.material labelAttr="label" valueAttr="value"}}</select>
        <label>{{localize "MYTHRASF.Armor.Points"}}</label><input type="number" min="0" name="system.armorPoints" value="{{item.system.armorPoints}}">
        <label>{{localize "MYTHRASF.Npc.GenerationFormula"}}</label><input type="text" name="system.armorPointsFormula" value="{{item.system.armorPointsFormula}}">
        <label>{{localize "MYTHRASF.Armor.BaseEncumbrance"}}</label><input type="number" min="0" step="any" name="system.baseEncumbrance" value="{{item.system.baseEncumbrance}}">
        <label>{{localize "MYTHRASF.Armor.MaterialModifier"}}</label><output class="sheet-field-readonly">&times;{{item.system.materialModifier}}</output>
        <label>{{localize "MYTHRASF.Armor.TotalEncumbrance"}}</label><output class="sheet-field-readonly">{{armorTotals.encumbrance}}</output>
        <label>{{localize "MYTHRASF.Armor.BaseValue"}}</label><input type="number" min="0" step="any" name="system.baseValue" value="{{item.system.baseValue}}">
        <label>{{localize "MYTHRASF.Armor.TotalValue"}}</label><output class="sheet-field-readonly">{{armorTotals.value}}</output>
        <label>{{localize "MYTHRASF.Armor.Era.Label"}}</label><select name="system.era">{{selectOptions armorEraChoices selected=item.system.era labelAttr="label" valueAttr="value"}}</select>
        <label>{{localize "MYTHRASF.Item.Description"}}</label><textarea name="system.description">{{item.system.description}}</textarea>
      </fieldset>
    </section>
    <section class="armor-tab-panel" data-armor-tab-content="coverage">
      <fieldset class="armor-coverage-editor"><legend>{{localize "MYTHRASF.Armor.Coverage"}}</legend>
        <label>{{localize "MYTHRASF.Armor.ReferenceLocation.Label"}}</label><select name="system.referenceLocation">{{selectOptions armorReferenceLocationChoices selected=item.system.referenceLocation labelAttr="label" valueAttr="value"}}</select>
        {{#if armorLocations.length}}<label>{{localize "MYTHRASF.Armor.AssignedLocation"}}</label>{{#if isSpecialArmor}}<select data-armor-location-id><option value="">{{localize "MYTHRASF.Armor.Unassigned"}}</option>{{selectOptions armorLocations selected=armorSelectedLocationId labelAttr="name" valueAttr="id"}}</select>{{else}}<output class="sheet-field-readonly">{{armorAssignedLocationName}}</output>{{/if}}
        {{else}}<p class="empty">{{localize "MYTHRASF.Armor.CoverageActorRequired"}}</p>{{/if}}
      </fieldset>
    </section>
    <section class="armor-tab-panel" data-armor-tab-content="configuration">
      <fieldset class="armor-sheet-fields"><legend>{{localize "MYTHRASF.Armor.Configuration"}}</legend>
        <label>{{localize "MYTHRASF.Armor.Piece.TypeLabel"}}</label><output class="sheet-field-readonly">{{armorPieceTypeLabel}}</output>
        <label>{{localize "MYTHRASF.Armor.DesignedSize"}}</label><input type="number" min="0" name="system.designedSize" value="{{item.system.designedSize}}">
        <label>{{localize "MYTHRASF.Armor.DesignedBuild"}}</label><input type="text" name="system.designedBuild" value="{{item.system.designedBuild}}">
        <label>{{localize "MYTHRASF.Item.Quantity"}}</label><input type="number" min="0" name="system.quantity" value="{{item.system.quantity}}">
        <label>{{localize "MYTHRASF.Item.Location"}}</label><input type="text" name="system.location" value="{{item.system.location}}">
        <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.equipped" {{checked item.system.equipped}}>{{localize "MYTHRASF.Item.Equipped"}}</label>
      </fieldset>
    </section>
    <section class="armor-tab-panel" data-armor-tab-content="coding">
      <fieldset class="armor-sheet-fields"><legend>{{localize "MYTHRASF.Armor.CodingValues"}}</legend>
        <label>{{localize "MYTHRASF.Armor.ProfileKey"}}</label><input type="text" name="system.profileKey" value="{{item.system.profileKey}}">
      </fieldset>
    </section>
  {{/if}}

  {{#if isHitLocation}}
    <label>{{localize "MYTHRASF.HitLocation.Range"}}</label><div><input type="number" min="1" max="20" name="system.rangeStart" value="{{item.system.rangeStart}}"> – <input type="number" min="1" max="20" name="system.rangeEnd" value="{{item.system.rangeEnd}}"></div>
    <label>{{localize "MYTHRASF.HitLocation.Category.Label"}}</label><select name="system.category">{{selectOptions locationCategoryChoices selected=item.system.category labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.HitLocation.HpClass.Label"}}</label><select name="system.hpClass">{{selectOptions locationHpClassChoices selected=item.system.hpClass labelAttr="label" valueAttr="value"}}</select>
    <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.autoCalculate" {{checked item.system.autoCalculate}}>{{localize "MYTHRASF.HitLocation.AutoCalculate"}}</label>
    <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.disabled" {{checked item.system.disabled}}>{{localize "MYTHRASF.HitLocation.Disabled"}}</label>
    <label>{{localize "MYTHRASF.HitLocation.MaxHitPoints"}}</label><input type="number" min="1" name="system.maxHitPoints" value="{{item.system.maxHitPoints}}">
    <label>{{localize "MYTHRASF.Npc.GenerationFormula"}} ({{localize "MYTHRASF.HitLocation.MaxHitPoints"}})</label><input type="text" name="system.maxHitPointsFormula" value="{{item.system.maxHitPointsFormula}}">
    <label>{{localize "MYTHRASF.HitLocation.CurrentHitPoints"}}</label><input type="number" name="system.currentHitPoints" value="{{item.system.currentHitPoints}}">
    <label>{{localize "MYTHRASF.Armor.Natural"}}</label><input type="number" min="0" name="system.armorPoints" value="{{item.system.armorPoints}}">
    <label>{{localize "MYTHRASF.Npc.GenerationFormula"}} ({{localize "MYTHRASF.Armor.Natural"}})</label><input type="text" name="system.armorPointsFormula" value="{{item.system.armorPointsFormula}}">
    <label>{{localize "MYTHRASF.HitLocation.ArmorEncumbranceMultiplier"}}</label><input type="number" min="0" step="0.5" name="system.armorEncumbranceMultiplier" value="{{item.system.armorEncumbranceMultiplier}}">
    <label>{{localize "MYTHRASF.HitLocation.ArmorCostPercentage"}}</label><input type="number" min="0" step="any" name="system.armorCostPercentage" value="{{item.system.armorCostPercentage}}">
  {{/if}}

  {{#if isTrait}}
    <fieldset class="trait-sheet-fields"><legend>{{localize "MYTHRASF.Trait.Configuration"}}</legend>
      <label>{{localize "MYTHRASF.Item.Source"}}</label><input class="sheet-field-editable" name="system.source" value="{{item.system.source}}">
      <label>{{localize "MYTHRASF.Trait.Type.Label"}}</label><select class="sheet-field-editable" name="system.traitType">{{selectOptions traitTypeChoices selected=item.system.traitType labelAttr="label" valueAttr="value"}}</select>
      <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.requiresAllGroupMembers" {{checked item.system.requiresAllGroupMembers}}>{{localize "MYTHRASF.Trait.RequiresAllGroupMembers.Label"}}</label>
      <label>{{localize "MYTHRASF.Item.Description"}}</label><textarea class="sheet-field-editable" name="system.description">{{item.system.description}}</textarea>
      <label>{{localize "MYTHRASF.Trait.Key"}}</label><input class="sheet-field-editable" name="system.key" value="{{item.system.key}}">
      <label>{{localize "MYTHRASF.Trait.RuleKey"}}</label><input class="sheet-field-editable" name="system.ruleKey" value="{{item.system.ruleKey}}">
    </fieldset>
  {{/if}}

  {{#unless isWeapon}}{{#unless isCombatStyle}}{{#unless isArmor}}{{#unless isTrait}}<label>{{localize "MYTHRASF.Item.Description"}}</label>
  <textarea name="system.description">{{item.system.description}}</textarea>{{/unless}}{{/unless}}{{/unless}}{{/unless}}
</div>
