<div class="item-sheet-content">
  <header class="sheet-header">
    <img src="{{item.img}}" alt="{{item.name}}" data-edit="img">
    <input type="text" name="name" value="{{item.name}}" {{#if isPassion}}readonly{{/if}}>
  </header>

  {{#if isSkillLike}}
    {{#if isSkill}}
      <label>{{localize "MYTHRASF.Item.Category"}}</label>
      <select name="system.category">
        <option value="basic" {{#if item.system.isBasic}}selected{{/if}}>{{localize "MYTHRASF.Skill.Basic"}}</option>
        <option value="professional" {{#if item.system.isProfessional}}selected{{/if}}>{{localize "MYTHRASF.Skill.Professional"}}</option>
      </select>
      <label>{{localize "MYTHRASF.Skill.Group"}}</label>
      <select name="system.group">{{selectOptions groupChoices selected=item.system.group labelAttr="label" valueAttr="value"}}</select>
      <label>{{localize "MYTHRASF.Item.Characteristic1"}}</label>
      <select name="system.characteristic1">{{selectOptions characteristicChoices selected=item.system.characteristic1 labelAttr="label" valueAttr="value"}}</select>
      <label>{{localize "MYTHRASF.Item.Characteristic2"}}</label>
      <select name="system.characteristic2">{{selectOptions characteristicChoices selected=item.system.characteristic2 labelAttr="label" valueAttr="value"}}</select>
    {{/if}}
    {{#if isCombatStyle}}
      <nav class="combat-style-sheet-tabs" aria-label="{{localize "MYTHRASF.CombatStyle.Tabs.Label"}}">
        <button type="button" class="active" data-combat-style-tab="description">{{localize "MYTHRASF.CombatStyle.Tabs.Description"}}</button>
        <button type="button" data-combat-style-tab="weapons">{{localize "MYTHRASF.CombatStyle.Tabs.Weapons"}}</button>
        <button type="button" data-combat-style-tab="configuration">{{localize "MYTHRASF.CombatStyle.Tabs.Configuration"}}</button>
      </nav>

      <section class="combat-style-tab-panel active" data-combat-style-tab-content="description">
        <fieldset class="combat-style-description-editor"><legend>{{localize "MYTHRASF.CombatStyle.Description"}}</legend>
          <label>{{localize "MYTHRASF.CombatStyle.Traits"}}</label>
          <input type="text" name="system.traits" value="{{item.system.traits}}">
          <label>{{localize "MYTHRASF.Item.Description"}}</label>
          <textarea name="system.description">{{item.system.description}}</textarea>
        </fieldset>
      </section>

      <section class="combat-style-tab-panel" data-combat-style-tab-content="weapons">
        <fieldset class="combat-style-weapons-editor">
        <legend>{{localize "MYTHRASF.CombatStyle.Weapons"}}</legend>
        <div class="combat-style-weapon-drop" data-combat-style-weapon-drop><i class="fas fa-hand-pointer" aria-hidden="true"></i>
          <span>{{localize "MYTHRASF.CombatStyle.DropWeaponsHere"}}</span></div>
        <ol class="combat-style-profile-list">
          {{#each combatStyleWeaponProfiles as |profile|}}<li>
            <span class="sheet-field-readonly">{{profile.name}}</span>
            <code>{{profile.key}}</code>
            {{#if ../editable}}<button type="button" class="sheet-icon-button" data-action="delete-combat-style-profile"
              data-profile-key="{{profile.key}}" aria-label="{{localize "MYTHRASF.Delete"}}" title="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{/if}}
          </li>{{else}}<li class="empty">{{localize "MYTHRASF.CombatStyle.NoWeaponProfiles"}}</li>{{/each}}
        </ol>
        {{#if editable}}<div class="combat-style-profile-manual">
          <label for="combat-style-profile-input">{{localize "MYTHRASF.CombatStyle.ManualWeaponProfilesLabel"}}</label>
          <textarea class="sheet-field-editable" data-combat-style-profile-input rows="2"
            id="combat-style-profile-input"
            placeholder="{{localize "MYTHRASF.CombatStyle.ManualWeaponProfiles"}}"></textarea>
          <button type="button" class="sheet-add-button" data-action="add-combat-style-profile"
            aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
        </div>{{/if}}
        </fieldset>
      </section>

      <section class="combat-style-tab-panel" data-combat-style-tab-content="configuration">
        <fieldset class="combat-style-configuration"><legend>{{localize "MYTHRASF.CombatStyle.Configuration"}}</legend>
          <label>{{localize "MYTHRASF.Item.Category"}}</label><output class="sheet-field-readonly">{{localize "MYTHRASF.Skill.Professional"}}</output>
          <label>{{localize "MYTHRASF.Skill.Group"}}</label><output class="sheet-field-readonly">{{localize "MYTHRASF.Skill.GroupCombat"}}</output>
          <label>{{localize "MYTHRASF.Item.Characteristic1"}}</label><output class="sheet-field-readonly">{{combatStyleCharacteristic1}}</output>
          <label>{{localize "MYTHRASF.Item.Characteristic2"}}</label><output class="sheet-field-readonly">{{combatStyleCharacteristic2}}</output>
          <label>{{localize "MYTHRASF.Skill.Base"}}</label><output class="sheet-field-readonly">{{item.system.base}}%</output>
          <label>{{localize "MYTHRASF.CombatStyle.SourceType"}}</label><output class="sheet-field-readonly">{{combatStyleSourceType}}</output>
          <label>{{localize "MYTHRASF.Skill.BaseBonus"}}</label><output class="sheet-field-readonly">{{item.system.baseBonus}}</output>
          <label>{{localize "MYTHRASF.Skill.CulturePoints"}}</label><output class="sheet-field-readonly">{{item.system.culturePoints}}</output>
          <label>{{localize "MYTHRASF.Skill.ProfessionPoints"}}</label><output class="sheet-field-readonly">{{item.system.professionPoints}}</output>
          <label>{{localize "MYTHRASF.Skill.FreePoints"}}</label><output class="sheet-field-readonly">{{item.system.freePoints}}</output>
          <label>{{localize "MYTHRASF.Skill.ExperiencePoints"}}</label><output class="sheet-field-readonly">{{item.system.experiencePoints}}</output>
          <label>{{localize "MYTHRASF.Skill.Total"}}</label><output class="sheet-field-readonly">{{item.system.total}}%</output>
        </fieldset>
      </section>
    {{/if}}
  {{/if}}

  {{#if isBackground}}
    <label>{{localize "MYTHRASF.Background.Key"}}</label><input type="text" name="system.key" value="{{item.system.key}}">
    <label>{{localize "MYTHRASF.Background.Rules"}}</label><textarea name="system.rules">{{item.system.rules}}</textarea>
  {{/if}}

  {{#if isPassion}}
    {{#if item.system.isLegacy}}
      <p class="passion-legacy-note">{{localize "MYTHRASF.Passion.LegacyHelp"}}</p>
      <label>{{localize "MYTHRASF.Passion.Value"}}</label><input type="number" min="0" name="system.value" value="{{item.system.value}}">
    {{/if}}
    <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.structured" {{checked item.system.structured}}>{{localize "MYTHRASF.Passion.Structured"}}</label>
    <label>{{localize "MYTHRASF.Passion.VerbLabel"}}</label><select name="system.verb">{{selectOptions passionVerbChoices selected=item.system.verb labelAttr="label" valueAttr="value"}}</select>
    {{#if isCustomPassionVerb}}<label>{{localize "MYTHRASF.Passion.CustomVerb"}}</label><input type="text" name="system.customVerb" value="{{item.system.customVerb}}">{{/if}}
    <label>{{localize "MYTHRASF.Passion.ObjectType"}}</label><select name="system.objectType">{{selectOptions passionObjectChoices selected=item.system.objectType labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.Passion.ObjectDescription"}}</label><input type="text" name="system.objectDescription" value="{{item.system.objectDescription}}">
    <label>{{localize "MYTHRASF.Passion.CreationBonus"}}</label><input type="number" name="system.creationBonus" value="{{item.system.creationBonus}}">
    <label>{{localize "MYTHRASF.Passion.ExperiencePoints"}}</label><input type="number" name="system.experiencePoints" value="{{item.system.experiencePoints}}">
    <label>{{localize "MYTHRASF.Passion.ManualAdjustment"}}</label><input type="number" name="system.manualAdjustment" value="{{item.system.manualAdjustment}}">
  {{/if}}

  {{#if isEquipment}}
    {{#unless isWeapon}}{{#unless isArmor}}
    <label>{{localize "MYTHRASF.Item.Quantity"}}</label><input type="number" min="0" name="system.quantity" value="{{item.system.quantity}}">
    <label>{{localize "MYTHRASF.Item.Weight"}}</label><input type="number" min="0" step="any" name="system.weight" value="{{item.system.weight}}">
    <label>{{localize "MYTHRASF.Item.Value"}}</label><input type="number" min="0" step="any" name="system.value" value="{{item.system.value}}">
    <label>{{localize "MYTHRASF.Item.Location"}}</label><input type="text" name="system.location" value="{{item.system.location}}">
    <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.equipped" {{checked item.system.equipped}}>{{localize "MYTHRASF.Item.Equipped"}}</label>
    {{/unless}}{{/unless}}
  {{/if}}

  {{#if isWeapon}}
    <nav class="weapon-sheet-tabs" aria-label="{{localize "MYTHRASF.Weapon.Tabs.Label"}}">
      <button type="button" class="active" data-weapon-tab="characteristics">{{localize "MYTHRASF.Weapon.Tabs.Characteristics"}}</button>
      <button type="button" data-weapon-tab="modes">{{localize "MYTHRASF.Weapon.Tabs.Modes"}}</button>
      <button type="button" data-weapon-tab="instance">{{localize "MYTHRASF.Weapon.Tabs.Instance"}}</button>
      <button type="button" data-weapon-tab="coding">{{localize "MYTHRASF.Weapon.Tabs.Coding"}}</button>
    </nav>

    <section class="weapon-tab-panel active" data-weapon-tab-content="characteristics">
      <fieldset class="weapon-characteristics-editor"><legend>{{localize "MYTHRASF.Weapon.Characteristics"}}</legend>
        <label>{{localize "MYTHRASF.Item.Weight"}}</label><input type="number" min="0" step="any" name="system.weight" value="{{item.system.weight}}">
        <label>{{localize "MYTHRASF.Item.Value"}}</label><input type="number" min="0" step="any" name="system.value" value="{{item.system.value}}">
        <label>{{localize "MYTHRASF.Weapon.Encumbrance"}}</label><input type="number" min="0" step="any" name="system.encumbrance" value="{{item.system.encumbrance}}">
        <label>{{localize "MYTHRASF.Item.Location"}}</label><input type="text" name="system.location" value="{{item.system.location}}">
        <label>{{localize "MYTHRASF.Weapon.ArmorPoints"}}</label><input type="number" min="0" name="system.armorPoints" value="{{item.system.armorPoints}}">
        <label>{{localize "MYTHRASF.Weapon.MaxHitPoints"}}</label><input type="number" min="0" name="system.maxHitPoints" value="{{item.system.maxHitPoints}}">
        <label>{{localize "MYTHRASF.Item.Description"}}</label><textarea name="system.description">{{item.system.description}}</textarea>
      </fieldset>
    </section>

    <section class="weapon-tab-panel" data-weapon-tab-content="modes">
      <fieldset class="weapon-modes-editor"><legend>{{localize "MYTHRASF.Weapon.Modes"}}</legend>
      <button type="button" class="sheet-add-button" data-action="add-weapon-mode" aria-label="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus"></i></button>
      {{#each weaponModes as |mode|}}<section class="weapon-mode-editor">
        <div class="weapon-mode-actions"><button type="button" class="sheet-icon-button" data-action="move-weapon-mode" data-mode-index="{{@index}}" data-direction="-1" aria-label="{{localize "MYTHRASF.MoveUp"}}"><i class="fas fa-arrow-up"></i></button><button type="button" class="sheet-icon-button" data-action="move-weapon-mode" data-mode-index="{{@index}}" data-direction="1" aria-label="{{localize "MYTHRASF.MoveDown"}}"><i class="fas fa-arrow-down"></i></button><button type="button" class="sheet-icon-button" data-action="delete-weapon-mode" data-mode-index="{{@index}}" aria-label="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash"></i></button></div>
        <label>{{localize "MYTHRASF.Weapon.ModeKey"}}</label><input name="system.modes.{{@index}}.key" value="{{mode.key}}">
        <label>{{localize "MYTHRASF.Weapon.ModeName"}}</label><input name="system.modes.{{@index}}.name" value="{{mode.name}}">
        <label>{{localize "MYTHRASF.Weapon.ProfileKey"}}</label><input name="system.modes.{{@index}}.profileKey" value="{{mode.profileKey}}">
        <label>{{localize "MYTHRASF.Weapon.TypeLabel"}}</label><select name="system.modes.{{@index}}.weaponType">{{selectOptions ../weaponTypeChoices selected=mode.weaponType labelAttr="label" valueAttr="value"}}</select>
        <label>{{localize "MYTHRASF.Weapon.Damage"}}</label><input name="system.modes.{{@index}}.damage" value="{{mode.damage}}">
        <label>{{localize "MYTHRASF.Weapon.DamageModifier.Label"}}</label><select name="system.modes.{{@index}}.damageModifierMode">{{selectOptions ../damageModifierChoices selected=mode.damageModifierMode labelAttr="label" valueAttr="value"}}</select>
        <label>{{localize "MYTHRASF.Weapon.Size"}}</label><input name="system.modes.{{@index}}.size" value="{{mode.size}}">
        <label>{{localize "MYTHRASF.Weapon.Reach"}}</label><input name="system.modes.{{@index}}.reach" value="{{mode.reach}}">
        <label>{{localize "MYTHRASF.Weapon.Grip"}}</label><input name="system.modes.{{@index}}.grip" value="{{mode.grip}}">
        <label>{{localize "MYTHRASF.Weapon.HandsRequired"}}</label><input type="number" min="0" max="2" name="system.modes.{{@index}}.handsRequired" value="{{mode.handsRequired}}">
        <label>{{localize "MYTHRASF.Weapon.Range"}}</label><input name="system.modes.{{@index}}.range" value="{{mode.range}}">
        <label>{{localize "MYTHRASF.Weapon.Reload"}}</label><input name="system.modes.{{@index}}.reload" value="{{mode.reload}}">
        <label>{{localize "MYTHRASF.Weapon.Effects"}}</label><textarea name="system.modes.{{@index}}.effects">{{mode.effects}}</textarea>
      </section>{{/each}}
      </fieldset>
    </section>

    <section class="weapon-tab-panel" data-weapon-tab-content="instance">
      <fieldset class="weapon-instance-editor"><legend>{{localize "MYTHRASF.Weapon.InstanceValues"}}</legend>
        <label>{{localize "MYTHRASF.Item.Quantity"}}</label><input type="number" min="0" name="system.quantity" value="{{item.system.quantity}}">
        <label>{{localize "MYTHRASF.Weapon.CurrentHitPoints"}}</label><input type="number" min="0" name="system.currentHitPoints" value="{{item.system.currentHitPoints}}">
        <label>{{localize "MYTHRASF.Weapon.PreparedMode"}}</label><select name="system.activeModeKey">{{selectOptions weaponModes selected=item.system.activeModeKey labelAttr="name" valueAttr="key"}}</select>
        <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.equipped" {{checked item.system.equipped}}>{{localize "MYTHRASF.Item.Equipped"}}</label>
      </fieldset>
    </section>

    <section class="weapon-tab-panel" data-weapon-tab-content="coding">
      <fieldset class="weapon-instance-editor"><legend>{{localize "MYTHRASF.Weapon.CodingValues"}}</legend>
        <label>{{localize "MYTHRASF.Weapon.ProfileKey"}}</label><input type="text" name="system.profileKey" value="{{item.system.profileKey}}">
      </fieldset>
    </section>
  {{/if}}

  {{#if isArmor}}
    <nav class="armor-sheet-tabs" aria-label="{{localize "MYTHRASF.Armor.Tabs.Label"}}">
      <button type="button" class="active" data-armor-tab="characteristics">{{localize "MYTHRASF.Armor.Tabs.Characteristics"}}</button>
      <button type="button" data-armor-tab="coverage">{{localize "MYTHRASF.Armor.Tabs.Coverage"}}</button>
      <button type="button" data-armor-tab="configuration">{{localize "MYTHRASF.Armor.Tabs.Configuration"}}</button>
      <button type="button" data-armor-tab="coding">{{localize "MYTHRASF.Armor.Tabs.Coding"}}</button>
    </nav>
    <section class="armor-tab-panel active" data-armor-tab-content="characteristics">
      <fieldset class="armor-sheet-fields"><legend>{{localize "MYTHRASF.Armor.Characteristics"}}</legend>
        <label>{{localize "MYTHRASF.Armor.ProfileName"}}</label><input type="text" name="system.profileName" value="{{item.system.profileName}}">
        <label>{{localize "MYTHRASF.Armor.Points"}}</label><input type="number" min="0" name="system.armorPoints" value="{{item.system.armorPoints}}">
        <label>{{localize "MYTHRASF.Armor.BaseEncumbrance"}}</label><input type="number" min="0" step="any" name="system.baseEncumbrance" value="{{item.system.baseEncumbrance}}">
        <label>{{localize "MYTHRASF.Armor.BaseValue"}}</label><input type="number" min="0" step="any" name="system.baseValue" value="{{item.system.baseValue}}">
        <label>{{localize "MYTHRASF.Armor.Penalty"}}</label><input type="number" min="0" name="system.penalty" value="{{item.system.penalty}}">
        <label>{{localize "MYTHRASF.Armor.Era.Label"}}</label><select name="system.era">{{selectOptions armorEraChoices selected=item.system.era labelAttr="label" valueAttr="value"}}</select>
        <label>{{localize "MYTHRASF.Item.Description"}}</label><textarea name="system.description">{{item.system.description}}</textarea>
      </fieldset>
    </section>
    <section class="armor-tab-panel" data-armor-tab-content="coverage">
      <fieldset class="armor-coverage-editor"><legend>{{localize "MYTHRASF.Armor.Coverage"}}</legend>
        {{#each armorLocations as |location|}}<label class="armor-location-choice">
          <input type="checkbox" class="sheet-state-box" data-armor-location-id="{{location.id}}" {{checked location.selected}}>
          <span>{{location.name}}</span><small>{{localize "MYTHRASF.Armor.EncumbranceShort"}} &times;{{location.encumbranceMultiplier}} · {{localize "MYTHRASF.Armor.PriceShort"}} {{location.costPercentage}}%</small>
        </label>{{else}}<p class="empty">{{localize "MYTHRASF.Armor.CoverageActorRequired"}}</p>{{/each}}
      </fieldset>
      <fieldset class="armor-sheet-fields"><legend>{{localize "MYTHRASF.Armor.CoverageTotals"}}</legend>
        <label>{{localize "MYTHRASF.Armor.EncumbranceFactor"}}</label><output class="sheet-field-readonly">&times;{{armorTotals.encumbranceFactor}}</output>
        <label>{{localize "MYTHRASF.Armor.PricePercentage"}}</label><output class="sheet-field-readonly">{{armorTotals.costPercentage}}%</output>
        <label>{{localize "MYTHRASF.Armor.TotalEncumbrance"}}</label><output class="sheet-field-readonly">{{armorTotals.encumbrance}}</output>
        <label>{{localize "MYTHRASF.Armor.TotalValue"}}</label><output class="sheet-field-readonly">{{armorTotals.value}}</output>
      </fieldset>
    </section>
    <section class="armor-tab-panel" data-armor-tab-content="configuration">
      <fieldset class="armor-sheet-fields"><legend>{{localize "MYTHRASF.Armor.Configuration"}}</legend>
        <label>{{localize "MYTHRASF.Armor.Piece.TypeLabel"}}</label><select name="system.pieceType">{{selectOptions armorPieceTypeChoices selected=item.system.pieceType labelAttr="label" valueAttr="value"}}</select>
        <label>{{localize "MYTHRASF.Item.Quantity"}}</label><input type="number" min="0" name="system.quantity" value="{{item.system.quantity}}">
        <label>{{localize "MYTHRASF.Item.Location"}}</label><input type="text" name="system.location" value="{{item.system.location}}">
        <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.equipped" {{checked item.system.equipped}}>{{localize "MYTHRASF.Item.Equipped"}}</label>
      </fieldset>
    </section>
    <section class="armor-tab-panel" data-armor-tab-content="coding">
      <fieldset class="armor-sheet-fields"><legend>{{localize "MYTHRASF.Armor.CodingValues"}}</legend>
        <label>{{localize "MYTHRASF.Armor.ProfileKey"}}</label><input type="text" name="system.profileKey" value="{{item.system.profileKey}}">
      </fieldset>
    </section>
  {{/if}}

  {{#if isHitLocation}}
    <label>{{localize "MYTHRASF.HitLocation.Range"}}</label><div><input type="number" min="1" max="20" name="system.rangeStart" value="{{item.system.rangeStart}}"> – <input type="number" min="1" max="20" name="system.rangeEnd" value="{{item.system.rangeEnd}}"></div>
    <label>{{localize "MYTHRASF.HitLocation.Category.Label"}}</label><select name="system.category">{{selectOptions locationCategoryChoices selected=item.system.category labelAttr="label" valueAttr="value"}}</select>
    <label>{{localize "MYTHRASF.HitLocation.HpClass.Label"}}</label><select name="system.hpClass">{{selectOptions locationHpClassChoices selected=item.system.hpClass labelAttr="label" valueAttr="value"}}</select>
    <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.autoCalculate" {{checked item.system.autoCalculate}}>{{localize "MYTHRASF.HitLocation.AutoCalculate"}}</label>
    <label class="checkbox"><input type="checkbox" class="sheet-state-box" name="system.disabled" {{checked item.system.disabled}}>{{localize "MYTHRASF.HitLocation.Disabled"}}</label>
    <label>{{localize "MYTHRASF.HitLocation.MaxHitPoints"}}</label><input type="number" min="1" name="system.maxHitPoints" value="{{item.system.maxHitPoints}}">
    <label>{{localize "MYTHRASF.HitLocation.CurrentHitPoints"}}</label><input type="number" name="system.currentHitPoints" value="{{item.system.currentHitPoints}}">
    <label>{{localize "MYTHRASF.Armor.Natural"}}</label><input type="number" min="0" name="system.armorPoints" value="{{item.system.armorPoints}}">
    <label>{{localize "MYTHRASF.HitLocation.ArmorEncumbranceMultiplier"}}</label><input type="number" min="0" step="0.5" name="system.armorEncumbranceMultiplier" value="{{item.system.armorEncumbranceMultiplier}}">
    <label>{{localize "MYTHRASF.HitLocation.ArmorCostPercentage"}}</label><input type="number" min="0" step="any" name="system.armorCostPercentage" value="{{item.system.armorCostPercentage}}">
  {{/if}}

  {{#unless isWeapon}}{{#unless isCombatStyle}}{{#unless isArmor}}<label>{{localize "MYTHRASF.Item.Description"}}</label>
  <textarea name="system.description">{{item.system.description}}</textarea>{{/unless}}{{/unless}}{{/unless}}
</div>
