<div class="npc-sheet-content">
  <header class="sheet-header npc-sheet-header">
    <div class="portrait-frame">
      <button type="button" class="portrait-view" data-action="view-portrait"
        aria-label="{{localize "MYTHRASF.Identity.ViewPortrait"}}" title="{{localize "MYTHRASF.Identity.ViewPortrait"}}">
        <img src="{{actor.img}}" alt="{{actor.name}}">
      </button>
      {{#if editable}}<button type="button" class="portrait-edit" data-action="choose-portrait"
        aria-label="{{localize "MYTHRASF.Identity.ChoosePortrait"}}" title="{{localize "MYTHRASF.Identity.ChoosePortrait"}}">
        <i class="fas fa-camera" aria-hidden="true"></i></button>{{/if}}
    </div>
    <div class="identity-fields npc-identity-fields">
      <label><span>{{localize "MYTHRASF.Identity.CharacterName"}}</span>
        <input class="sheet-field-editable" type="text" name="name" value="{{actor.name}}"></label>
      <label><span>{{localize "MYTHRASF.Npc.Species"}}</span>
        <input class="sheet-field-editable" type="text" name="system.identity.species" value="{{actor.system.identity.species}}"></label>
      <label><span>{{localize "MYTHRASF.Npc.IntelligenceType"}}</span>
        <select class="sheet-field-editable" name="system.intelligenceKind">
          <option value="intelligence" {{#unless isInstinct}}selected{{/unless}}>{{localize "MYTHRASF.Npc.Intelligence"}}</option>
          <option value="instinct" {{#if isInstinct}}selected{{/if}}>{{localize "MYTHRASF.Npc.Instinct"}}</option>
        </select></label>
    </div>
    <section class="header-status npc-header-status" aria-label="{{localize "MYTHRASF.Header.Status"}}">
      <label class="npc-header-resource"><span>{{localize "MYTHRASF.Attribute.ActionPoints"}}</span><div class="npc-header-resource-control"><button type="button" data-resource="actionPoints" data-resource-action="decrease" aria-label="{{localize "MYTHRASF.Resource.Decrease"}}" title="{{localize "MYTHRASF.Resource.Decrease"}}"><i class="fas fa-minus" aria-hidden="true"></i></button><output class="sheet-field-readonly penalized-value">{{headerStatus.actionPoints.base}}{{#if headerStatus.actionPoints.penalized}} <span class="penalized-value-modifier">({{headerStatus.actionPoints.effective}})</span>{{/if}}</output><button type="button" data-resource="actionPoints" data-resource-action="increase" aria-label="{{localize "MYTHRASF.Resource.Increase"}}" title="{{localize "MYTHRASF.Resource.Increase"}}"><i class="fas fa-plus" aria-hidden="true"></i></button><button type="button" data-resource="actionPoints" data-resource-action="restore" aria-label="{{localize "MYTHRASF.Resource.Restore"}}" title="{{localize "MYTHRASF.Resource.Restore"}}"><i class="fas fa-arrow-up" aria-hidden="true"></i></button></div></label>
      <label class="npc-header-resource"><span>{{localize "MYTHRASF.Attribute.LuckPoints"}}</span><div class="npc-header-resource-control"><button type="button" data-resource="luckPoints" data-resource-action="decrease" aria-label="{{localize "MYTHRASF.Resource.Decrease"}}" title="{{localize "MYTHRASF.Resource.Decrease"}}"><i class="fas fa-minus" aria-hidden="true"></i></button><output class="sheet-field-readonly">{{headerStatus.luckPoints}}</output><button type="button" data-resource="luckPoints" data-resource-action="increase" aria-label="{{localize "MYTHRASF.Resource.Increase"}}" title="{{localize "MYTHRASF.Resource.Increase"}}"><i class="fas fa-plus" aria-hidden="true"></i></button><button type="button" data-resource="luckPoints" data-resource-action="restore" aria-label="{{localize "MYTHRASF.Resource.Restore"}}" title="{{localize "MYTHRASF.Resource.Restore"}}"><i class="fas fa-arrow-up" aria-hidden="true"></i></button></div></label>
      <label><span>{{localize "MYTHRASF.HitLocation.Wound"}}</span><output class="sheet-field-readonly wound-{{headerStatus.woundKey}}">{{headerStatus.wound}}</output></label>
      <label><span>{{localize "MYTHRASF.Fatigue.Label"}}</span><output class="sheet-field-readonly fatigue-{{headerStatus.fatigueKey}}">{{headerStatus.fatigue}}</output></label>
      <label title="{{headerStatus.encumbranceTitle}}"><span>{{localize "MYTHRASF.Header.Encumbrance"}}</span><output class="sheet-field-readonly">{{headerStatus.encumbrance}}</output></label>
      <label class="npc-header-resource"><span>{{localize "MYTHRASF.Attribute.MagicPoints"}}</span><div class="npc-header-resource-control"><button type="button" data-resource="magicPoints" data-resource-action="decrease" aria-label="{{localize "MYTHRASF.Resource.Decrease"}}" title="{{localize "MYTHRASF.Resource.Decrease"}}"><i class="fas fa-minus" aria-hidden="true"></i></button><output class="sheet-field-readonly">{{headerStatus.magicPoints}}</output><button type="button" data-resource="magicPoints" data-resource-action="increase" aria-label="{{localize "MYTHRASF.Resource.Increase"}}" title="{{localize "MYTHRASF.Resource.Increase"}}"><i class="fas fa-plus" aria-hidden="true"></i></button><button type="button" data-resource="magicPoints" data-resource-action="restore" aria-label="{{localize "MYTHRASF.Resource.Restore"}}" title="{{localize "MYTHRASF.Resource.Restore"}}"><i class="fas fa-arrow-up" aria-hidden="true"></i></button></div></label>
    </section>
  </header>

  <nav class="sheet-tabs" aria-label="{{localize "MYTHRASF.Navigation"}}">
    <button type="button" class="active" data-tab="general">{{localize "MYTHRASF.Npc.Tab.General"}}</button>
    <button type="button" data-tab="combat">{{localize "MYTHRASF.Tab.Combat"}}</button>
    <button type="button" data-tab="inventory">{{localize "MYTHRASF.Tab.Inventory"}}</button>
    <button type="button" data-tab="penalties">{{localize "MYTHRASF.Tab.Status"}}</button>
    {{#if canRegenerate}}<button type="button" class="npc-regenerate" data-action="regenerate-npc"
      title="{{localize "MYTHRASF.Npc.RegenerateWarning"}}"><i class="fas fa-dice" aria-hidden="true"></i>
      {{localize "MYTHRASF.Npc.Regenerate"}}</button>{{/if}}
  </nav>

  <main class="sheet-body">
    <section class="tab-panel active" data-tab-content="general">
      <div class="npc-general-grid">
        <fieldset class="npc-characteristics-panel">
          <legend>{{localize "MYTHRASF.Characteristics"}}</legend>
          {{#if isTemplate}}<div class="npc-characteristic-header" aria-hidden="true"><span>{{localize "MYTHRASF.Npc.Field"}}</span><span>{{localize "MYTHRASF.Npc.Reference"}}</span><span>{{localize "MYTHRASF.Npc.Formula"}}</span></div>{{/if}}
          {{#each characteristicRows as |row|}}<div class="npc-characteristic-row {{#unless ../isTemplate}}resolved{{/unless}}">
            <label for="npc-characteristic-{{row.key}}">{{row.label}}</label>
            {{#if ../isTemplate}}<input id="npc-characteristic-{{row.key}}" class="sheet-field-editable" type="number" min="1" name="system.{{row.key}}" value="{{row.value}}">
            <input class="sheet-field-editable" type="text" name="system.characteristicFormulas.{{row.key}}" value="{{row.formula}}" placeholder="2d6+6">
            {{else}}<output id="npc-characteristic-{{row.key}}" class="sheet-field-readonly">{{row.value}}</output>{{/if}}
          </div>{{/each}}
        </fieldset>

        <fieldset class="npc-attributes-panel">
          <legend>{{localize "MYTHRASF.Attributes"}}</legend>
          {{#each attributeRows as |row|}}<div class="npc-attribute-row {{#unless ../isTemplate}}resolved{{/unless}}">
            <label>{{row.label}}</label>
            {{#if ../isTemplate}}<select class="sheet-field-editable" name="system.attributeOverrides.{{row.key}}.mode">
              <option value="auto" {{#unless row.manual}}selected{{/unless}}>{{localize "MYTHRASF.Npc.Auto"}}</option>
              <option value="manual" {{#if row.manual}}selected{{/if}}>{{localize "MYTHRASF.Npc.Manual"}}</option>
            </select>
            {{#if row.manual}}<input class="sheet-field-editable" type="number" min="0" name="system.attributeOverrides.{{row.key}}.value" value="{{row.value}}">{{else}}<output class="sheet-field-readonly">{{row.resolved}}</output>{{/if}}
            <input class="sheet-field-editable" type="text" name="system.attributeOverrides.{{row.key}}.formula" value="{{row.formula}}" placeholder="1d3+2">
            {{else}}<output class="sheet-field-readonly penalized-value">{{row.display.base}}{{#if row.display.penalized}} <span class="penalized-value-modifier">({{row.display.effective}})</span>{{/if}}</output>{{/if}}
          </div>{{/each}}
          <div class="npc-attribute-row npc-damage-modifier {{#unless isTemplate}}resolved{{/unless}}">
            <label>{{localize "MYTHRASF.Attribute.DamageModifier"}}</label>
            {{#if isTemplate}}<select class="sheet-field-editable" name="system.attributeOverrides.damageModifier.mode">
              <option value="auto" {{#unless damageModifierManual}}selected{{/unless}}>{{localize "MYTHRASF.Npc.Auto"}}</option>
              <option value="manual" {{#if damageModifierManual}}selected{{/if}}>{{localize "MYTHRASF.Npc.Manual"}}</option>
            </select>{{/if}}
            {{#if isTemplate}}{{#if damageModifierManual}}<input class="sheet-field-editable" type="text" name="system.attributeOverrides.damageModifier.formula" value="{{actor.system.attributeOverrides.damageModifier.formula}}">{{else}}<output class="sheet-field-readonly">{{damageModifierLabel}}</output>{{/if}}{{else}}<output class="sheet-field-readonly">{{damageModifierLabel}}</output>{{/if}}
          </div>
        </fieldset>
      </div>

      <div class="npc-skills-layout">
        <fieldset class="npc-list-panel npc-skills-panel"><legend>{{localize "MYTHRASF.Skills"}}</legend>
          <button type="button" class="npc-special-roll" data-action="roll-special" title="{{localize "MYTHRASF.SpecialRoll.Title"}}">{{localize "MYTHRASF.SpecialRoll.Title"}}</button>
          {{#if editable}}<button type="button" class="sheet-add-button" data-action="create-item" data-type="skill" aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>{{/if}}
          <div class="npc-skill-grid-headers" aria-hidden="true">
            <div class="npc-skill-header {{#unless isTemplate}}resolved{{/unless}}"><span></span><span>{{localize "MYTHRASF.Skill.Name"}}</span><span>%</span>{{#if isTemplate}}<span>{{localize "MYTHRASF.Npc.Formula"}}</span>{{/if}}<span></span></div>
            <div class="npc-skill-header {{#unless isTemplate}}resolved{{/unless}}"><span></span><span>{{localize "MYTHRASF.Skill.Name"}}</span><span>%</span>{{#if isTemplate}}<span>{{localize "MYTHRASF.Npc.Formula"}}</span>{{/if}}<span></span></div>
          </div>
          <div class="npc-skill-grid">
            {{#each skills as |row|}}<div class="npc-skill-row {{#unless ../isTemplate}}resolved{{/unless}}" data-item-id="{{row.item.id}}">
              <button type="button" class="sheet-icon-button" data-action="roll-skill" aria-label="{{localize "MYTHRASF.Roll"}}" title="{{localize "MYTHRASF.Roll"}}"><i class="fas fa-dice-d20" aria-hidden="true"></i></button>
              <button type="button" class="npc-item-name" data-action="edit-item">{{row.item.name}}</button>
              {{#if ../isTemplate}}<input class="sheet-field-editable" type="number" min="0" data-manual-value value="{{row.total}}" aria-label="{{localize "MYTHRASF.Skill.ManualValue"}}">{{else}}<output class="sheet-field-readonly penalized-value">{{row.display.base}}%{{#if row.display.penalized}} <span class="penalized-value-modifier">({{row.display.effective}}%)</span>{{/if}}</output>{{/if}}
              {{#if ../isTemplate}}<input class="sheet-field-editable" type="text" data-item-field="generationFormula" value="{{row.item.system.generationFormula}}" placeholder="1d10+50">{{/if}}
              <div class="npc-row-actions">{{#if ../editable}}<button type="button" class="sheet-icon-button" data-action="delete-item" aria-label="{{localize "MYTHRASF.Delete"}}" title="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{/if}}</div>
            </div>{{else}}<p class="empty">{{localize "MYTHRASF.Empty.Skills"}}</p>{{/each}}
          </div>
        </fieldset>
      </div>

      <div class="npc-ability-grid npc-traits-passions-layout">
        <fieldset class="npc-list-panel"><legend>{{localize "MYTHRASF.Npc.Traits"}}</legend>
          {{#if editable}}<button type="button" class="sheet-add-button" data-action="create-item" data-type="trait" aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>{{/if}}
          <div class="npc-compact-grid">{{#each traits as |item|}}<div class="npc-compact-row" data-item-id="{{item.id}}"><img src="{{item.img}}" alt=""><button type="button" class="npc-item-name" data-action="edit-item">{{item.name}}</button><span class="npc-trait-description">{{{item.system.description}}}</span>{{#if ../editable}}<button type="button" class="sheet-icon-button" data-action="delete-item" aria-label="{{localize "MYTHRASF.Delete"}}" title="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{/if}}</div>{{else}}<p class="empty">{{localize "MYTHRASF.Npc.EmptyTraits"}}</p>{{/each}}</div>
        </fieldset>
        <fieldset class="npc-list-panel"><legend>{{localize "MYTHRASF.Passions"}}</legend>
          {{#if editable}}<button type="button" class="sheet-add-button" data-action="create-item" data-type="passion" aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>{{/if}}
          <div class="npc-compact-grid">{{#each passions as |item|}}<div class="npc-compact-row" data-item-id="{{item.id}}"><button type="button" class="sheet-icon-button" data-action="roll-passion" aria-label="{{localize "MYTHRASF.Roll"}}" title="{{localize "MYTHRASF.Roll"}}"><i class="fas fa-dice-d20" aria-hidden="true"></i></button><button type="button" class="npc-item-name" data-action="edit-item">{{item.name}}</button><output class="sheet-field-readonly">{{item.system.total}}%</output>{{#if ../editable}}<button type="button" class="sheet-icon-button" data-action="delete-item" aria-label="{{localize "MYTHRASF.Delete"}}" title="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{/if}}</div>{{else}}<p class="empty">{{localize "MYTHRASF.Empty.Passions"}}</p>{{/each}}</div>
        </fieldset>
      </div>
      <fieldset class="npc-magic-panel"><legend>{{localize "MYTHRASF.Npc.Magic"}}</legend><textarea class="sheet-field-editable" name="system.magicNotes">{{actor.system.magicNotes}}</textarea></fieldset>
      <fieldset class="npc-description-panel"><legend>{{localize "MYTHRASF.Item.Description"}}</legend><textarea class="sheet-field-editable" name="system.description">{{actor.system.description}}</textarea></fieldset>
      {{> "systems/mythras-foundry/templates/actor/parts/permanent-wounds.hbs"}}
      <fieldset><legend>{{localize "MYTHRASF.Npc.ArmorNotes"}}</legend><input class="sheet-field-editable" type="text" name="system.armorNotes" value="{{actor.system.armorNotes}}"></fieldset>
    </section>

    <section class="tab-panel" data-tab-content="combat">
      {{> "systems/mythras-foundry/templates/actor/parts/combat-tab.hbs"}}
    </section>

    <section class="tab-panel" data-tab-content="inventory">
      {{> "systems/mythras-foundry/templates/actor/parts/inventory-tab.hbs"}}
    </section>

    <section class="tab-panel" data-tab-content="penalties">
      {{> "systems/mythras-foundry/templates/actor/parts/penalties-tab.hbs"}}
    </section>
  </main>
</div>
