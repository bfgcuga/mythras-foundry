<div class="character-sheet-content">
  <header class="sheet-header">
    <div class="portrait-frame">
      <button type="button" class="portrait-view" data-action="view-portrait"
        aria-label="{{localize "MYTHRASF.Identity.ViewPortrait"}}"
        title="{{localize "MYTHRASF.Identity.ViewPortrait"}}">
        <img src="{{actor.img}}" alt="{{actor.name}}">
      </button>
      {{#if editable}}
        <button type="button" class="portrait-edit" data-action="choose-portrait"
          aria-label="{{localize "MYTHRASF.Identity.ChoosePortrait"}}"
          title="{{localize "MYTHRASF.Identity.ChoosePortrait"}}">
          <i class="fas fa-camera" aria-hidden="true"></i>
        </button>
      {{/if}}
    </div>
    <div class="identity-fields">
      <label class="identity-name">
        <span>{{localize "MYTHRASF.Identity.CharacterName"}}</span>
        <input type="text" class="sheet-field-editable" name="name" value="{{actor.name}}">
      </label>
      <label>
        <span>{{localize "MYTHRASF.Identity.PlayerName"}}</span>
        <input type="text" class="sheet-field-editable" name="system.identity.playerName"
          value="{{actor.system.identity.playerName}}">
      </label>
      <label>
        <span>{{localize "MYTHRASF.Identity.Culture"}}</span>
        <output class="identity-readonly sheet-field-readonly">{{actor.system.identity.culture.name}}</output>
      </label>
      <label>
        <span>{{localize "MYTHRASF.Identity.Profession"}}</span>
        <output class="identity-readonly sheet-field-readonly">{{actor.system.identity.profession.name}}</output>
      </label>
      <label>
        <span>{{localize "MYTHRASF.Identity.SocialClass"}}</span>
        <output class="identity-readonly sheet-field-readonly"
          title="{{actor.system.identity.socialClass.resources}}">{{actor.system.identity.socialClass.name}}</output>
      </label>
      <label>
        <span>{{localize "MYTHRASF.Identity.Age"}}</span>
        <input type="number" min="0" step="1" class="sheet-field-editable"
          name="system.identity.age" value="{{actor.system.identity.age}}">
      </label>
    </div>
    <section class="header-status" aria-label="{{localize "MYTHRASF.Header.Status"}}">
      <label><span>{{localize "MYTHRASF.Attribute.LuckPoints"}}</span><output class="sheet-field-readonly">{{headerStatus.luckPoints}}</output></label>
      <label><span>{{localize "MYTHRASF.Attribute.MagicPoints"}}</span><output class="sheet-field-readonly">{{headerStatus.magicPoints}}</output></label>
      <label><span>{{localize "MYTHRASF.Attribute.ActionPoints"}}</span><output class="sheet-field-readonly penalized-value">{{headerStatus.actionPoints.base}}{{#if headerStatus.actionPoints.penalized}} <span class="penalized-value-modifier">({{headerStatus.actionPoints.effective}})</span>{{/if}}</output></label>
      <label><span>{{localize "MYTHRASF.HitLocation.Wound"}}</span><output class="sheet-field-readonly wound-{{headerStatus.woundKey}}">{{headerStatus.wound}}</output></label>
      <label><span>{{localize "MYTHRASF.Fatigue.Label"}}</span><output class="sheet-field-readonly fatigue-{{headerStatus.fatigueKey}}">{{headerStatus.fatigue}}</output></label>
      <label><span>{{localize "MYTHRASF.Header.Encumbrance"}}</span><output class="sheet-field-readonly">{{headerStatus.encumbrance}}</output></label>
      <label class="header-penalty"><span>{{localize "MYTHRASF.Header.Penalty"}}</span><output class="sheet-field-readonly">{{headerStatus.woundPenalty}}</output></label>
      <label class="header-penalty"><span>{{localize "MYTHRASF.Header.Penalty"}}</span><output class="sheet-field-readonly">{{headerStatus.fatiguePenalty}}</output></label>
      <label class="header-penalty"><span>{{localize "MYTHRASF.Header.Penalty"}}</span><output class="sheet-field-readonly">{{headerStatus.encumbrancePenalty}}</output></label>
    </section>
    <label class="header-experience-rolls">
      <span>{{localize "MYTHRASF.Header.ExperienceRolls"}}</span>
      <input type="number" min="0" step="1" class="sheet-field-editable"
        name="system.experienceRolls" value="{{actor.system.experienceRolls}}">
    </label>
  </header>

    <nav class="sheet-tabs" aria-label="{{localize "MYTHRASF.Navigation"}}">
      <button type="button" class="active" data-tab="character">
        {{localize "MYTHRASF.Tab.Character"}}
      </button>
      <button type="button" data-tab="combat">
        {{localize "MYTHRASF.Tab.Combat"}}
      </button>
      <button type="button" data-tab="inventory">
        {{localize "MYTHRASF.Tab.Inventory"}}
      </button>
      {{#if editable}}
        <button type="button" class="sheet-train-skill" data-action="train-skill">
          <i class="fas fa-graduation-cap" aria-hidden="true"></i>
          {{localize "MYTHRASF.Skill.Train"}}
        </button>
        <button type="button" class="sheet-edit-toggle {{#if editMode}}active{{/if}}"
          data-action="toggle-edit-mode" aria-pressed="{{editMode}}">
          <i class="fas {{#if editMode}}fa-check{{else}}fa-pen{{/if}}" aria-hidden="true"></i>
          {{#if editMode}}
            {{localize "MYTHRASF.EditMode.Finish"}}
          {{else}}
            {{localize "MYTHRASF.EditMode.Start"}}
          {{/if}}
        </button>
      {{/if}}
    </nav>

    <main class="sheet-body">
      <section class="tab-panel active" data-tab-content="character">
        <section class="paper-stat-block">
          <fieldset class="paper-characteristics">
            <legend>
              <span>{{localize "MYTHRASF.Characteristics"}}</span>
            </legend>
            {{> "systems/mythras-foundry/templates/actor/parts/characteristics.hbs"}}
            {{#unless actor.system.characteristicsGenerated}}
              <div class="character-generation">
                {{#if isPointAllocation}}
                  <p class="allocation-remaining">
                    {{localize "MYTHRASF.Character.PointsRemaining" points=allocationRemaining}}
                  </p>
                {{/if}}
                {{#if generationMethod}}
                  <button type="button" class="confirm-characteristics"
                    data-action="confirm-characteristics">
                    <i class="fas fa-check" aria-hidden="true"></i>
                    {{localize "MYTHRASF.Character.Confirm"}}
                  </button>
                {{/if}}
                <div class="generation-methods">
                  {{#each generationMethods as |method|}}
                    <button type="button" class="{{#if method.active}}active{{/if}}"
                      data-generation-method="{{method.key}}">{{method.label}}</button>
                  {{/each}}
                </div>
              </div>
            {{/unless}}
          </fieldset>

          <fieldset class="paper-attributes">
            <legend>{{localize "MYTHRASF.Attributes"}}</legend>
            <div class="paper-attribute-list">
              <label class="resource-attribute">
                <span>{{localize "MYTHRASF.Attribute.ActionPoints"}}</span>
                <div class="resource-control">
                  <button type="button" data-resource="actionPoints"
                    data-resource-action="decrease" aria-label="{{localize "MYTHRASF.Resource.Decrease"}}">−</button>
                  <button type="button" data-resource="actionPoints"
                    data-resource-action="increase" aria-label="{{localize "MYTHRASF.Resource.Increase"}}">+</button>
                  <button type="button" data-resource="actionPoints"
                    data-resource-action="restore" aria-label="{{localize "MYTHRASF.Resource.Restore"}}">
                    <i class="fas fa-arrow-up" aria-hidden="true"></i>
                  </button>
                  <output class="resource-value">
                    <span>{{attributePenalties.actionPoints.base}}</span>
                    {{#if attributePenalties.actionPoints.penalized}}<b class="penalized-value-modifier">({{attributePenalties.actionPoints.effective}})</b>{{/if}}
                  </output>
                </div>
              </label>
              <label><span>{{localize "MYTHRASF.Attribute.DamageModifier"}}</span>
                <output>{{actor.system.attributes.damageModifier.label}}</output></label>
              <label><span>{{localize "MYTHRASF.Attribute.ExperienceModifier"}}</span>
                <output>{{actor.system.attributes.experienceModifier}}</output></label>
              <label><span>{{localize "MYTHRASF.Attribute.HealingRate"}}</span>
                <output>{{actor.system.attributes.healingRate}}</output></label>
              <label><span>{{localize "MYTHRASF.Attribute.Initiative"}}</span>
                <output class="penalized-value">{{attributePenalties.initiative.base}}{{#if attributePenalties.initiative.penalized}} <span class="penalized-value-modifier">({{attributePenalties.initiative.effective}})</span>{{/if}}</output></label>
              <label class="resource-attribute">
                <span>{{localize "MYTHRASF.Attribute.LuckPoints"}}</span>
                <div class="resource-control">
                  <button type="button" data-resource="luckPoints"
                    data-resource-action="decrease" aria-label="{{localize "MYTHRASF.Resource.Decrease"}}">−</button>
                  <button type="button" data-resource="luckPoints"
                    data-resource-action="increase" aria-label="{{localize "MYTHRASF.Resource.Increase"}}">+</button>
                  <button type="button" data-resource="luckPoints"
                    data-resource-action="restore" aria-label="{{localize "MYTHRASF.Resource.Restore"}}">
                    <i class="fas fa-arrow-up" aria-hidden="true"></i>
                  </button>
                  <output class="resource-value">
                    <span>{{actor.system.resources.luckPoints.value}}</span>
                    <b>/ {{actor.system.attributes.luckPointsMax}}</b>
                  </output>
                </div>
              </label>
              <label class="resource-attribute">
                <span>{{localize "MYTHRASF.Attribute.MagicPoints"}}</span>
                <div class="resource-control">
                  <button type="button" data-resource="magicPoints"
                    data-resource-action="decrease" aria-label="{{localize "MYTHRASF.Resource.Decrease"}}">−</button>
                  <button type="button" data-resource="magicPoints"
                    data-resource-action="increase" aria-label="{{localize "MYTHRASF.Resource.Increase"}}">+</button>
                  <button type="button" data-resource="magicPoints"
                    data-resource-action="restore" aria-label="{{localize "MYTHRASF.Resource.Restore"}}">
                    <i class="fas fa-arrow-up" aria-hidden="true"></i>
                  </button>
                  <output class="resource-value">
                    <span>{{actor.system.resources.magicPoints.value}}</span>
                    <b>/ {{actor.system.attributes.magicPointsMax}}</b>
                  </output>
                </div>
              </label>
              <label><span>{{localize "MYTHRASF.Attribute.MovementRate"}}</span>
                <output class="penalized-value">{{attributePenalties.movement.base}}{{#if attributePenalties.movement.penalized}} <span class="penalized-value-modifier">({{attributePenalties.movement.effective}})</span>{{/if}}</output></label>
            </div>
          </fieldset>
        </section>

        {{#if backgroundWizard}}
          {{> "systems/mythras-foundry/templates/actor/parts/background-wizard.hbs"
            wizard=backgroundWizard}}
        {{/if}}

        {{#if backgroundWizard.allocationPhase}}
          <div class="background-floating-counter">
            {{localize "MYTHRASF.Background.PointsRemaining"
              points=backgroundWizard.allocationRemaining
              total=backgroundWizard.allocationBudget}}
            {{#if backgroundWizard.allocationLimits}}<small>{{localize
              "MYTHRASF.Background.PointLimits"
              minimum=backgroundWizard.allocationLimits.minimum
              maximum=backgroundWizard.allocationLimits.maximum}}</small>{{/if}}
          </div>
        {{/if}}

        <section class="paper-skill-columns {{#if editMode}}skills-editing{{/if}}">
          <div class="paper-skill-column paper-skill-column-basic">
            {{> "systems/mythras-foundry/templates/actor/parts/skill-overview.hbs"
              group=basicSkillGroup editable=editable skillsEditing=editMode
              canImproveSkills=canImproveSkills}}
            {{> "systems/mythras-foundry/templates/actor/parts/skill-overview.hbs"
              group=combatSkillGroup editable=editable skillsEditing=editMode
              canImproveSkills=canImproveSkills}}
          </div>
          <div class="paper-skill-column paper-skill-column-secondary">
            {{#each secondarySkillGroups as |group|}}
              {{> "systems/mythras-foundry/templates/actor/parts/skill-overview.hbs"
                group=group editable=../editable skillsEditing=../editMode
                canImproveSkills=../canImproveSkills}}
            {{/each}}

          <fieldset class="paper-passions">
            <legend>{{localize "MYTHRASF.Passions"}}</legend>
            {{#if editable}}
              <button type="button" class="passion-add sheet-add-button"
                data-action="create-item" data-type="passion"
                aria-label="{{localize "MYTHRASF.Add"}}"
                title="{{localize "MYTHRASF.Add"}}">
                <i class="fas fa-plus" aria-hidden="true"></i>
              </button>
            {{/if}}
            <div class="paper-passion-header" aria-hidden="true">
              <span></span>
              <span>{{localize "MYTHRASF.Passion.Name"}}</span>
              <span>{{localize "MYTHRASF.Skill.Base"}}</span>
              <span>{{localize "MYTHRASF.Skill.BonusSum"}}</span>
              <span>{{localize "MYTHRASF.Skill.Total"}}</span>
              <span></span>
            </div>
            {{#each passions as |item|}}
              <div class="paper-passion-row" data-item-id="{{item.id}}">
                <button type="button" class="passion-roll" data-action="roll-passion"
                  aria-label="{{localize "MYTHRASF.Passion.Roll"}}">
                  <i class="fas fa-dice-d20" aria-hidden="true"></i>
                </button>
                <button type="button" data-action="edit-item">{{item.name}}</button>
                <output>{{item.system.base}}</output>
                <output>{{item.system.allocatedBonus}}</output>
                <output>{{item.system.total}}%</output>
                {{#if ../editMode}}
                  <div class="passion-edit-controls">
                    <button type="button" data-passion-adjust="-1">−</button>
                    <button type="button" data-passion-adjust="1">+</button>
                    <button type="button" class="passion-delete" data-action="delete-item"
                      aria-label="{{localize "MYTHRASF.Delete"}}">
                      <i class="fas fa-trash" aria-hidden="true"></i>
                    </button>
                  </div>
                {{else}}
                  <span></span>
                {{/if}}
              </div>
            {{else}}
              <p class="empty">{{localize "MYTHRASF.Empty.Passions"}}</p>
            {{/each}}
          </fieldset>
          </div>
        </section>
      </section>

      <section class="tab-panel" data-tab-content="skills">
        <div class="section-heading">
          <h2>{{localize "MYTHRASF.Tab.Skills"}}</h2>
          {{#if editable}}
            <button type="button" data-action="create-item" data-type="skill">
              {{localize "MYTHRASF.Add"}}
            </button>
          {{/if}}
        </div>

        {{#each skillGroups as |group|}}
        <section class="skill-group" data-skill-group="{{group.key}}">
          <h3>{{localize group.label}}</h3>
        <div class="skill-list-header" aria-hidden="true">
          <span>{{localize "MYTHRASF.Skill.Name"}}</span>
          <span>{{localize "MYTHRASF.Skill.Base"}}</span>
          <span>{{localize "MYTHRASF.Skill.BonusSum"}}</span>
          <span>{{localize "MYTHRASF.Skill.TrainedShort"}}</span>
          <span>{{localize "MYTHRASF.Skill.FumbledShort"}}</span>
          <span>{{localize "MYTHRASF.Skill.Total"}}</span>
          <span></span>
        </div>
        <ol class="item-list skill-list">
          {{#each group.skills as |item|}}
            <li data-item-id="{{item.id}}">
              <button type="button" class="item-name" data-action="edit-item">{{item.name}}</button>
              <output class="skill-base">{{item.system.base}}</output>
              <output class="skill-bonus">{{item.system.allocatedBonus}}</output>
              <input type="checkbox" class="sheet-state-box" {{checked item.system.trained}}
                data-skill-field="trained"
                aria-label="{{localize "MYTHRASF.Skill.Trained"}}">
              <input type="checkbox" class="sheet-state-box" {{checked item.system.fumbled}}
                data-skill-field="fumbled"
                aria-label="{{localize "MYTHRASF.Skill.Fumbled"}}">
              <strong class="skill-total penalized-value" title="{{item.system.base}} + {{item.system.allocatedBonus}}">
                {{item.totalDisplay.base}}%{{#if item.totalDisplay.penalized}} <span class="penalized-value-modifier">({{item.totalDisplay.effective}}%)</span>{{/if}}
              </strong>
              <div class="skill-actions">
                {{#if ../../canImproveSkills}}
                  <button type="button" class="skill-improve sheet-icon-button"
                    data-action="improve-skill"
                    aria-label="{{localize "MYTHRASF.Skill.Improve"}}"
                    title="{{localize "MYTHRASF.Skill.Improve"}}">
                    <i class="fas fa-angles-up" aria-hidden="true"></i>
                  </button>
                {{/if}}
                <select data-difficulty aria-label="{{localize "MYTHRASF.Skill.Difficulty"}}">
                  <option value="automatic">{{localize "MYTHRASF.Difficulty.automatic"}}</option>
                  <option value="veryEasy">{{localize "MYTHRASF.Difficulty.veryEasy"}}</option>
                  <option value="easy">{{localize "MYTHRASF.Difficulty.easy"}}</option>
                  <option value="standard" selected>{{localize "MYTHRASF.Difficulty.standard"}}</option>
                  <option value="hard">{{localize "MYTHRASF.Difficulty.hard"}}</option>
                  <option value="formidable">{{localize "MYTHRASF.Difficulty.formidable"}}</option>
                  <option value="herculean">{{localize "MYTHRASF.Difficulty.herculean"}}</option>
                  <option value="impossible">{{localize "MYTHRASF.Difficulty.impossible"}}</option>
                </select>
                <button type="button" data-action="roll-skill">{{localize "MYTHRASF.Roll"}}</button>
                {{#if ../../editable}}
                  <button type="button" data-action="delete-item" aria-label="{{localize "MYTHRASF.Delete"}}">×</button>
                {{/if}}
              </div>
            </li>
          {{else}}
            <li class="empty">{{localize "MYTHRASF.Empty.Skills"}}</li>
          {{/each}}
        </ol>
        </section>
        {{/each}}
      </section>

      <section class="tab-panel" data-tab-content="combat">
        {{> "systems/mythras-foundry/templates/actor/parts/combat-tab.hbs"}}
      </section>

      <section class="tab-panel" data-tab-content="inventory">
        <section class="inventory-wallet" aria-label="{{localize "MYTHRASF.Currency.Personal"}}">
          <h2>{{localize "MYTHRASF.Currency.Personal"}}</h2>
          <label>PC <input type="number" min="0" step="1" class="sheet-field-editable" name="system.currency.copper" value="{{actor.system.currency.copper}}"></label>
          <label>PP <input type="number" min="0" step="1" class="sheet-field-editable" name="system.currency.silver" value="{{actor.system.currency.silver}}"></label>
          <label>PO <input type="number" min="0" step="1" class="sheet-field-editable" name="system.currency.gold" value="{{actor.system.currency.gold}}"></label>
          {{#if editable}}<button type="button" class="sheet-add-button" data-action="create-item" data-type="equipment" data-category="property" aria-label="{{localize "MYTHRASF.Inventory.AddProperty"}}" title="{{localize "MYTHRASF.Inventory.AddProperty"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>{{/if}}
        </section>
        {{#each inventorySections as |section|}}
        <fieldset class="inventory-panel inventory-location-frame" data-inventory-destination="{{section.id}}">
          <legend>{{section.label}}</legend>
          {{#if section.property}}<div class="inventory-property-actions" data-item-id="{{section.id}}"><button type="button" class="sheet-icon-button" data-action="edit-item" aria-label="{{localize "MYTHRASF.Edit"}}" title="{{localize "MYTHRASF.Edit"}}"><i class="fas fa-pen" aria-hidden="true"></i></button><button type="button" class="sheet-icon-button" data-action="delete-item" aria-label="{{localize "MYTHRASF.Delete"}}" title="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button></div>{{/if}}
          {{#if editable}}
            <button type="button" class="inventory-panel-add sheet-add-button" data-action="create-item"
              data-type="equipment" data-parent-id="{{#if section.property}}{{section.id}}{{/if}}" aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}">
              <i class="fas fa-plus" aria-hidden="true"></i></button>
          {{/if}}
          {{#if section.property}}<div class="inventory-wallet inventory-property-wallet">
            <label>PC <input type="number" min="0" step="1" class="sheet-field-editable" data-property-funds="copper" value="{{section.property.system.funds.copper}}"></label>
            <label>PP <input type="number" min="0" step="1" class="sheet-field-editable" data-property-funds="silver" value="{{section.property.system.funds.silver}}"></label>
            <label>PO <input type="number" min="0" step="1" class="sheet-field-editable" data-property-funds="gold" value="{{section.property.system.funds.gold}}"></label>
          </div>{{/if}}
          {{> "systems/mythras-foundry/templates/actor/parts/inventory-tree.hbs" items=section.rows}}
        </fieldset>
        {{/each}}
      </section>
    </main>
</div>
