<div class="character-sheet-content">
  <header class="sheet-header">
    <img src="{{actor.img}}" alt="{{actor.name}}" data-edit="img">
    <div class="identity-fields">
      <label class="identity-name">
        <span>{{localize "MYTHRASF.Identity.CharacterName"}}</span>
        <input type="text" name="name" value="{{actor.name}}">
      </label>
      <label>
        <span>{{localize "MYTHRASF.Identity.PlayerName"}}</span>
        <input type="text" name="system.identity.playerName"
          value="{{actor.system.identity.playerName}}">
      </label>
      <label>
        <span>{{localize "MYTHRASF.Identity.Culture"}}</span>
        <input type="text" name="system.identity.culture.name"
          value="{{actor.system.identity.culture.name}}">
      </label>
      <label>
        <span>{{localize "MYTHRASF.Identity.Profession"}}</span>
        <input type="text" name="system.identity.profession.name"
          value="{{actor.system.identity.profession.name}}">
      </label>
    </div>
  </header>

  {{#unless actor.system.characteristicsGenerated}}
    <section class="generation-panel">
      <h2>{{localize "MYTHRASF.Character.GenerationTitle"}}</h2>
      <p>{{localize "MYTHRASF.Character.GenerationHelp"}}</p>
      {{> "systems/mythras-foundry/templates/actor/parts/characteristics.hbs"}}
      {{#if editable}}
        <button type="button" data-action="generate-characteristics">
          {{localize "MYTHRASF.Character.Generate"}}
        </button>
        <button type="button" data-action="confirm-characteristics">
          {{localize "MYTHRASF.Character.Confirm"}}
        </button>
      {{/if}}
    </section>
  {{else}}
    <nav class="sheet-tabs" aria-label="{{localize "MYTHRASF.Navigation"}}">
      <button type="button" class="active" data-tab="character">
        {{localize "MYTHRASF.Tab.Character"}}
      </button>
      <button type="button" data-tab="skills">
        {{localize "MYTHRASF.Tab.Skills"}}
      </button>
      <button type="button" data-tab="inventory">
        {{localize "MYTHRASF.Tab.Inventory"}}
      </button>
    </nav>

    <main class="sheet-body">
      <section class="tab-panel active" data-tab-content="character">
        <div class="section-heading">
          <span></span>
          {{#if editable}}
            <button type="button" data-action="edit-characteristics">
              {{localize "MYTHRASF.Character.Edit"}}
            </button>
          {{/if}}
        </div>

        <section class="paper-stat-block">
          <fieldset class="paper-characteristics">
            <legend>{{localize "MYTHRASF.Characteristics"}}</legend>
            {{> "systems/mythras-foundry/templates/actor/parts/characteristics.hbs"}}
          </fieldset>

          <fieldset class="paper-attributes">
            <legend>{{localize "MYTHRASF.Attributes"}}</legend>
            <div class="paper-attribute-list">
              <label><span>{{localize "MYTHRASF.Attribute.ActionPoints"}}</span>
                <output>{{actor.system.attributes.actionPointsMax}}</output></label>
              <label><span>{{localize "MYTHRASF.Attribute.DamageModifier"}}</span>
                <output>{{actor.system.attributes.damageModifier.label}}</output></label>
              <label><span>{{localize "MYTHRASF.Attribute.ExperienceModifier"}}</span>
                <output>{{actor.system.attributes.experienceModifier}}</output></label>
              <label><span>{{localize "MYTHRASF.Attribute.HealingRate"}}</span>
                <output>{{actor.system.attributes.healingRate}}</output></label>
              <label><span>{{localize "MYTHRASF.Attribute.Initiative"}}</span>
                <output>{{actor.system.attributes.initiative}}</output></label>
              <label><span>{{localize "MYTHRASF.Attribute.LuckPoints"}}</span>
                <output>{{actor.system.attributes.luckPointsMax}}</output></label>
              <label><span>{{localize "MYTHRASF.Attribute.MovementRate"}}</span>
                <output>{{actor.system.attributes.movementRate}}</output></label>
            </div>
          </fieldset>
        </section>

        <section class="paper-skill-grid">
          {{#each skillGroups as |group|}}
            <fieldset class="paper-skill-group" data-skill-group="{{group.key}}">
              <legend>{{localize group.label}}</legend>
              <div class="paper-skill-header" aria-hidden="true">
                <span>{{localize "MYTHRASF.Skill.Name"}}</span>
                <span>{{localize "MYTHRASF.Skill.Base"}}</span>
                <span>{{localize "MYTHRASF.Skill.TrainedShort"}}</span>
                <span>{{localize "MYTHRASF.Skill.Total"}}</span>
              </div>
              {{#each group.skills as |item|}}
                <div class="paper-skill-row" data-item-id="{{item.id}}">
                  <button type="button" data-action="edit-item">{{item.name}}</button>
                  <output>{{item.system.base}}</output>
                  <input type="checkbox" {{checked item.system.trained}}
                    data-skill-field="trained"
                    aria-label="{{localize "MYTHRASF.Skill.Trained"}}">
                  <output>{{item.system.total}}%</output>
                </div>
              {{else}}
                <p class="empty">{{localize "MYTHRASF.Empty.Skills"}}</p>
              {{/each}}
            </fieldset>
          {{/each}}

          <fieldset class="paper-magic-points">
            <legend>{{localize "MYTHRASF.Attribute.MagicPoints"}}</legend>
            <div class="magic-point-scale" aria-label="{{localize "MYTHRASF.MagicPoints.Scale"}}">
              {{#each magicPointScale as |point|}}
                <span class="{{#if point.available}}available{{/if}} {{#if point.current}}current{{/if}}">
                  {{point.value}}
                </span>
              {{/each}}
            </div>
            <label class="magic-points-current">
              <span>{{localize "MYTHRASF.MagicPoints.Current"}}</span>
              <input type="number" min="0" max="{{actor.system.attributes.magicPointsMax}}"
                name="system.resources.magicPoints.value"
                value="{{actor.system.resources.magicPoints.value}}">
              <output>/ {{actor.system.attributes.magicPointsMax}}</output>
            </label>
          </fieldset>

          <fieldset class="paper-passions">
            <legend>{{localize "MYTHRASF.Passions"}}</legend>
            {{#if editable}}
              <button type="button" class="passion-add"
                data-action="create-item" data-type="passion">
                {{localize "MYTHRASF.Add"}}
              </button>
            {{/if}}
            <div class="paper-passion-header" aria-hidden="true">
              <span>{{localize "MYTHRASF.Passion.Name"}}</span>
              <span>%</span>
              <span></span>
            </div>
            {{#each passions as |item|}}
              <div class="paper-passion-row" data-item-id="{{item.id}}">
                <button type="button" data-action="edit-item">{{item.name}}</button>
                <input type="number" min="0" value="{{item.system.value}}"
                  data-passion-field="value"
                  aria-label="{{localize "MYTHRASF.Passion.Value"}}">
                {{#if ../editable}}
                  <button type="button" data-action="delete-item"
                    aria-label="{{localize "MYTHRASF.Delete"}}">×</button>
                {{/if}}
              </div>
            {{else}}
              <p class="empty">{{localize "MYTHRASF.Empty.Passions"}}</p>
            {{/each}}
          </fieldset>
        </section>

        <details class="paper-resources">
          <summary>{{localize "MYTHRASF.Resources"}}</summary>
          <section class="resource-grid">
            <label>{{localize "MYTHRASF.Attribute.ActionPoints"}}</label>
            <input type="number" min="0" max="{{actor.system.attributes.actionPointsMax}}"
              name="system.resources.actionPoints.value"
              value="{{actor.system.resources.actionPoints.value}}">
            <label>{{localize "MYTHRASF.Attribute.LuckPoints"}}</label>
            <input type="number" min="0" max="{{actor.system.attributes.luckPointsMax}}"
              name="system.resources.luckPoints.value"
              value="{{actor.system.resources.luckPoints.value}}">
            <label>{{localize "MYTHRASF.Attribute.MagicPoints"}}</label>
            <input type="number" min="0" max="{{actor.system.attributes.magicPointsMax}}"
              name="system.resources.magicPoints.value"
              value="{{actor.system.resources.magicPoints.value}}">
          </section>
        </details>
      </section>

      <section class="tab-panel" data-tab-content="skills">
        <div class="section-heading">
          <h2>{{localize "MYTHRASF.Tab.Skills"}}</h2>
          {{#if editable}}
            <button type="button" data-action="create-item" data-type="skill">
              {{localize "MYTHRASF.Add"}}
            </button>
          {{/if}}
        </div>

        {{#each skillGroups as |group|}}
        <section class="skill-group" data-skill-group="{{group.key}}">
          <h3>{{localize group.label}}</h3>
        <div class="skill-list-header" aria-hidden="true">
          <span>{{localize "MYTHRASF.Skill.Name"}}</span>
          <span>{{localize "MYTHRASF.Skill.Base"}}</span>
          <span>{{localize "MYTHRASF.Skill.BonusSum"}}</span>
          <span>{{localize "MYTHRASF.Skill.TrainedShort"}}</span>
          <span>{{localize "MYTHRASF.Skill.FumbledShort"}}</span>
          <span>{{localize "MYTHRASF.Skill.Total"}}</span>
          <span></span>
        </div>
        <ol class="item-list skill-list">
          {{#each group.skills as |item|}}
            <li data-item-id="{{item.id}}">
              <button type="button" class="item-name" data-action="edit-item">{{item.name}}</button>
              <output class="skill-base">{{item.system.base}}</output>
              <output class="skill-bonus">{{item.system.allocatedBonus}}</output>
              <input type="checkbox" {{checked item.system.trained}}
                data-skill-field="trained"
                aria-label="{{localize "MYTHRASF.Skill.Trained"}}">
              <input type="checkbox" {{checked item.system.fumbled}}
                data-skill-field="fumbled"
                aria-label="{{localize "MYTHRASF.Skill.Fumbled"}}">
              <strong class="skill-total" title="{{item.system.base}} + {{item.system.allocatedBonus}}">
                {{item.system.total}}%
              </strong>
              <div class="skill-actions">
                <select data-difficulty aria-label="{{localize "MYTHRASF.Skill.Difficulty"}}">
                  <option value="automatic">{{localize "MYTHRASF.Difficulty.automatic"}}</option>
                  <option value="veryEasy">{{localize "MYTHRASF.Difficulty.veryEasy"}}</option>
                  <option value="easy">{{localize "MYTHRASF.Difficulty.easy"}}</option>
                  <option value="standard" selected>{{localize "MYTHRASF.Difficulty.standard"}}</option>
                  <option value="hard">{{localize "MYTHRASF.Difficulty.hard"}}</option>
                  <option value="formidable">{{localize "MYTHRASF.Difficulty.formidable"}}</option>
                  <option value="herculean">{{localize "MYTHRASF.Difficulty.herculean"}}</option>
                  <option value="impossible">{{localize "MYTHRASF.Difficulty.impossible"}}</option>
                </select>
                <button type="button" data-action="roll-skill">{{localize "MYTHRASF.Roll"}}</button>
                {{#if ../../editable}}
                  <button type="button" data-action="delete-item" aria-label="{{localize "MYTHRASF.Delete"}}">×</button>
                {{/if}}
              </div>
            </li>
          {{else}}
            <li class="empty">{{localize "MYTHRASF.Empty.Skills"}}</li>
          {{/each}}
        </ol>
        </section>
        {{/each}}
      </section>

      <section class="tab-panel" data-tab-content="inventory">
        <div class="section-heading">
          <h2>{{localize "MYTHRASF.Equipment"}}</h2>
          {{#if editable}}
            <button type="button" data-action="create-item" data-type="equipment">
              {{localize "MYTHRASF.Add"}}
            </button>
          {{/if}}
        </div>
        {{> "systems/mythras-foundry/templates/actor/parts/inventory-list.hbs"
          items=equipment emptyKey="MYTHRASF.Empty.Equipment"}}

        <div class="section-heading">
          <h2>{{localize "MYTHRASF.Weapons"}}</h2>
          {{#if editable}}
            <button type="button" data-action="create-item" data-type="weapon">
              {{localize "MYTHRASF.Add"}}
            </button>
          {{/if}}
        </div>
        {{> "systems/mythras-foundry/templates/actor/parts/inventory-list.hbs"
          items=weapons emptyKey="MYTHRASF.Empty.Weapons"}}
      </section>
    </main>
  {{/unless}}
</div>
