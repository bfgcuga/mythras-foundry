<section class="characteristics">

  <div class="characteristic">
    <label for="strength">FUE</label>
    <input
      id="strength"
      type="number"
      name="system.strength"
      value="{{actor.system.strength}}"
    >
  </div>

  <div class="characteristic">
    <label for="constitution">CON</label>
    <input
      id="constitution"
      type="number"
      name="system.constitution"
      value="{{actor.system.constitution}}"
    >
  </div>

  <div class="characteristic">
    <label for="size">TAM</label>
    <input
      id="size"
      type="number"
      name="system.size"
      value="{{actor.system.size}}"
    >
  </div>

  <div class="characteristic">
    <label for="dexterity">DES</label>
    <input
      id="dexterity"
      type="number"
      name="system.dexterity"
      value="{{actor.system.dexterity}}"
    >
  </div>

  <div class="characteristic">
    <label for="intelligence">INT</label>
    <input
      id="intelligence"
      type="number"
      name="system.intelligence"
      value="{{actor.system.intelligence}}"
    >
  </div>

  <div class="characteristic">
    <label for="power">POD</label>
    <input
      id="power"
      type="number"
      name="system.power"
      value="{{actor.system.power}}"
    >
  </div>

  <div class="characteristic">
    <label for="charisma">CAR</label>
    <input
      id="charisma"
      type="number"
      name="system.charisma"
      value="{{actor.system.charisma}}"
    >
  </div>

</section>

<section class="derived-attributes">

  <div class="derived-attribute">
    <label>Iniciativa</label>

    <input
      type="number"
      value="{{actor.system.attributes.initiative}}"
      readonly
    >
  </div>

</section>