<section class="characteristics-grid">
  {{#each characteristicRows as |characteristic|}}
    <div class="characteristic-row">
      <label>{{characteristic.label}}</label>
      <div class="characteristic-controls">
        {{#if ../showCharacteristicAdjustments}}
          <button type="button" data-action="adjust-characteristic"
            data-characteristic="{{characteristic.key}}" data-delta="-1"
            aria-label="{{localize "MYTHRASF.Character.Decrease"}}">−</button>
          <button type="button" data-action="adjust-characteristic"
            data-characteristic="{{characteristic.key}}" data-delta="1"
            aria-label="{{localize "MYTHRASF.Character.Increase"}}">+</button>
        {{/if}}
        {{#if ../showCharacteristicSwaps}}
          <select data-swap-characteristic="{{characteristic.key}}"
            aria-label="{{localize "MYTHRASF.Character.Swap"}}">
            <option value="">{{localize "MYTHRASF.Character.Swap"}}</option>
            {{#each characteristic.swapChoices as |choice|}}
              <option value="{{choice.key}}">{{choice.label}}</option>
            {{/each}}
          </select>
        {{/if}}
        {{#if ../isFreeAllocation}}
          <input type="number" class="sheet-field-editable characteristic-free-input"
            name="system.{{characteristic.key}}" value="{{characteristic.value}}"
            min="{{characteristic.minimum}}" step="1"
            aria-label="{{characteristic.label}}">
        {{else}}
          <output>{{characteristic.value}}</output>
        {{/if}}
      </div>
    </div>
  {{/each}}
</section>
