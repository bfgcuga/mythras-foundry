  <header class="sheet-header npc-sheet-header">
    <div class="portrait-frame">
      <button type="button" class="portrait-view" data-action="view-portrait"
        aria-label="{{localize "MYTHRASF.Identity.ViewPortrait"}}" title="{{localize "MYTHRASF.Identity.ViewPortrait"}}">
        <img src="{{actor.img}}" alt="{{actor.name}}">
      </button>
      
    </div>
    <div class="identity-fields npc-identity-fields">
      <label><span>{{localize "MYTHRASF.Identity.CharacterName"}}</span>
        <output class="sheet-field-readonly">{{actor.name}}</output></label>
      <label><span>{{localize "MYTHRASF.Npc.Species"}}</span>
        <output class="sheet-field-readonly">{{actor.system.identity.species}}</output></label>
      <label><span>{{localize "MYTHRASF.Npc.IntelligenceType"}}</span>
        <output class="sheet-field-readonly">{{#if isInstinct}}{{localize "MYTHRASF.Npc.Instinct"}}{{else}}{{localize "MYTHRASF.Npc.Intelligence"}}{{/if}}</output></label>
    </div>
    <section class="header-status npc-header-status" aria-label="{{localize "MYTHRASF.Header.Status"}}">
      <label class="npc-header-resource"><span>{{localize "MYTHRASF.Attribute.ActionPoints"}}</span><div class="npc-header-resource-control"><output class="sheet-field-readonly penalized-value">{{headerStatus.actionPoints.base}}{{#if headerStatus.actionPoints.penalized}} <span class="penalized-value-modifier">({{headerStatus.actionPoints.effective}})</span>{{/if}}</output></div></label>
{{#if visibility.resources}}      <label class="npc-header-resource"><span>{{localize "MYTHRASF.Attribute.LuckPoints"}}</span><div class="npc-header-resource-control"><output class="sheet-field-readonly">{{headerStatus.luckPoints}}</output></div></label>{{/if}}
      <label><span>{{localize "MYTHRASF.HitLocation.Wound"}}</span><output class="sheet-field-readonly wound-{{headerStatus.woundKey}}">{{headerStatus.wound}}</output></label>
      <label><span>{{localize "MYTHRASF.Fatigue.Label"}}</span><output class="sheet-field-readonly fatigue-{{headerStatus.fatigueKey}}">{{headerStatus.fatigue}}</output></label>
      <label title="{{headerStatus.encumbranceTitle}}"><span>{{localize "MYTHRASF.Header.Encumbrance"}}</span><output class="sheet-field-readonly">{{headerStatus.encumbrance}}</output></label>
{{#if visibility.resources}}      <label class="npc-header-resource"><span>{{localize "MYTHRASF.Attribute.MagicPoints"}}</span><div class="npc-header-resource-control"><output class="sheet-field-readonly">{{headerStatus.magicPoints}}</output></div></label>{{/if}}
    </section>
  </header>
