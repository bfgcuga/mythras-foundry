<fieldset class="background-wizard">
  <legend>{{localize "MYTHRASF.Background.Title"}}</legend>

  <ol class="background-steps" aria-label="{{localize "MYTHRASF.Background.Progress"}}">
    <li class="{{#if wizard.isCulture}}active{{/if}}">1. {{localize "MYTHRASF.Background.Culture"}}</li>
    <li class="{{#if wizard.isSocialClass}}active{{/if}}">2. {{localize "MYTHRASF.Background.SocialClass"}}</li>
    <li class="{{#if wizard.isProfession}}active{{/if}}">3. {{localize "MYTHRASF.Background.Profession"}}</li>
    <li class="{{#if wizard.isAge}}active{{/if}}">4. {{localize "MYTHRASF.Background.Age"}}</li>
    <li class="{{#if wizard.isFree}}active{{/if}}">5. {{localize "MYTHRASF.Background.FreePoints"}}</li>
    <li class="{{#if wizard.isReview}}active{{/if}}">6. {{localize "MYTHRASF.Background.Review"}}</li>
  </ol>

  {{#if wizard.isCulture}}
    <label class="background-main-select">
      <span>{{localize "MYTHRASF.Background.ChooseCulture"}}</span>
      <select data-background-select="culture">
        <option value="">{{localize "MYTHRASF.Background.Select"}}</option>
        {{#each wizard.cultures as |entry|}}
          <option value="{{entry.key}}" {{#if entry.selected}}selected{{/if}}>{{entry.name}}</option>
        {{/each}}
      </select>
    </label>
  {{/if}}

  {{#if wizard.isSocialClass}}
    <div class="background-social-class">
      {{#if wizard.socialClassRandom}}
        <p>{{localize "MYTHRASF.SocialClass.RandomHelp"}}</p>
        <p><b>{{localize "MYTHRASF.SocialClass.Roll"}}:</b> {{wizard.socialClassRoll}}</p>
      {{else}}
        <label class="background-main-select">
          <span>{{localize "MYTHRASF.SocialClass.Choose"}}</span>
          <select class="sheet-field-editable" data-background-social-class>
            <option value="">{{localize "MYTHRASF.Background.Select"}}</option>
            {{#each wizard.socialClasses as |entry|}}
              <option value="{{entry.key}}" {{#if entry.selected}}selected{{/if}}>
                {{entry.name}} (×{{entry.moneyModifier}})
              </option>
            {{/each}}
          </select>
        </label>
      {{/if}}
      {{#if wizard.selectedSocialClass}}
        <section class="background-social-class-summary">
          <h4>{{wizard.selectedSocialClass.name}}</h4>
          <p><b>{{localize "MYTHRASF.SocialClass.Titles"}}:</b> {{wizard.selectedSocialClass.titles}}</p>
          <p><b>{{localize "MYTHRASF.SocialClass.Resources"}}:</b> {{wizard.selectedSocialClass.resources}}</p>
          <p><b>{{localize "MYTHRASF.SocialClass.StartingMoney"}}:</b>
            {{wizard.startingMoney}} {{localize "MYTHRASF.Currency.SilverPieces"}}
            ({{wizard.startingMoneyFormula}} ×{{wizard.selectedSocialClass.moneyModifier}})</p>
        </section>
        <button type="button" class="sheet-icon-button background-social-class-roll"
          data-action="roll-social-class"
          title="{{localize "MYTHRASF.SocialClass.Reroll"}}"
          aria-label="{{localize "MYTHRASF.SocialClass.Reroll"}}">
          <i class="fas fa-dice" aria-hidden="true"></i>
        </button>
      {{/if}}
    </div>
  {{/if}}

  {{#if wizard.isAge}}
    <div class="background-age-fields">
      <label>
        <span>{{localize "MYTHRASF.Age.CategoryLabel"}}</span>
        <select class="sheet-field-editable" data-background-age-field="category">
          <option value="">{{localize "MYTHRASF.Background.Select"}}</option>
          {{#each wizard.ageCategories as |entry|}}
            <option value="{{entry.key}}" {{#if entry.selected}}selected{{/if}}>
              {{entry.name}} · {{entry.ageFormula}} · {{entry.freePoints}} / +{{entry.maximum}}
            </option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize "MYTHRASF.Age.Value"}}</span>
        <input type="number" min="1" step="1" class="sheet-field-editable"
          value="{{wizard.age}}" data-background-age-field="age">
      </label>
      {{#if wizard.selectedAgeCategory}}
        <p>{{localize "MYTHRASF.Age.Summary"
          points=wizard.selectedAgeCategory.freePoints
          maximum=wizard.selectedAgeCategory.maximum
          events=wizard.selectedAgeCategory.backgroundEvents}}</p>
      {{/if}}
    </div>
  {{/if}}

  {{#if wizard.isProfession}}
    <label class="background-main-select">
      <span>{{localize "MYTHRASF.Background.ChooseProfession"}}</span>
      <select data-background-select="profession">
        <option value="">{{localize "MYTHRASF.Background.Select"}}</option>
        {{#each wizard.professions as |entry|}}
          <option value="{{entry.key}}" {{#if entry.selected}}selected{{/if}}>{{entry.name}}</option>
        {{/each}}
      </select>
    </label>
  {{/if}}

  {{#if wizard.selected}}
    <div class="background-selection-grid">
      {{#each wizard.selected.choices as |choice|}}
        <section>
          <h4>{{choice.label}} ({{choice.count}})</h4>
          <div class="background-options">
            {{#each choice.options as |option|}}
              <label>
                <input type="checkbox" class="sheet-state-box" {{checked option.checked}}
                  data-background-choice
                  data-phase="{{option.phase}}"
                  data-group="{{option.groupId}}" data-slug="{{option.slug}}">
                {{option.label}}
              </label>
            {{/each}}
          </div>
        </section>
      {{/each}}

      <section class="background-professional-options">
        <h4>
          {{localize "MYTHRASF.Background.ProfessionalChoices"}}
          ({{wizard.selectedProfessionalCount}} / 3)
        </h4>
        <div class="background-options">
          {{#each wizard.selected.professional as |option|}}
            <label>
              <input type="checkbox" class="sheet-state-box" {{checked option.checked}}
                data-background-professional
                data-phase="{{option.phase}}"
                data-option="{{option.id}}">
              {{option.label}}
            </label>
            {{#if option.checked}}
              {{#if option.specializationRequired}}
                <input type="text" value="{{option.specialization}}"
                  list="{{option.specializationListId}}"
                  placeholder="{{localize "MYTHRASF.Background.Specialization"}}"
                  data-background-specialization
                  data-phase="{{option.phase}}"
                  data-option="{{option.id}}">
                {{#if option.existingSpecializations.length}}
                  <datalist id="{{option.specializationListId}}">
                    {{#each option.existingSpecializations as |specialization|}}
                      <option value="{{specialization}}"></option>
                    {{/each}}
                  </datalist>
                {{/if}}
              {{/if}}
            {{/if}}
          {{/each}}
        </div>
      </section>

      {{#each wizard.selected.styles as |style|}}
        <section class="background-style-fields">
          <h4>
            {{style.prompt}}
            {{#if style.canRemove}}
              <button type="button" class="background-style-remove"
                data-background-style-action="remove"
                data-phase="{{style.phase}}" data-style="{{style.id}}"
                aria-label="{{localize "MYTHRASF.Background.RemoveStyle"}}">
                <i class="fas fa-trash" aria-hidden="true"></i>
              </button>
            {{/if}}
          </h4>
          <label>
            <span>{{localize "MYTHRASF.Background.StyleName"}}</span>
            <input type="text" value="{{style.name}}" data-background-style-field="name"
              list="combat-styles-{{style.id}}" data-style="{{style.id}}">
            {{#if style.existingStyleNames.length}}
              <datalist id="combat-styles-{{style.id}}">
                {{#each style.existingStyleNames as |styleName|}}
                  <option value="{{styleName}}"></option>
                {{/each}}
              </datalist>
            {{/if}}
          </label>
          <label>
            <span>{{localize "MYTHRASF.CombatStyle.Weapons"}}</span>
            <input type="text" value="{{style.weapons}}" data-background-style-field="weapons"
              data-style="{{style.id}}">
          </label>
          <label>
            <span>{{localize "MYTHRASF.CombatStyle.Traits"}}</span>
            <input type="text" value="{{style.traits}}" data-background-style-field="traits"
              data-style="{{style.id}}">
          </label>
        </section>
      {{/each}}
      {{#unless wizard.isCulture}}<button type="button" class="background-style-add"
        data-background-style-action="add"
        data-phase="{{wizard.allocationPhase}}">
        <i class="fas fa-plus" aria-hidden="true"></i>
        {{localize "MYTHRASF.Background.AddStyle"}}
      </button>{{/unless}}
    </div>
  {{/if}}

  {{#if wizard.isFree}}
    <div class="background-free-skill">
      <label>
        <span>{{localize "MYTHRASF.Background.ExtraSkill"}}</span>
        <select data-background-free-field="slug">
          <option value="">{{localize "MYTHRASF.Background.Select"}}</option>
          {{#each wizard.freeProfessionalOptions as |entry|}}
            <option value="{{entry.slug}}" {{#if entry.selected}}selected{{/if}}>{{entry.name}}</option>
          {{/each}}
          <option value="__combat-style__" {{#if wizard.freeCombatStyleSelected}}selected{{/if}}>
            {{localize "MYTHRASF.Skill.GroupCombat"}}
          </option>
        </select>
      </label>
      {{#if wizard.freeCombatStyleSelected}}
        <label>
          <span>{{localize "MYTHRASF.Background.StyleName"}}</span>
          <input type="text" value="{{wizard.freeProfessional.name}}"
            list="free-existing-combat-styles" data-background-free-field="name">
          {{#if wizard.freeExistingCombatStyles.length}}
            <datalist id="free-existing-combat-styles">
              {{#each wizard.freeExistingCombatStyles as |styleName|}}
                <option value="{{styleName}}"></option>
              {{/each}}
            </datalist>
          {{/if}}
        </label>
        <label>
          <span>{{localize "MYTHRASF.Background.Weapons"}}</span>
          <input type="text" value="{{wizard.freeProfessional.weapons}}"
            data-background-free-field="weapons">
        </label>
        <label>
          <span>{{localize "MYTHRASF.Background.Traits"}}</span>
          <input type="text" value="{{wizard.freeProfessional.traits}}"
            data-background-free-field="traits">
        </label>
      {{/if}}
      {{#if wizard.freeSpecializationRequired}}
        <label>
          <span>{{localize "MYTHRASF.Background.Specialization"}}</span>
          <input type="text" value="{{wizard.freeProfessional.specialization}}"
            list="{{wizard.freeSpecializationListId}}"
            data-background-free-field="specialization">
          {{#if wizard.freeExistingSpecializations.length}}
            <datalist id="{{wizard.freeSpecializationListId}}">
              {{#each wizard.freeExistingSpecializations as |specialization|}}
                <option value="{{specialization}}"></option>
              {{/each}}
            </datalist>
          {{/if}}
        </label>
      {{/if}}
    </div>
  {{/if}}

  {{#if wizard.isReview}}
    <div class="background-summary">
      <p><b>{{localize "MYTHRASF.Background.Culture"}}:</b> {{wizard.cultureName}}</p>
      <p><b>{{localize "MYTHRASF.Background.SocialClass"}}:</b> {{wizard.socialClassName}}</p>
      <p><b>{{localize "MYTHRASF.Background.Profession"}}:</b> {{wizard.professionName}}</p>
      <p><b>{{localize "MYTHRASF.SocialClass.StartingMoney"}}:</b> {{wizard.startingMoney}} {{localize "MYTHRASF.Currency.SilverPieces"}}</p>
      <p><b>{{localize "MYTHRASF.Background.Age"}}:</b> {{wizard.age}} ({{wizard.ageCategoryName}})</p>
      <p>{{localize "MYTHRASF.Background.ReviewHelp"}}</p>
    </div>
  {{/if}}

  <footer class="background-navigation">
    {{#unless wizard.isCulture}}
      <button type="button" data-background-navigation="back">
        <i class="fas fa-arrow-left" aria-hidden="true"></i>
        {{localize "MYTHRASF.Background.Back"}}
      </button>
    {{/unless}}
    {{#if wizard.isReview}}
      <button type="button" data-action="confirm-background">
        <i class="fas fa-check" aria-hidden="true"></i>
        {{localize "MYTHRASF.Background.Confirm"}}
      </button>
    {{else}}
      <button type="button" data-background-navigation="next">
        {{localize "MYTHRASF.Background.Next"}}
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
      </button>
    {{/if}}
  </footer>
</fieldset>
