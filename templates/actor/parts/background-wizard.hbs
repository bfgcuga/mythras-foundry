<fieldset class="background-wizard">
  <legend>{{localize "MYTHRASF.Background.Title"}}</legend>

  <ol class="background-steps" aria-label="{{localize "MYTHRASF.Background.Progress"}}">
    <li class="{{#if wizard.isCulture}}active{{/if}}">1. {{localize "MYTHRASF.Background.Culture"}}</li>
    <li class="{{#if wizard.isProfession}}active{{/if}}">2. {{localize "MYTHRASF.Background.Profession"}}</li>
    <li class="{{#if wizard.isFree}}active{{/if}}">3. {{localize "MYTHRASF.Background.FreePoints"}}</li>
    <li class="{{#if wizard.isReview}}active{{/if}}">4. {{localize "MYTHRASF.Background.Review"}}</li>
  </ol>

  {{#if wizard.isCulture}}
    <label class="background-main-select">
      <span>{{localize "MYTHRASF.Background.ChooseCulture"}}</span>
      <select data-background-select="culture">
        <option value="">{{localize "MYTHRASF.Background.Select"}}</option>
        {{#each wizard.cultures as |entry|}}
          <option value="{{entry.key}}" {{#if entry.selected}}selected{{/if}}>{{entry.name}}</option>
        {{/each}}
      </select>
    </label>
  {{/if}}

  {{#if wizard.isProfession}}
    <label class="background-main-select">
      <span>{{localize "MYTHRASF.Background.ChooseProfession"}}</span>
      <select data-background-select="profession">
        <option value="">{{localize "MYTHRASF.Background.Select"}}</option>
        {{#each wizard.professions as |entry|}}
          <option value="{{entry.key}}" {{#if entry.selected}}selected{{/if}}>{{entry.name}}</option>
        {{/each}}
      </select>
    </label>
  {{/if}}

  {{#if wizard.selected}}
    <div class="background-selection-grid">
      {{#each wizard.selected.choices as |choice|}}
        <section>
          <h4>{{choice.label}} ({{choice.count}})</h4>
          <div class="background-options">
            {{#each choice.options as |option|}}
              <label>
                <input type="checkbox" {{checked option.checked}}
                  data-background-choice
                  data-phase="{{option.phase}}"
                  data-group="{{option.groupId}}" data-slug="{{option.slug}}">
                {{option.label}}
              </label>
            {{/each}}
          </div>
        </section>
      {{/each}}

      <section class="background-professional-options">
        <h4>
          {{localize "MYTHRASF.Background.ProfessionalChoices"}}
          ({{wizard.selectedProfessionalCount}} / 3)
        </h4>
        <div class="background-options">
          {{#each wizard.selected.professional as |option|}}
            <label>
              <input type="checkbox" {{checked option.checked}}
                data-background-professional
                data-phase="{{option.phase}}"
                data-option="{{option.id}}">
              {{option.label}}
            </label>
            {{#if option.checked}}
              {{#if option.specializationRequired}}
                <input type="text" value="{{option.specialization}}"
                  placeholder="{{localize "MYTHRASF.Background.Specialization"}}"
                  data-background-specialization
                  data-phase="{{option.phase}}"
                  data-option="{{option.id}}">
              {{/if}}
            {{/if}}
          {{/each}}
        </div>
      </section>

      {{#each wizard.selected.styles as |style|}}
        <section class="background-style-fields">
          <h4>
            {{style.prompt}}
            {{#if style.canRemove}}
              <button type="button" class="background-style-remove"
                data-background-style-action="remove"
                data-phase="{{style.phase}}" data-style="{{style.id}}"
                aria-label="{{localize "MYTHRASF.Background.RemoveStyle"}}">
                <i class="fas fa-trash" aria-hidden="true"></i>
              </button>
            {{/if}}
          </h4>
          <label>
            <span>{{localize "MYTHRASF.Background.StyleName"}}</span>
            <input type="text" value="{{style.name}}" data-background-style-field="name"
              data-style="{{style.id}}">
          </label>
          <label>
            <span>{{localize "MYTHRASF.CombatStyle.Weapons"}}</span>
            <input type="text" value="{{style.weapons}}" data-background-style-field="weapons"
              data-style="{{style.id}}">
          </label>
          <label>
            <span>{{localize "MYTHRASF.CombatStyle.Traits"}}</span>
            <input type="text" value="{{style.traits}}" data-background-style-field="traits"
              data-style="{{style.id}}">
          </label>
        </section>
      {{/each}}
      <button type="button" class="background-style-add"
        data-background-style-action="add"
        data-phase="{{wizard.allocationPhase}}">
        <i class="fas fa-plus" aria-hidden="true"></i>
        {{localize "MYTHRASF.Background.AddStyle"}}
      </button>
    </div>
  {{/if}}

  {{#if wizard.isFree}}
    <div class="background-free-skill">
      <label>
        <span>{{localize "MYTHRASF.Background.ExtraProfessional"}}</span>
        <select data-background-free-field="slug">
          <option value="">{{localize "MYTHRASF.Background.Select"}}</option>
          {{#each wizard.freeProfessionalOptions as |entry|}}
            <option value="{{entry.slug}}" {{#if entry.selected}}selected{{/if}}>{{entry.name}}</option>
          {{/each}}
        </select>
      </label>
      {{#if wizard.freeSpecializationRequired}}
        <label>
          <span>{{localize "MYTHRASF.Background.Specialization"}}</span>
          <input type="text" value="{{wizard.freeProfessional.specialization}}"
            data-background-free-field="specialization">
        </label>
      {{/if}}
    </div>
  {{/if}}

  {{#if wizard.allocationPhase}}
    <p class="background-points-counter">
      {{localize "MYTHRASF.Background.PointsRemaining"
        points=wizard.allocationRemaining total=wizard.allocationBudget}}
    </p>
  {{/if}}

  {{#if wizard.isReview}}
    <div class="background-summary">
      <p><b>{{localize "MYTHRASF.Background.Culture"}}:</b> {{wizard.cultureName}}</p>
      <p><b>{{localize "MYTHRASF.Background.Profession"}}:</b> {{wizard.professionName}}</p>
      <p>{{localize "MYTHRASF.Background.ReviewHelp"}}</p>
    </div>
  {{/if}}

  <footer class="background-navigation">
    {{#unless wizard.isCulture}}
      <button type="button" data-background-navigation="back">
        <i class="fas fa-arrow-left" aria-hidden="true"></i>
        {{localize "MYTHRASF.Background.Back"}}
      </button>
    {{/unless}}
    {{#if wizard.isReview}}
      <button type="button" data-action="confirm-background">
        <i class="fas fa-check" aria-hidden="true"></i>
        {{localize "MYTHRASF.Background.Confirm"}}
      </button>
    {{else}}
      <button type="button" data-background-navigation="next">
        {{localize "MYTHRASF.Background.Next"}}
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
      </button>
    {{/if}}
  </footer>
</fieldset>
