<div class="inventory-table {{#if weaponTable}}inventory-weapons{{/if}} {{#if armorTable}}inventory-armor{{/if}}">
  <div class="inventory-table-head">
    {{#if equipmentTable}}<span>{{localize "MYTHRASF.Combat.Object"}}</span>{{/if}}
    {{#if armorTable}}<span>{{localize "TYPES.Item.armor"}}</span>{{/if}}
    {{#if weaponTable}}<span>{{localize "TYPES.Item.weapon"}}</span>{{/if}}
    {{#if equipmentTable}}<span>{{localize "MYTHRASF.Item.Quantity"}}</span><span>{{localize "MYTHRASF.Item.Weight"}}</span><span>{{localize "MYTHRASF.Item.Location"}}</span>{{/if}}
    {{#if weaponTable}}<span>{{localize "MYTHRASF.Weapon.PreparedMode"}}</span><span>{{localize "MYTHRASF.Weapon.APHP"}}</span><span>{{localize "MYTHRASF.Item.Equipped"}}</span>{{/if}}
    {{#if armorTable}}<span>{{localize "MYTHRASF.Armor.Points"}}</span><span>{{localize "MYTHRASF.Armor.Coverage"}}</span><span>{{localize "MYTHRASF.Armor.TotalEncumbrance"}}</span><span>{{localize "MYTHRASF.Armor.TotalValue"}}</span><span>{{localize "MYTHRASF.Armor.PenaltyShort"}}</span><span>{{localize "MYTHRASF.Item.Equipped"}}</span>{{/if}}
    <span></span>
  </div>
  <ol class="item-list">
    {{#each items as |entry|}}
      {{#if ../weaponTable}}
        <li data-item-id="{{entry.item.id}}" class="weapon-durability-{{entry.durabilityState}}">
          <button type="button" class="item-name" data-action="edit-item">{{entry.item.name}}</button>
          {{#if entry.hasMultipleModes}}<select data-active-weapon-mode aria-label="{{localize "MYTHRASF.Weapon.PreparedMode"}}">{{selectOptions entry.modeOptions selected=entry.activeModeKey labelAttr="displayName" valueAttr="key"}}</select>{{else}}<span>—</span>{{/if}}
          <span>{{entry.item.system.armorPoints}} / {{entry.item.system.currentHitPoints}}–{{entry.item.system.maxHitPoints}}</span>
          <button type="button" data-action="toggle-equipped" data-hands="{{entry.handsRequired}}" class="sheet-icon-button equip-toggle equipment-state-toggle hand-toggle {{#if entry.item.system.equipped}}equipped{{/if}}" aria-pressed="{{entry.item.system.equipped}}" aria-label="{{#if entry.broken}}{{localize "MYTHRASF.Weapon.BrokenCannotEquip"}}{{else}}{{localize "MYTHRASF.Weapon.ToggleHands"}}{{/if}}" title="{{#if entry.broken}}{{localize "MYTHRASF.Weapon.BrokenCannotEquip"}}{{else}}{{localize "MYTHRASF.Weapon.ToggleHands"}}{{/if}}" {{#if entry.broken}}disabled{{/if}}><i class="fas {{#if entry.broken}}fa-hand-slash{{else}}fa-hand{{/if}}" aria-hidden="true"></i>{{#unless entry.broken}}<i class="fas fa-hand" aria-hidden="true"></i>{{/unless}}</button>
          {{#if @root.editable}}<button type="button" class="sheet-icon-button inventory-delete" data-action="delete-item" aria-label="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{/if}}
        </li>
      {{else}}
        <li data-item-id="{{#if ../armorTable}}{{entry.item.id}}{{else}}{{entry.id}}{{/if}}" {{#if entry.hidden}}hidden{{/if}} class="{{#if entry.isContainer}}inventory-container-row{{/if}}">
          {{#if ../equipmentTable}}{{#if entry.isContainer}}<button type="button" class="sheet-icon-button inventory-container-toggle" data-action="toggle-container" aria-expanded="{{#unless entry.system.collapsed}}true{{else}}false{{/unless}}" title="{{localize "MYTHRASF.Item.Container.Toggle"}}"><i class="fas {{#if entry.system.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i></button>{{/if}}{{/if}}
          <button type="button" class="item-name {{#if ../armorTable}}armor-piece-name{{/if}}" data-action="edit-item" {{#if ../equipmentTable}}style="padding-left: {{entry.indent}}px"{{/if}}>{{#if ../armorTable}}<span>{{entry.item.name}}</span>{{#if entry.showProfile}}<small>{{entry.profileLabel}}</small>{{/if}}{{else}}{{entry.name}}{{/if}}</button>
          {{#if ../equipmentTable}}<span>{{entry.system.quantity}}</span><span>{{entry.system.weight}}</span><span>{{#if entry.carried}}{{localize "MYTHRASF.Item.Carried"}}{{else}}{{localize "MYTHRASF.Item.Stored"}}{{/if}}</span>{{/if}}
          {{#if ../armorTable}}<span>{{entry.item.system.armorPoints}}</span><span>{{entry.coverageLabel}}</span><span>{{entry.encumbrance}}</span><span>{{entry.value}}</span><span>-{{entry.initiativePenalty}}</span><button type="button" data-action="toggle-equipped" class="sheet-icon-button equip-toggle equipment-state-toggle armor-toggle {{#if entry.item.system.equipped}}equipped{{/if}}" aria-pressed="{{entry.item.system.equipped}}" title="{{localize "MYTHRASF.Armor.ToggleEquipped"}}"><i class="fas fa-vest" aria-hidden="true"></i></button>{{/if}}
          {{#if @root.editable}}<button type="button" class="sheet-icon-button inventory-delete" data-action="delete-item" aria-label="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{/if}}
        </li>
      {{/if}}
    {{else}}<li class="empty">{{localize emptyKey}}</li>{{/each}}
  </ol>
</div>
