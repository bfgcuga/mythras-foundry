<fieldset class="combat-paper-panel combat-paper-locations {{#if npcLayout}}npc-locations-panel{{/if}}">
  <legend>{{localize "MYTHRASF.HitLocations"}}</legend>
  {{#if canManageMorphology}}<div class="combat-location-editor">
    <label class="combat-morphology-control"><span>{{localize "MYTHRASF.Morphology.Label"}}</span><select name="system.morphologyKey" aria-label="{{localize 'MYTHRASF.Morphology.Label'}}">{{selectOptions morphologyChoices selected=morphologyKey labelAttr="label" valueAttr="value"}}</select></label>
    <button type="button" class="sheet-icon-button combat-location-editor-button" data-action="apply-morphology" {{#unless canApplyMorphology}}disabled{{/unless}}
      aria-label="{{localize 'MYTHRASF.Morphology.Apply'}}" title="{{localize 'MYTHRASF.Morphology.Apply'}}"><i class="fas fa-rotate-left" aria-hidden="true"></i><span>{{localize "MYTHRASF.Morphology.Apply"}}</span></button>
    <button type="button" class="sheet-icon-button combat-location-editor-button" data-action="create-item"
      data-type="hitLocation" aria-label="{{localize 'MYTHRASF.HitLocation.Add'}}" title="{{localize 'MYTHRASF.HitLocation.Add'}}"><i class="fas fa-plus" aria-hidden="true"></i><span>{{localize "MYTHRASF.HitLocation.Add"}}</span></button>
  </div>{{/if}}
  <div class="combat-location-head {{#unless table.hasNaturalArmor}}without-natural-armor{{/unless}}" aria-hidden="true">
    <span>d20</span><span>{{localize "MYTHRASF.HitLocation.Location"}}</span>
    <span>{{localize "MYTHRASF.HitLocation.Disabled"}}</span><span>{{localize "MYTHRASF.HitLocation.Crippled"}}</span>
    <span>{{localize "MYTHRASF.HitLocation.MaxShort"}}</span><span>{{localize "MYTHRASF.HitLocation.CurrentShort"}}</span>
    {{#if table.hasNaturalArmor}}<span>{{localize "MYTHRASF.Armor.Natural"}}</span>{{/if}}
    <span>{{localize "MYTHRASF.Armor.Piece.Label"}}</span><span>{{localize "MYTHRASF.HitLocation.Armor"}}</span>
    <span>{{localize "MYTHRASF.Status.PassiveBlock"}}</span><span></span>
  </div>
  {{#each table.rows as |row|}}
    <div class="combat-location-line {{#unless ../table.hasNaturalArmor}}without-natural-armor{{/unless}}" data-item-id="{{row.item.id}}">
      <span>{{row.item.system.rangeStart}}–{{row.item.system.rangeEnd}}</span>
      <div class="combat-location-name"><button type="button" data-action="edit-item">{{row.displayName}}</button></div>
      <label class="location-state-cell"><input type="checkbox" class="sheet-state-box" data-location-disabled {{checked row.disabled}} {{#unless row.showDisabledControl}}disabled{{/unless}} aria-label="{{localize "MYTHRASF.HitLocation.Disabled"}}"></label>
      <span class="location-state-cell"><input type="checkbox" class="sheet-state-box" {{checked row.crippled}} disabled aria-label="{{localize "MYTHRASF.HitLocation.Crippled"}}"></span>
      {{#if ../templateMode}}<input class="sheet-field-editable location-max" type="number" min="1" data-item-field="maxHitPoints" value="{{row.item.system.maxHitPoints}}">{{else}}<output class="location-max sheet-field-readonly penalized-value">{{row.maximumDisplay.base}}{{#if row.maximumDisplay.penalized}} <span class="penalized-value-modifier">({{row.maximumDisplay.effective}})</span>{{/if}}</output>{{/if}}
      <div class="location-current-control">{{#if ../templateMode}}<input class="sheet-field-editable location-current wound-{{row.item.system.woundLevel}} {{#if row.overMaximum}}location-current--over-maximum{{/if}}" type="number" data-item-field="currentHitPoints" value="{{row.item.system.currentHitPoints}}">{{else}}<output class="location-current sheet-field-readonly wound-{{row.item.system.woundLevel}} {{#if row.overMaximum}}location-current--over-maximum{{/if}}" {{#if row.overMaximum}}title="{{localize 'MYTHRASF.HitLocation.OverMaximum'}}"{{/if}}>{{row.item.system.currentHitPoints}}</output>{{/if}}{{#if @root.editable}}<span class="location-hp-buttons"><button type="button" class="sheet-icon-button" data-location-hp-delta="1" title="{{localize 'MYTHRASF.HitLocation.IncreaseHp'}}" aria-label="{{localize 'MYTHRASF.HitLocation.IncreaseHp'}}"><i class="fas fa-chevron-up" aria-hidden="true"></i></button><button type="button" class="sheet-icon-button" data-location-hp-delta="-1" title="{{localize 'MYTHRASF.HitLocation.DecreaseHp'}}" aria-label="{{localize 'MYTHRASF.HitLocation.DecreaseHp'}}"><i class="fas fa-chevron-down" aria-hidden="true"></i></button></span>{{/if}}</div>
      {{#if ../table.hasNaturalArmor}}<span class="natural-armor-cell armor-durability-{{row.naturalArmorState}}">{{#if ../templateMode}}<input class="sheet-field-editable location-armor npc-natural-armor" type="number" min="0" data-item-field="armorPoints" value="{{row.naturalArmor}}">{{else if row.naturalArmor}}<output class="location-armor sheet-field-readonly" title="{{localize 'MYTHRASF.Armor.Natural'}}">{{row.naturalArmor}} / {{row.naturalArmorMaximum}}</output>{{/if}}</span>{{/if}}
      <select data-location-armor aria-label="{{localize "MYTHRASF.Armor.Piece.SelectForLocation"}}" {{#unless @root.editable}}disabled{{/unless}}><option value="">{{localize "MYTHRASF.Armor.Piece.None"}}</option>{{selectOptions row.armorOptions selected=row.equippedArmorId labelAttr="label" valueAttr="value"}}</select>
      <output class="location-armor sheet-field-readonly" title="{{localize "MYTHRASF.Armor.Natural"}}: {{row.naturalArmor}} + {{localize "MYTHRASF.Combat.WornArmor"}}: {{row.wornArmor}}">{{row.totalArmor}}</output>
      <span class="location-state-cell"><input type="checkbox" class="sheet-state-box" {{checked row.passiveBlocked}} disabled aria-label="{{localize 'MYTHRASF.Status.PassiveBlock'}}"></span>
      {{#if ../canDelete}}<button type="button" class="sheet-icon-button" data-action="delete-item" aria-label="{{localize "MYTHRASF.Delete"}}" title="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{else}}<span></span>{{/if}}
    </div>
  {{else}}<p class="empty">{{localize "MYTHRASF.Empty.HitLocations"}}</p>{{/each}}
  <div class="combat-wound-legend"><span>{{localize "MYTHRASF.HitLocation.Wound"}}:</span><span class="wound-minor">{{localize "MYTHRASF.Wound.minor"}}</span><span class="wound-serious">{{localize "MYTHRASF.Wound.serious"}}</span><span class="wound-major">{{localize "MYTHRASF.Wound.major"}}</span></div>
</fieldset>
