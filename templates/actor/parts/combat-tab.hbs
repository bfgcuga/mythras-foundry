<div class="combat-paper-layout">
  <fieldset class="combat-paper-panel combat-action-panel"><legend>{{localize "MYTHRASF.Action.Actions"}}</legend><div class="combat-tactical-actions">
    <span data-action-presentation><button type="button" data-action="choose-weapon-attack" data-combat-action-key="attack"><i class="fas fa-crosshairs" aria-hidden="true"></i> {{localize "MYTHRASF.Combat.Attack"}}</button></span>
    <button type="button" data-combat-action-key="charge" title="{{localize 'MYTHRASF.Action.charge'}}"><i class="fas fa-horse-head" aria-hidden="true"></i> {{localize "MYTHRASF.Action.charge"}}</button>
    <button type="button" data-combat-action-key="brace" title="{{localize 'MYTHRASF.Action.brace'}}"><i class="fas fa-anchor" aria-hidden="true"></i> {{localize "MYTHRASF.Action.brace"}}</button><button type="button" data-combat-action-key="readyWeapon" title="{{localize 'MYTHRASF.Action.readyWeapon'}}"><i class="fas fa-hand" aria-hidden="true"></i> {{localize "MYTHRASF.Action.readyWeapon"}}</button><button type="button" data-combat-action-key="struggle" title="{{localize 'MYTHRASF.Action.struggle'}}"><i class="fas fa-link-slash" aria-hidden="true"></i> {{localize "MYTHRASF.Action.struggle"}}</button><button type="button" data-combat-action-key="maneuver" title="{{localize 'MYTHRASF.Action.maneuver'}}"><i class="fas fa-people-arrows" aria-hidden="true"></i> {{localize "MYTHRASF.Action.maneuver"}}</button><button type="button" data-combat-action-key="move" title="{{localize 'MYTHRASF.Action.move'}}"><i class="fas fa-person-running" aria-hidden="true"></i> {{localize "MYTHRASF.Action.move"}}</button><button type="button" data-combat-action-key="stand" title="{{localize 'MYTHRASF.Action.stand'}}"><i class="fas fa-person-arrow-up-from-line" aria-hidden="true"></i> {{localize "MYTHRASF.Action.stand"}}</button><button type="button" data-combat-action-key="delay" title="{{localize 'MYTHRASF.Action.delay'}}"><i class="fas fa-hourglass-half" aria-hidden="true"></i> {{localize "MYTHRASF.Action.delay"}}</button><button type="button" data-combat-action-key="hesitate" title="{{localize 'MYTHRASF.Action.hesitate'}}"><i class="fas fa-pause" aria-hidden="true"></i> {{localize "MYTHRASF.Action.hesitate"}}</button><button type="button" data-combat-action-key="mount" title="{{localize 'MYTHRASF.Action.mount'}}"><i class="fas fa-horse" aria-hidden="true"></i> {{localize "MYTHRASF.Action.mount"}}</button><button type="button" data-combat-action-key="retainMagic" title="{{localize 'MYTHRASF.Action.retainMagic'}}"><i class="fas fa-hand-sparkles" aria-hidden="true"></i> {{localize "MYTHRASF.Action.retainMagic"}}</button><button type="button" data-combat-action-key="useMagic" title="{{localize 'MYTHRASF.Action.useMagic'}}"><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i> {{localize "MYTHRASF.Action.useMagic"}}</button>
    <span data-action-presentation><button type="button" data-action="change-reach" data-combat-action-key="changeReach"><i class="fas fa-arrows-left-right" aria-hidden="true"></i> {{localize "MYTHRASF.Reach.Change"}}</button></span>
    <span data-action-presentation><button type="button" data-action="declare-passive-block" data-combat-action-key="passiveBlock"><i class="fas fa-shield-halved" aria-hidden="true"></i> {{localize "MYTHRASF.PassiveBlock.Declare"}}</button></span>
    <span data-action-presentation><button type="button" data-action="aim-ranged" data-combat-action-key="aim"><i class="fas fa-crosshairs" aria-hidden="true"></i> {{localize "MYTHRASF.Ranged.Aim"}}</button></span>
    <span data-action-presentation><button type="button" data-action="declare-cover" data-combat-action-key="seekCover"><i class="fas fa-person-shelter" aria-hidden="true"></i> {{localize "MYTHRASF.Ranged.DeclareCover"}}</button></span>
    <span data-action-presentation><button type="button" data-action="reload-ranged" data-combat-action-key="reload"><i class="fas fa-rotate" aria-hidden="true"></i> {{localize "MYTHRASF.Ranged.Reload"}}</button></span>
    <button type="button" data-action="tactical-overview"><i class="fas fa-people-arrows-left-right" aria-hidden="true"></i> {{localize "MYTHRASF.Reach.Overview"}}</button>
  </div></fieldset>
  {{> "systems/mythras-foundry/templates/actor/parts/hit-location-table.hbs"
    table=hitLocationTable editable=editable canDelete=canDeleteHitLocations
    canManageMorphology=canManageMorphology morphologyChoices=morphologyChoices
    morphologyKey=actor.system.morphologyKey canApplyMorphology=canApplyMorphology
    templateMode=hitLocationTemplateMode npcLayout=npcLayout}}

  <fieldset class="combat-paper-panel combat-paper-melee-weapons">
    <legend>{{localize "MYTHRASF.Combat.MeleeWeaponsAndShields"}}</legend>
    <div class="combat-weapon-head combat-weapon-melee">
      <span>{{localize "MYTHRASF.Weapon.Name"}}</span><span>{{localize "MYTHRASF.Weapon.Damage"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Size"}}</span><span>{{localize "MYTHRASF.Weapon.Reach"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Grip"}}</span><span>{{localize "MYTHRASF.Weapon.Effects"}}</span>
      <span>{{localize "MYTHRASF.Weapon.APHP"}}</span><span>{{localize "MYTHRASF.Combat.Style"}}</span><span>%</span><span></span>
    </div>
    {{#each meleeCombatWeapons as |row|}}
      <div class="combat-weapon-line combat-weapon-melee weapon-durability-{{row.durabilityState}}" data-item-id="{{row.item.id}}" data-mode-key="{{row.mode.key}}">
        <div class="combat-weapon-name">
          <button type="button" class="{{#if row.brokenLocationReference}}broken-location-reference{{/if}}" data-action="edit-item" title="{{#if row.brokenLocationReference}}{{localize 'MYTHRASF.HitLocation.BrokenReference'}}{{else}}{{row.displayName}}{{/if}}">{{row.displayName}}</button>
          <button type="button" data-action="toggle-equipped" data-hands="{{row.handsRequired}}" class="sheet-icon-button equipment-state-toggle hand-toggle {{#if row.prepared}}equipped{{/if}}" aria-pressed="{{row.prepared}}" aria-label="{{#if row.broken}}{{localize "MYTHRASF.Weapon.BrokenCannotEquip"}}{{else}}{{localize "MYTHRASF.Weapon.ToggleHands"}}{{/if}}" title="{{#if row.broken}}{{localize "MYTHRASF.Weapon.BrokenCannotEquip"}}{{else}}{{localize "MYTHRASF.Weapon.ToggleHands"}}{{/if}}" {{#if row.broken}}disabled{{/if}}><i class="fas {{#if row.broken}}fa-hand-slash{{else}}fa-hand{{/if}}" aria-hidden="true"></i>{{#unless row.broken}}<i class="fas fa-hand" aria-hidden="true"></i>{{/unless}}</button>
        </div>
        <span>{{row.mode.damage}}</span><span>{{row.mode.size}}</span><span>{{row.mode.reach}}</span>
        <span>{{row.mode.grip}}</span><span class="combat-effects">{{row.mode.effects}}</span>
        <span>{{row.durabilityDisplay}}</span>
        <div class="combat-style-choice">
          <select data-combat-style aria-label="{{localize "MYTHRASF.Combat.Style"}}">
            {{#if row.needsStyleChoice}}<option value="">{{localize "MYTHRASF.Combat.SelectStyle"}}</option>{{/if}}
            {{#each row.styleOptions as |style|}}<option value="{{style.id}}" {{#if style.selected}}selected{{/if}}>{{style.name}}</option>{{/each}}
          </select>
          {{#unless row.hasDirectStyle}}{{#unless row.usesUntrained}}<select data-combat-familiarity aria-label="{{localize "MYTHRASF.Combat.Familiarity"}}">
            {{#each row.familiarityOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}
          </select>{{/unless}}{{/unless}}
        </div>
        <strong class="penalized-value" title="{{row.difficultyLabel}}">{{row.baseTarget}}%{{#if row.hasTargetPenalty}} <span class="penalized-value-modifier">({{row.effectiveTarget}}%)</span>{{/if}}</strong>
        <button type="button" class="sheet-icon-button" data-action="roll-weapon-attack" {{#unless row.canAttack}}disabled{{/unless}}
          aria-label="{{localize "MYTHRASF.Combat.Attack"}}" title="{{localize "MYTHRASF.Combat.Attack"}}"><i class="fas fa-dice-d20" aria-hidden="true"></i></button>
      </div>
    {{else}}<p class="empty">{{localize "MYTHRASF.Empty.MeleeWeapons"}}</p>{{/each}}

  </fieldset>

  <fieldset class="combat-paper-panel combat-paper-ranged-weapons">
    <legend>{{localize "MYTHRASF.Combat.RangedWeapons"}}</legend>
    <div class="combat-weapon-head combat-weapon-ranged">
      <span>{{localize "MYTHRASF.Weapon.Name"}}</span><span>{{localize "MYTHRASF.Weapon.Damage"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Size"}}</span><span>{{localize "MYTHRASF.Weapon.DamageModifier.Label"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Range"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Reload"}}</span><span>{{localize "MYTHRASF.Weapon.Effects"}}</span>
      <span>{{localize "MYTHRASF.Weapon.APHP"}}</span><span>{{localize "MYTHRASF.Combat.Style"}}</span><span>%</span><span></span>
    </div>
    {{#each rangedCombatWeapons as |row|}}
      <div class="combat-weapon-line combat-weapon-ranged weapon-durability-{{row.durabilityState}}" data-item-id="{{row.item.id}}" data-mode-key="{{row.mode.key}}">
        <div class="combat-weapon-name">
          <button type="button" class="{{#if row.brokenLocationReference}}broken-location-reference{{/if}}" data-action="edit-item" title="{{#if row.brokenLocationReference}}{{localize 'MYTHRASF.HitLocation.BrokenReference'}}{{else}}{{row.displayName}}{{/if}}">{{row.displayName}}</button>
          <button type="button" data-action="toggle-equipped" data-hands="{{row.handsRequired}}" class="sheet-icon-button equipment-state-toggle hand-toggle {{#if row.prepared}}equipped{{/if}}" aria-pressed="{{row.prepared}}" aria-label="{{#if row.broken}}{{localize "MYTHRASF.Weapon.BrokenCannotEquip"}}{{else}}{{localize "MYTHRASF.Weapon.ToggleHands"}}{{/if}}" title="{{#if row.broken}}{{localize "MYTHRASF.Weapon.BrokenCannotEquip"}}{{else}}{{localize "MYTHRASF.Weapon.ToggleHands"}}{{/if}}" {{#if row.broken}}disabled{{/if}}><i class="fas {{#if row.broken}}fa-hand-slash{{else}}fa-hand{{/if}}" aria-hidden="true"></i>{{#unless row.broken}}<i class="fas fa-hand" aria-hidden="true"></i>{{/unless}}</button>
        </div>
        <span>{{row.mode.damage}}</span><span>{{row.mode.size}}</span><span>{{row.damageModifierLabel}}</span><span>{{row.mode.range}}</span>
        <span>{{row.mode.reload}}{{#if row.mode.ammoTracking}} · {{row.mode.ammoLoaded}}/{{row.mode.ammoReserve}}{{/if}}</span><span class="combat-effects">{{row.mode.effects}}</span>
        <span>{{row.durabilityDisplay}}</span>
        <div class="combat-style-choice">
          <select data-combat-style aria-label="{{localize "MYTHRASF.Combat.Style"}}">
            {{#if row.needsStyleChoice}}<option value="">{{localize "MYTHRASF.Combat.SelectStyle"}}</option>{{/if}}
            {{#each row.styleOptions as |style|}}<option value="{{style.id}}" {{#if style.selected}}selected{{/if}}>{{style.name}}</option>{{/each}}
          </select>
          {{#unless row.hasDirectStyle}}{{#unless row.usesUntrained}}<select data-combat-familiarity aria-label="{{localize "MYTHRASF.Combat.Familiarity"}}">
            {{#each row.familiarityOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}
          </select>{{/unless}}{{/unless}}
        </div>
        <strong class="penalized-value" title="{{row.difficultyLabel}}">{{row.baseTarget}}%{{#if row.hasTargetPenalty}} <span class="penalized-value-modifier">({{row.effectiveTarget}}%)</span>{{/if}}</strong>
        <button type="button" class="sheet-icon-button" data-action="roll-weapon-attack" {{#unless row.canAttack}}disabled{{/unless}}
          aria-label="{{localize "MYTHRASF.Combat.Attack"}}" title="{{localize "MYTHRASF.Combat.Attack"}}"><i class="fas fa-dice-d20" aria-hidden="true"></i></button>
      </div>
    {{else}}<p class="empty">{{localize "MYTHRASF.Empty.RangedWeapons"}}</p>{{/each}}
  </fieldset>

  <fieldset class="combat-paper-panel combat-paper-styles">
    <legend>{{localize "MYTHRASF.Skill.GroupCombat"}} ({{localize "MYTHRASF.Combat.BaseFormula"}})</legend>
    {{#if editable}}<button type="button" class="combat-panel-add sheet-add-button" data-action="create-combat-style"
      aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>{{/if}}
    <div class="combat-style-head"><span>{{localize "MYTHRASF.Combat.Style"}}</span><span>{{localize "MYTHRASF.CombatStyle.Weapons"}}</span><span>{{localize "MYTHRASF.CombatStyle.Traits"}}</span><span>%</span></div>
    {{#each combatStyles as |style|}}
      <div class="combat-style-line" data-item-id="{{style.item.id}}">
        <button type="button" data-action="edit-item">{{style.item.name}}</button>
        <span>{{style.weapons}}</span><span>{{style.traits}}</span>{{#if ../combatStyleTemplateMode}}<input class="sheet-field-editable" type="number" min="0" data-manual-value value="{{style.total}}" aria-label="{{localize "MYTHRASF.Skill.ManualValue"}}">{{else}}<strong class="penalized-value">{{style.totalDisplay.base}}%{{#if style.totalDisplay.penalized}} <span class="penalized-value-modifier">({{style.totalDisplay.effective}}%)</span>{{/if}}</strong>{{/if}}
      </div>
    {{else}}<p class="empty">{{localize "MYTHRASF.Combat.NoStyles"}}</p>{{/each}}
  </fieldset>

</div>
