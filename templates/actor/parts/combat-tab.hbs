<div class="combat-paper-layout">
  <fieldset class="combat-paper-panel combat-paper-locations">
    <legend>{{localize "MYTHRASF.HitLocations"}}</legend>
    {{#if editable}}<button type="button" class="combat-panel-add sheet-add-button" data-action="create-item"
      data-type="hitLocation" aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>{{/if}}
    <div class="combat-location-head">
      <span>d20</span><span>{{localize "MYTHRASF.HitLocation.Location"}}</span>
      <span>{{localize "MYTHRASF.HitLocation.MaxShort"}}</span>
      <span>{{localize "MYTHRASF.HitLocation.CurrentShort"}}</span>
      <span>{{localize "MYTHRASF.HitLocation.Armor"}}</span><span></span>
    </div>
    {{#each combatHitLocations as |row|}}
      <div class="combat-location-line" data-item-id="{{row.item.id}}">
        <span>{{row.item.system.rangeStart}}–{{row.item.system.rangeEnd}}</span>
        <button type="button" data-action="edit-item">{{row.item.name}}</button>
        <output class="location-max">{{row.item.system.maxHitPoints}}</output>
        <output class="location-current wound-{{row.item.system.woundLevel}}">{{row.item.system.currentHitPoints}}</output>
        <output class="location-armor" title="{{localize "MYTHRASF.Armor.Natural"}}: {{row.naturalArmor}} + {{localize "MYTHRASF.Combat.WornArmor"}}: {{row.wornArmor}}">{{row.totalArmor}}</output>
        {{#if ../editMode}}<button type="button" class="sheet-icon-button" data-action="delete-item"
          aria-label="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{else}}<span></span>{{/if}}
      </div>
    {{else}}<p class="empty">{{localize "MYTHRASF.Empty.HitLocations"}}</p>{{/each}}
    <div class="combat-wound-legend">
      <span>{{localize "MYTHRASF.HitLocation.Wound"}}:</span>
      <span class="wound-minor">{{localize "MYTHRASF.Wound.minor"}}</span>
      <span class="wound-serious">{{localize "MYTHRASF.Wound.serious"}}</span>
      <span class="wound-major">{{localize "MYTHRASF.Wound.major"}}</span>
    </div>
  </fieldset>

  <fieldset class="combat-paper-panel combat-paper-armor">
    <legend>{{localize "MYTHRASF.Armors"}}</legend>
    <div class="combat-armor-head"><span>{{localize "TYPES.Item.armor"}}</span><span>{{localize "MYTHRASF.Armor.Coverage"}}</span><span>{{localize "MYTHRASF.Item.Description"}}</span><span>{{localize "MYTHRASF.Armor.Points"}}</span><span>{{localize "MYTHRASF.Armor.PenaltyShort"}}</span><span>{{localize "MYTHRASF.Item.Equipped"}}</span></div>
    {{#each combatArmor as |row|}}
      <div class="combat-armor-line" data-item-id="{{row.item.id}}">
        <button type="button" data-action="edit-item">{{row.item.name}}</button>
        <span>{{row.coverageLabel}}</span><span class="combat-armor-description">{{{row.item.system.description}}}</span>
        <output>{{row.item.system.armorPoints}}</output><strong>{{row.item.system.penalty}}%</strong>
        <button type="button" data-action="toggle-equipped" class="sheet-icon-button equipment-state-toggle armor-toggle {{#if row.item.system.equipped}}equipped{{/if}}" aria-pressed="{{row.item.system.equipped}}" title="{{localize "MYTHRASF.Armor.ToggleEquipped"}}"><i class="fas fa-vest" aria-hidden="true"></i></button>
      </div>
    {{else}}<p class="empty">{{localize "MYTHRASF.Empty.Armor"}}</p>{{/each}}
    <div class="combat-paper-total"><span>{{localize "MYTHRASF.Armor.TotalPenalty"}}</span><strong>{{wornArmorPenalty}}%</strong></div>
  </fieldset>

  <fieldset class="combat-paper-panel combat-paper-fatigue">
    <legend>{{localize "MYTHRASF.Fatigue.Label"}}</legend>
    <div class="combat-fatigue-head"><span>{{localize "MYTHRASF.Fatigue.State"}}</span><span>{{localize "MYTHRASF.Fatigue.SkillModifier"}}</span><span>{{localize "MYTHRASF.Fatigue.Movement"}}</span><span>{{localize "MYTHRASF.Fatigue.Initiative"}}</span><span>{{localize "MYTHRASF.Fatigue.ActionPoints"}}</span><span>{{localize "MYTHRASF.Fatigue.Recovery"}}</span></div>
    {{#each fatigueRows as |row|}}<label class="combat-fatigue-line {{#if row.selected}}active{{/if}}">
      <span><input type="radio" value="{{row.key}}" data-fatigue-level {{checked row.selected}}> {{row.levelLabel}}</span>
      <span>{{row.skillLabel}}</span><span>{{row.movementLabel}}{{#if row.movementPenalty}} -{{row.movementPenalty}} m{{/if}}</span>
      <span>{{row.initiativeLabel}}</span><span>{{row.actionPointLabel}}</span><span>{{row.recoveryLabel}}</span>
    </label>{{/each}}
  </fieldset>

  <fieldset class="combat-paper-panel combat-paper-styles">
    <legend>{{localize "MYTHRASF.Skill.GroupCombat"}} ({{localize "MYTHRASF.Combat.BaseFormula"}})</legend>
    {{#if editable}}<button type="button" class="combat-panel-add sheet-add-button" data-action="create-combat-style"
      aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>{{/if}}
    <div class="combat-style-head"><span>{{localize "MYTHRASF.Combat.Style"}}</span><span>{{localize "MYTHRASF.CombatStyle.Weapons"}}</span><span>{{localize "MYTHRASF.CombatStyle.Traits"}}</span><span>%</span></div>
    {{#each combatStyles as |style|}}
      <div class="combat-style-line" data-item-id="{{style.item.id}}">
        <button type="button" data-action="edit-item">{{style.item.name}}</button>
        <span>{{style.weapons}}</span><span>{{style.traits}}</span><strong>{{style.total}}%</strong>
      </div>
    {{else}}<p class="empty">{{localize "MYTHRASF.Combat.NoStyles"}}</p>{{/each}}
  </fieldset>

  <fieldset class="combat-paper-panel combat-paper-weapons">
    <legend>{{localize "MYTHRASF.Combat.WeaponsAndShields"}}</legend>
    <div class="combat-weapon-head">
      <span>{{localize "MYTHRASF.Weapon.Name"}}</span><span>{{localize "MYTHRASF.Weapon.Damage"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Size"}}</span><span>{{localize "MYTHRASF.Weapon.Reach"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Grip"}}</span><span>{{localize "MYTHRASF.Weapon.Effects"}}</span>
      <span>{{localize "MYTHRASF.Weapon.APHP"}}</span><span>{{localize "MYTHRASF.Combat.Style"}}</span><span>%</span><span></span>
    </div>
    {{#each combatWeapons as |row|}}
      <div class="combat-weapon-line" data-item-id="{{row.item.id}}" data-mode-key="{{row.mode.key}}">
        <div class="combat-weapon-name">
          <button type="button" data-action="edit-item" title="{{row.displayName}}">{{row.displayName}}</button>
          <button type="button" data-action="toggle-equipped" data-hands="{{row.handsRequired}}" class="sheet-icon-button equipment-state-toggle hand-toggle {{#if row.prepared}}equipped{{/if}}" aria-pressed="{{row.prepared}}" title="{{localize "MYTHRASF.Weapon.ToggleHands"}}"><i class="fas fa-hand"></i><i class="fas fa-hand"></i></button>
        </div>
        <span>{{row.mode.damage}}</span><span>{{row.mode.size}}</span><span>{{row.mode.reach}}</span>
        <span>{{row.mode.grip}}</span><span class="combat-effects">{{row.mode.effects}}</span>
        <span>{{row.item.system.armorPoints}} / {{row.item.system.currentHitPoints}}–{{row.item.system.maxHitPoints}}</span>
        <div class="combat-style-choice">
          <select data-combat-style aria-label="{{localize "MYTHRASF.Combat.Style"}}">
            {{#if row.needsStyleChoice}}<option value="">{{localize "MYTHRASF.Combat.SelectStyle"}}</option>{{/if}}
            {{#each row.styleOptions as |style|}}<option value="{{style.id}}" {{#if style.selected}}selected{{/if}}>{{style.name}}</option>{{/each}}
          </select>
          {{#unless row.hasDirectStyle}}<select data-combat-familiarity aria-label="{{localize "MYTHRASF.Combat.Familiarity"}}">
            {{#each row.familiarityOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}
          </select>{{/unless}}
        </div>
        <strong title="{{row.difficultyLabel}}">{{row.effectiveTarget}}%</strong>
        <button type="button" class="sheet-icon-button" data-action="roll-weapon-attack" {{#unless row.canAttack}}disabled{{/unless}}
          aria-label="{{localize "MYTHRASF.Combat.Attack"}}"><i class="fas fa-dice-d20"></i></button>
      </div>
    {{else}}<p class="empty">{{localize "MYTHRASF.Empty.Weapons"}}</p>{{/each}}
  </fieldset>
</div>
