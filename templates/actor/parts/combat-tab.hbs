<div class="combat-paper-layout">
  <fieldset class="combat-paper-panel combat-action-panel"><legend>{{localize "MYTHRASF.Action.Actions"}}</legend><div class="combat-tactical-actions">
    <button type="button" data-combat-action-key="charge" title="{{localize 'MYTHRASF.Action.charge'}}"><i class="fas fa-horse-head" aria-hidden="true"></i> {{localize "MYTHRASF.Action.charge"}}</button>
    <button type="button" data-combat-action-key="brace" title="{{localize 'MYTHRASF.Action.brace'}}"><i class="fas fa-anchor" aria-hidden="true"></i> {{localize "MYTHRASF.Action.brace"}}</button><button type="button" data-combat-action-key="readyWeapon" title="{{localize 'MYTHRASF.Action.readyWeapon'}}"><i class="fas fa-hand" aria-hidden="true"></i> {{localize "MYTHRASF.Action.readyWeapon"}}</button><button type="button" data-combat-action-key="struggle" title="{{localize 'MYTHRASF.Action.struggle'}}"><i class="fas fa-link-slash" aria-hidden="true"></i> {{localize "MYTHRASF.Action.struggle"}}</button><button type="button" data-combat-action-key="maneuver" title="{{localize 'MYTHRASF.Action.maneuver'}}"><i class="fas fa-people-arrows" aria-hidden="true"></i> {{localize "MYTHRASF.Action.maneuver"}}</button><button type="button" data-combat-action-key="move" title="{{localize 'MYTHRASF.Action.move'}}"><i class="fas fa-person-running" aria-hidden="true"></i> {{localize "MYTHRASF.Action.move"}}</button><button type="button" data-combat-action-key="stand" title="{{localize 'MYTHRASF.Action.stand'}}"><i class="fas fa-person-arrow-up-from-line" aria-hidden="true"></i> {{localize "MYTHRASF.Action.stand"}}</button><button type="button" data-combat-action-key="delay" title="{{localize 'MYTHRASF.Action.delay'}}"><i class="fas fa-hourglass-half" aria-hidden="true"></i> {{localize "MYTHRASF.Action.delay"}}</button><button type="button" data-combat-action-key="hesitate" title="{{localize 'MYTHRASF.Action.hesitate'}}"><i class="fas fa-pause" aria-hidden="true"></i> {{localize "MYTHRASF.Action.hesitate"}}</button><button type="button" data-combat-action-key="mount" title="{{localize 'MYTHRASF.Action.mount'}}"><i class="fas fa-horse" aria-hidden="true"></i> {{localize "MYTHRASF.Action.mount"}}</button><button type="button" data-combat-action-key="retainMagic" title="{{localize 'MYTHRASF.Action.retainMagic'}}"><i class="fas fa-hand-sparkles" aria-hidden="true"></i> {{localize "MYTHRASF.Action.retainMagic"}}</button><button type="button" data-combat-action-key="useMagic" title="{{localize 'MYTHRASF.Action.useMagic'}}"><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i> {{localize "MYTHRASF.Action.useMagic"}}</button>
  </div></fieldset>
  <div class="combat-tactical-actions"><button type="button" data-action="change-reach" title="{{localize 'MYTHRASF.Reach.Change'}}"><i class="fas fa-arrows-left-right" aria-hidden="true"></i> {{localize "MYTHRASF.Reach.Change"}}</button><button type="button" data-action="declare-passive-block" title="{{localize 'MYTHRASF.PassiveBlock.Declare'}}"><i class="fas fa-shield-halved" aria-hidden="true"></i> {{localize "MYTHRASF.PassiveBlock.Declare"}}</button><button type="button" data-action="tactical-overview" title="{{localize 'MYTHRASF.Reach.Overview'}}"><i class="fas fa-people-arrows-left-right" aria-hidden="true"></i> {{localize "MYTHRASF.Reach.Overview"}}</button></div>
  <fieldset class="combat-paper-panel combat-paper-locations">
    <legend>{{localize "MYTHRASF.HitLocations"}}</legend>
    {{#if editable}}<button type="button" class="combat-panel-add sheet-add-button" data-action="create-item"
      data-type="hitLocation" aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>{{/if}}
    <div class="combat-location-head">
      <span>d20</span><span>{{localize "MYTHRASF.HitLocation.Location"}}</span>
      <span>{{localize "MYTHRASF.HitLocation.MaxShort"}}</span>
      <span>{{localize "MYTHRASF.HitLocation.CurrentShort"}}</span>
      <span>{{localize "MYTHRASF.Armor.Piece.Label"}}</span>
      <span>{{localize "MYTHRASF.HitLocation.Armor"}}</span><span></span>
    </div>
    {{#each combatHitLocations as |row|}}
      <div class="combat-location-line" data-item-id="{{row.item.id}}">
        <span>{{row.item.system.rangeStart}}–{{row.item.system.rangeEnd}}</span>
        <div class="combat-location-name">
          <button type="button" data-action="edit-item">{{row.item.name}}</button>
          {{#if row.showDisabledControl}}
            {{#if @root.editable}}<label class="location-disabled-state {{#if row.disabled}}active{{/if}}">
              <input type="checkbox" class="sheet-state-box" data-location-disabled
                {{checked row.disabled}} aria-label="{{localize "MYTHRASF.HitLocation.Disabled"}}">
              <span>{{localize "MYTHRASF.HitLocation.Disabled"}}</span>
            </label>{{else if row.disabled}}<span class="location-disabled-state active">{{localize "MYTHRASF.HitLocation.Disabled"}}</span>{{/if}}
          {{else if row.disabled}}<span class="location-disabled-state active">{{localize "MYTHRASF.HitLocation.Disabled"}}</span>{{/if}}
        </div>
        <output class="location-max">{{row.item.system.maxHitPoints}}</output>
        <output class="location-current wound-{{row.item.system.woundLevel}}">{{row.item.system.currentHitPoints}}</output>
        <select data-location-armor aria-label="{{localize "MYTHRASF.Armor.Piece.SelectForLocation"}}" {{#unless @root.editable}}disabled{{/unless}}>
          <option value="">{{localize "MYTHRASF.Armor.Piece.None"}}</option>
          {{selectOptions row.armorOptions selected=row.equippedArmorId labelAttr="label" valueAttr="value"}}
        </select>
        <output class="location-armor" title="{{localize "MYTHRASF.Armor.Natural"}}: {{row.naturalArmor}} + {{localize "MYTHRASF.Combat.WornArmor"}}: {{row.wornArmor}}">{{row.totalArmor}}</output>
        {{#if ../editMode}}<button type="button" class="sheet-icon-button" data-action="delete-item"
          aria-label="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{else}}<span></span>{{/if}}
      </div>
    {{else}}<p class="empty">{{localize "MYTHRASF.Empty.HitLocations"}}</p>{{/each}}
    <div class="combat-wound-legend">
      <span>{{localize "MYTHRASF.HitLocation.Wound"}}:</span>
      <span class="wound-minor">{{localize "MYTHRASF.Wound.minor"}}</span>
      <span class="wound-serious">{{localize "MYTHRASF.Wound.serious"}}</span>
      <span class="wound-major">{{localize "MYTHRASF.Wound.major"}}</span>
    </div>
  </fieldset>

  <fieldset class="combat-paper-panel combat-paper-styles">
    <legend>{{localize "MYTHRASF.Skill.GroupCombat"}} ({{localize "MYTHRASF.Combat.BaseFormula"}})</legend>
    {{#if editable}}<button type="button" class="combat-panel-add sheet-add-button" data-action="create-combat-style"
      aria-label="{{localize "MYTHRASF.Add"}}" title="{{localize "MYTHRASF.Add"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>{{/if}}
    <div class="combat-style-head"><span>{{localize "MYTHRASF.Combat.Style"}}</span><span>{{localize "MYTHRASF.CombatStyle.Weapons"}}</span><span>{{localize "MYTHRASF.CombatStyle.Traits"}}</span><span>%</span></div>
    {{#each combatStyles as |style|}}
      <div class="combat-style-line" data-item-id="{{style.item.id}}">
        <button type="button" data-action="edit-item">{{style.item.name}}</button>
        <span>{{style.weapons}}</span><span>{{style.traits}}</span><strong class="penalized-value">{{style.totalDisplay.base}}%{{#if style.totalDisplay.penalized}} <span class="penalized-value-modifier">({{style.totalDisplay.effective}}%)</span>{{/if}}</strong>
      </div>
    {{else}}<p class="empty">{{localize "MYTHRASF.Combat.NoStyles"}}</p>{{/each}}
  </fieldset>

  <fieldset class="combat-paper-panel combat-paper-melee-weapons">
    <legend>{{localize "MYTHRASF.Combat.MeleeWeaponsAndShields"}}</legend>
    <div class="combat-weapon-head combat-weapon-melee">
      <span>{{localize "MYTHRASF.Weapon.Name"}}</span><span>{{localize "MYTHRASF.Weapon.Damage"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Size"}}</span><span>{{localize "MYTHRASF.Weapon.Reach"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Grip"}}</span><span>{{localize "MYTHRASF.Weapon.Effects"}}</span>
      <span>{{localize "MYTHRASF.Weapon.APHP"}}</span><span>{{localize "MYTHRASF.Combat.Style"}}</span><span>%</span><span></span>
    </div>
    {{#each meleeCombatWeapons as |row|}}
      <div class="combat-weapon-line combat-weapon-melee" data-item-id="{{row.item.id}}" data-mode-key="{{row.mode.key}}">
        <div class="combat-weapon-name">
          <button type="button" data-action="edit-item" title="{{row.displayName}}">{{row.displayName}}</button>
          <button type="button" data-action="toggle-equipped" data-hands="{{row.handsRequired}}" class="sheet-icon-button equipment-state-toggle hand-toggle {{#if row.prepared}}equipped{{/if}}" aria-pressed="{{row.prepared}}" title="{{localize "MYTHRASF.Weapon.ToggleHands"}}"><i class="fas fa-hand"></i><i class="fas fa-hand"></i></button>
        </div>
        <span>{{row.mode.damage}}</span><span>{{row.mode.size}}</span><span>{{row.mode.reach}}</span>
        <span>{{row.mode.grip}}</span><span class="combat-effects">{{row.mode.effects}}</span>
        <span>{{row.item.system.armorPoints}} / {{row.item.system.currentHitPoints}}–{{row.item.system.maxHitPoints}}</span>
        <div class="combat-style-choice">
          <select data-combat-style aria-label="{{localize "MYTHRASF.Combat.Style"}}">
            {{#if row.needsStyleChoice}}<option value="">{{localize "MYTHRASF.Combat.SelectStyle"}}</option>{{/if}}
            {{#each row.styleOptions as |style|}}<option value="{{style.id}}" {{#if style.selected}}selected{{/if}}>{{style.name}}</option>{{/each}}
          </select>
          {{#unless row.hasDirectStyle}}{{#unless row.usesUntrained}}<select data-combat-familiarity aria-label="{{localize "MYTHRASF.Combat.Familiarity"}}">
            {{#each row.familiarityOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}
          </select>{{/unless}}{{/unless}}
        </div>
        <strong class="penalized-value" title="{{row.difficultyLabel}}">{{row.baseTarget}}%{{#if row.hasTargetPenalty}} <span class="penalized-value-modifier">({{row.effectiveTarget}}%)</span>{{/if}}</strong>
        <button type="button" class="sheet-icon-button" data-action="roll-weapon-attack" {{#unless row.canAttack}}disabled{{/unless}}
          aria-label="{{localize "MYTHRASF.Combat.Attack"}}"><i class="fas fa-dice-d20"></i></button>
      </div>
    {{else}}<p class="empty">{{localize "MYTHRASF.Empty.MeleeWeapons"}}</p>{{/each}}

  </fieldset>

  <fieldset class="combat-paper-panel combat-paper-ranged-weapons">
    <legend>{{localize "MYTHRASF.Combat.RangedWeapons"}}</legend>
    <div class="combat-tactical-actions"><button type="button" data-action="aim-ranged" title="{{localize "MYTHRASF.Ranged.Aim"}}"><i class="fas fa-crosshairs" aria-hidden="true"></i> {{localize "MYTHRASF.Ranged.Aim"}}</button><button type="button" data-action="reload-ranged" title="{{localize "MYTHRASF.Ranged.Reload"}}"><i class="fas fa-rotate" aria-hidden="true"></i> {{localize "MYTHRASF.Ranged.Reload"}}</button><button type="button" data-action="declare-cover" title="{{localize "MYTHRASF.Ranged.DeclareCover"}}"><i class="fas fa-person-shelter" aria-hidden="true"></i> {{localize "MYTHRASF.Ranged.DeclareCover"}}</button></div>
    <div class="combat-weapon-head combat-weapon-ranged">
      <span>{{localize "MYTHRASF.Weapon.Name"}}</span><span>{{localize "MYTHRASF.Weapon.Damage"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Size"}}</span><span>{{localize "MYTHRASF.Weapon.DamageModifier.Label"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Range"}}</span>
      <span>{{localize "MYTHRASF.Weapon.Reload"}}</span><span>{{localize "MYTHRASF.Weapon.Effects"}}</span>
      <span>{{localize "MYTHRASF.Weapon.APHP"}}</span><span>{{localize "MYTHRASF.Combat.Style"}}</span><span>%</span><span></span>
    </div>
    {{#each rangedCombatWeapons as |row|}}
      <div class="combat-weapon-line combat-weapon-ranged" data-item-id="{{row.item.id}}" data-mode-key="{{row.mode.key}}">
        <div class="combat-weapon-name">
          <button type="button" data-action="edit-item" title="{{row.displayName}}">{{row.displayName}}</button>
          <button type="button" data-action="toggle-equipped" data-hands="{{row.handsRequired}}" class="sheet-icon-button equipment-state-toggle hand-toggle {{#if row.prepared}}equipped{{/if}}" aria-pressed="{{row.prepared}}" title="{{localize "MYTHRASF.Weapon.ToggleHands"}}"><i class="fas fa-hand"></i><i class="fas fa-hand"></i></button>
        </div>
        <span>{{row.mode.damage}}</span><span>{{row.mode.size}}</span><span>{{row.damageModifierLabel}}</span><span>{{row.mode.range}}</span>
        <span>{{row.mode.reload}}{{#if row.mode.ammoTracking}} · {{row.mode.ammoLoaded}}/{{row.mode.ammoReserve}}{{/if}}</span><span class="combat-effects">{{row.mode.effects}}</span>
        <span>{{row.item.system.armorPoints}} / {{row.item.system.currentHitPoints}}–{{row.item.system.maxHitPoints}}</span>
        <div class="combat-style-choice">
          <select data-combat-style aria-label="{{localize "MYTHRASF.Combat.Style"}}">
            {{#if row.needsStyleChoice}}<option value="">{{localize "MYTHRASF.Combat.SelectStyle"}}</option>{{/if}}
            {{#each row.styleOptions as |style|}}<option value="{{style.id}}" {{#if style.selected}}selected{{/if}}>{{style.name}}</option>{{/each}}
          </select>
          {{#unless row.hasDirectStyle}}{{#unless row.usesUntrained}}<select data-combat-familiarity aria-label="{{localize "MYTHRASF.Combat.Familiarity"}}">
            {{#each row.familiarityOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}
          </select>{{/unless}}{{/unless}}
        </div>
        <strong class="penalized-value" title="{{row.difficultyLabel}}">{{row.baseTarget}}%{{#if row.hasTargetPenalty}} <span class="penalized-value-modifier">({{row.effectiveTarget}}%)</span>{{/if}}</strong>
        <button type="button" class="sheet-icon-button" data-action="roll-weapon-attack" {{#unless row.canAttack}}disabled{{/unless}}
          aria-label="{{localize "MYTHRASF.Combat.Attack"}}"><i class="fas fa-dice-d20"></i></button>
      </div>
    {{else}}<p class="empty">{{localize "MYTHRASF.Empty.RangedWeapons"}}</p>{{/each}}
  </fieldset>

  <fieldset class="combat-paper-panel combat-paper-fatigue">
    <legend>{{localize "MYTHRASF.Fatigue.Label"}}</legend>
    <div class="combat-fatigue-head"><span>{{localize "MYTHRASF.Fatigue.State"}}</span><span>{{localize "MYTHRASF.Fatigue.SkillModifier"}}</span><span>{{localize "MYTHRASF.Fatigue.Movement"}}</span><span>{{localize "MYTHRASF.Fatigue.Initiative"}}</span><span>{{localize "MYTHRASF.Fatigue.ActionPoints"}}</span><span>{{localize "MYTHRASF.Fatigue.Recovery"}}</span></div>
    {{#each fatigueRows as |row|}}<label class="combat-fatigue-line">
      <span><input type="radio" class="sheet-state-box" name="fatigue-level" value="{{row.key}}"
        data-fatigue-level {{checked row.selected}} aria-label="{{row.levelLabel}}"> {{row.levelLabel}}</span>
      <span>{{row.skillLabel}}</span><span>{{row.movementLabel}}{{#if row.movementPenalty}} -{{row.movementPenalty}} m{{/if}}</span>
      <span>{{row.initiativeLabel}}</span><span>{{row.actionPointLabel}}</span><span>{{row.recoveryLabel}}</span>
    </label>{{/each}}
  </fieldset>
</div>
