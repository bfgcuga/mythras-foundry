<div class="inventory-tree">
  <div class="inventory-tree-head"><span></span><span></span><span>{{localize "MYTHRASF.Combat.Object"}}</span><span>{{localize "MYTHRASF.ItemClass.Label"}}</span><span>{{localize "MYTHRASF.Item.Quantity"}}</span><span>{{localize "MYTHRASF.Item.Price"}}</span><span>{{localize "MYTHRASF.Item.Weight"}}</span><span>{{localize "MYTHRASF.Item.Location"}}</span><span></span><span></span><span></span></div>
  <ol class="item-list">
    {{#each items as |entry|}}
      {{#if entry.groupStart}}<li class="inventory-category-heading" {{#if entry.hidden}}hidden{{/if}} style="padding-left: {{entry.indent}}px">{{entry.groupLabel}}</li>{{/if}}
      <li draggable="true" data-item-id="{{entry.id}}" data-inventory-destination="{{#if entry.isContainer}}{{entry.id}}{{/if}}" {{#if entry.hidden}}hidden{{/if}} class="{{#if entry.isContainer}}inventory-container-row{{/if}} {{#if entry.isWeapon}}weapon-durability-{{entry.durabilityState}} {{#if entry.inoperable}}weapon-inoperable{{/if}}{{/if}} {{#if entry.isArmor}}armor-durability-{{entry.durabilityState}}{{/if}}">
        <img class="inventory-item-image" src="{{entry.item.img}}" alt="">
        {{#if entry.isContainer}}<button type="button" class="sheet-icon-button inventory-container-toggle" data-action="toggle-container" aria-expanded="{{#unless entry.system.collapsed}}true{{else}}false{{/unless}}" title="{{localize "MYTHRASF.Item.Container.Toggle"}}"><i class="fas {{#if entry.system.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i></button>{{else}}<span></span>{{/if}}
        <button type="button" class="item-name {{#if entry.brokenLocationReference}}broken-location-reference{{/if}}" data-action="edit-item" style="padding-left: {{entry.indent}}px" {{#if entry.brokenLocationReference}}title="{{localize 'MYTHRASF.HitLocation.BrokenReference'}}"{{/if}}>{{entry.name}}</button>
        <span>{{entry.categoryLabel}}</span>
        <span>{{entry.system.quantity}}</span><span>{{entry.priceLabel}}</span><span>{{entry.encumbrance}}</span>
        <span>{{entry.locationLabel}}</span>
        {{#if entry.isWeapon}}<button type="button" data-action="toggle-equipped" data-hands="{{entry.handsRequired}}" class="sheet-icon-button equipment-state-toggle {{#if entry.pinned}}weapon-pinned{{/if}} {{#if entry.system.equipped}}equipped{{/if}}" aria-label="{{#if entry.broken}}{{localize "MYTHRASF.Weapon.BrokenCannotEquip"}}{{else}}{{#if entry.pinned}}{{localize "MYTHRASF.Pin.Blocked"}}{{else}}{{localize "MYTHRASF.Weapon.ToggleHands"}}{{/if}}{{/if}}" title="{{#if entry.broken}}{{localize "MYTHRASF.Weapon.BrokenCannotEquip"}}{{else}}{{#if entry.pinned}}{{localize "MYTHRASF.Pin.Blocked"}}{{else}}{{localize "MYTHRASF.Weapon.ToggleHands"}}{{/if}}{{/if}}" {{#if entry.broken}}disabled{{/if}}><i class="fas {{#if entry.broken}}fa-hand-slash{{else}}fa-hand{{/if}}" aria-hidden="true"></i></button>{{else}}{{#if entry.isArmor}}<button type="button" data-action="toggle-equipped" class="sheet-icon-button equipment-state-toggle {{#if entry.system.equipped}}equipped{{/if}}" aria-label="{{#if entry.broken}}{{localize "MYTHRASF.Armor.BrokenCannotEquip"}}{{else}}{{localize "MYTHRASF.Armor.ToggleEquipped"}}{{/if}}" title="{{#if entry.broken}}{{localize "MYTHRASF.Armor.BrokenCannotEquip"}}{{else}}{{localize "MYTHRASF.Armor.ToggleEquipped"}}{{/if}}" {{#if entry.broken}}disabled{{/if}}><i class="fas fa-vest" aria-hidden="true"></i></button>{{else}}<span></span>{{/if}}{{/if}}
        {{#if @root.editable}}{{#if entry.inoperable}}<button type="button" class="sheet-icon-button" data-action="repair-inoperable-weapon" aria-label="{{localize 'MYTHRASF.Weapon.RepairInoperable'}}" title="{{localize 'MYTHRASF.Weapon.RepairInoperable'}}"><i class="fas fa-screwdriver-wrench" aria-hidden="true"></i></button>{{/if}}<button type="button" class="sheet-icon-button inventory-sell" data-action="sell-item" aria-label="{{localize "MYTHRASF.Item.Sell"}}" title="{{localize "MYTHRASF.Item.Sell"}}"><i class="fas fa-coins" aria-hidden="true"></i></button><button type="button" class="sheet-icon-button inventory-delete" data-action="delete-item" aria-label="{{localize "MYTHRASF.Delete"}}" title="{{localize "MYTHRASF.Delete"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{/if}}
      </li>
    {{else}}<li class="empty">{{localize "MYTHRASF.Empty.Equipment"}}</li>{{/each}}
  </ol>
</div>
