<div class="narrative-layout">
  <fieldset class="narrative-section narrative-wide"><legend>{{localize "MYTHRASF.Narrative.Identity"}}</legend>
    <label class="narrative-wide"><span>{{localize "MYTHRASF.Narrative.history"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.history"{{/if}}>{{actor.system.narrative.history}}</textarea></label>
    <label class="narrative-wide"><span>{{localize "MYTHRASF.Narrative.description"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.description"{{/if}}>{{actor.system.narrative.description}}</textarea></label>
    <label><span>{{localize "MYTHRASF.Narrative.personality"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.personality"{{/if}}>{{actor.system.narrative.personality}}</textarea></label>
  </fieldset>
  {{> "systems/mythras-foundry/templates/actor/parts/permanent-wounds.hbs"}}
  <fieldset class="narrative-section"><legend>{{localize "MYTHRASF.Narrative.Drive"}}</legend>
    <label><span>{{localize "MYTHRASF.Narrative.motivation"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.motivation"{{/if}}>{{actor.system.narrative.motivation}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.goals"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.goals"{{/if}}>{{actor.system.narrative.goals}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.beliefs"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.beliefs"{{/if}}>{{actor.system.narrative.beliefs}}</textarea></label>
  </fieldset>
  <fieldset class="narrative-section"><legend>{{localize "MYTHRASF.Narrative.Family"}}</legend>
    <label><span>{{localize "MYTHRASF.Narrative.siblings"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.siblings"{{/if}}>{{actor.system.narrative.siblings}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.parents"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.parents"{{/if}}>{{actor.system.narrative.parents}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.partner"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.partner"{{/if}}>{{actor.system.narrative.partner}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.children"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.children"{{/if}}>{{actor.system.narrative.children}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.extendedFamily"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.extendedFamily"{{/if}}>{{actor.system.narrative.extendedFamily}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.familyReputation"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.familyReputation"{{/if}}>{{actor.system.narrative.familyReputation}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.familyConnections"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.familyConnections"{{/if}}>{{actor.system.narrative.familyConnections}}</textarea></label>
  </fieldset>
  <fieldset class="narrative-section"><legend>{{localize "MYTHRASF.Narrative.Relationships"}}</legend>
    <label><span>{{localize "MYTHRASF.Narrative.allies"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.allies"{{/if}}>{{actor.system.narrative.allies}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.contacts"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.contacts"{{/if}}>{{actor.system.narrative.contacts}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.rivals"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.rivals"{{/if}}>{{actor.system.narrative.rivals}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.enemies"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.enemies"{{/if}}>{{actor.system.narrative.enemies}}</textarea></label>
  </fieldset>
{{#unless visibility.restricted}}  <fieldset class="narrative-section narrative-wide"><legend>{{localize "MYTHRASF.Narrative.Private"}}</legend>
    <label><span>{{localize "MYTHRASF.Narrative.secrets"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.secrets"{{/if}}>{{actor.system.narrative.secrets}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.notes"}}</span><textarea {{#if visibility.restricted}}readonly{{else}}name="system.narrative.notes"{{/if}}>{{actor.system.narrative.notes}}</textarea></label>
  </fieldset>{{/unless}}
</div>
