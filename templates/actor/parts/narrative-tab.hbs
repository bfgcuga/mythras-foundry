<div class="narrative-layout">
  <fieldset class="narrative-section narrative-wide"><legend>{{localize "MYTHRASF.Narrative.Identity"}}</legend>
    <label class="narrative-wide"><span>{{localize "MYTHRASF.Narrative.history"}}</span><textarea name="system.narrative.history">{{actor.system.narrative.history}}</textarea></label>
    <label class="narrative-wide"><span>{{localize "MYTHRASF.Narrative.description"}}</span><textarea name="system.narrative.description">{{actor.system.narrative.description}}</textarea></label>
    <label><span>{{localize "MYTHRASF.Narrative.personality"}}</span><textarea name="system.narrative.personality">{{actor.system.narrative.personality}}</textarea></label>
  </fieldset>
  {{> "systems/mythras-foundry/templates/actor/parts/permanent-wounds.hbs"}}
  <fieldset class="narrative-section"><legend>{{localize "MYTHRASF.Narrative.Drive"}}</legend>
    <label><span>{{localize "MYTHRASF.Narrative.motivation"}}</span><textarea name="system.narrative.motivation">{{actor.system.narrative.motivation}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.goals"}}</span><textarea name="system.narrative.goals">{{actor.system.narrative.goals}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.beliefs"}}</span><textarea name="system.narrative.beliefs">{{actor.system.narrative.beliefs}}</textarea></label>
  </fieldset>
  <fieldset class="narrative-section"><legend>{{localize "MYTHRASF.Narrative.Family"}}</legend>
    <label><span>{{localize "MYTHRASF.Narrative.siblings"}}</span><textarea name="system.narrative.siblings">{{actor.system.narrative.siblings}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.parents"}}</span><textarea name="system.narrative.parents">{{actor.system.narrative.parents}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.partner"}}</span><textarea name="system.narrative.partner">{{actor.system.narrative.partner}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.children"}}</span><textarea name="system.narrative.children">{{actor.system.narrative.children}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.extendedFamily"}}</span><textarea name="system.narrative.extendedFamily">{{actor.system.narrative.extendedFamily}}</textarea></label>
  </fieldset>
  <fieldset class="narrative-section"><legend>{{localize "MYTHRASF.Narrative.Relationships"}}</legend>
    <label><span>{{localize "MYTHRASF.Narrative.allies"}}</span><textarea name="system.narrative.allies">{{actor.system.narrative.allies}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.contacts"}}</span><textarea name="system.narrative.contacts">{{actor.system.narrative.contacts}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.rivals"}}</span><textarea name="system.narrative.rivals">{{actor.system.narrative.rivals}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.enemies"}}</span><textarea name="system.narrative.enemies">{{actor.system.narrative.enemies}}</textarea></label>
  </fieldset>
  <fieldset class="narrative-section narrative-wide"><legend>{{localize "MYTHRASF.Narrative.Private"}}</legend>
    <label><span>{{localize "MYTHRASF.Narrative.secrets"}}</span><textarea name="system.narrative.secrets">{{actor.system.narrative.secrets}}</textarea></label><label><span>{{localize "MYTHRASF.Narrative.notes"}}</span><textarea name="system.narrative.notes">{{actor.system.narrative.notes}}</textarea></label>
  </fieldset>
</div>
