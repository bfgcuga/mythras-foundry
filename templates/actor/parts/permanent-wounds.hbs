<fieldset class="permanent-wounds-panel">
  <legend>{{localize "MYTHRASF.PermanentWound.Plural"}}</legend>
  <div class="permanent-wound-head" aria-hidden="true">
    <span>{{localize "MYTHRASF.HitLocation.Location"}}</span>
    <span>{{localize "MYTHRASF.PermanentWound.Severity"}}</span>
    <span>{{localize "MYTHRASF.PermanentWound.HitPoints"}}</span>
    <span>{{localize "MYTHRASF.PermanentWound.LostResults"}}</span>
    <span>{{localize "MYTHRASF.PermanentWound.Description"}}</span>
    {{#if canRemovePermanentWounds}}<span></span>{{/if}}
  </div>
  {{#each permanentWounds as |row|}}
    <div class="permanent-wound-row" data-item-id="{{row.item.id}}">
      <button type="button" data-action="edit-item">{{row.item.name}}</button>
      <output class="sheet-field-readonly">{{row.severity}}</output>
      <output class="sheet-field-readonly penalized-value">{{row.originalMaxHitPoints}}
        <span class="penalized-value-modifier">({{row.effectiveMaxHitPoints}})</span></output>
      <output class="sheet-field-readonly">{{row.lostHitResults}}</output>
      <textarea class="sheet-field-editable" data-item-field="permanentWound.description"
        aria-label="{{localize "MYTHRASF.PermanentWound.Description"}}">{{row.description}}</textarea>
      {{#if @root.canRemovePermanentWounds}}<button type="button" class="sheet-icon-button"
        data-action="remove-permanent-wound" title="{{localize 'MYTHRASF.PermanentWound.Remove'}}"
        aria-label="{{localize 'MYTHRASF.PermanentWound.Remove'}}"><i class="fas fa-trash" aria-hidden="true"></i></button>{{/if}}
    </div>
  {{else}}
    <p class="empty">{{localize "MYTHRASF.PermanentWound.Empty"}}</p>
  {{/each}}
</fieldset>
